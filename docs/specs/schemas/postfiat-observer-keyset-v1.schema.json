{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://postfiat.org/schemas/postfiat-observer-keyset-v1.schema.json",
  "title": "postfiat.observer_keyset.v1",
  "description": "The three observer keys a consumer pins. Installed out of band; never taken from the feed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "keyset_id",
    "chain",
    "threshold",
    "total_observers",
    "algorithm_id",
    "signing_context",
    "observers"
  ],
  "properties": {
    "schema": {
      "const": "postfiat.observer_keyset.v1"
    },
    "keyset_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "chain": {
      "$ref": "#/$defs/chain"
    },
    "threshold": {
      "const": 2
    },
    "total_observers": {
      "const": 3
    },
    "algorithm_id": {
      "const": "ML-DSA-65"
    },
    "signing_context": {
      "const": "postfiat-l1-v2/validator-uptime-feed/v1"
    },
    "observers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "observer_id",
          "region",
          "operator_group",
          "public_key_hex"
        ],
        "properties": {
          "observer_id": {
            "$ref": "#/$defs/observerId"
          },
          "region": {
            "$ref": "#/$defs/region"
          },
          "operator_group": {
            "$ref": "#/$defs/operatorGroup"
          },
          "public_key_hex": {
            "$ref": "#/$defs/mldsa65_public_key_hex"
          }
        }
      }
    }
  },
  "$defs": {
    "sha3_384_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{96}$"
    },
    "mldsa65_public_key_hex": {
      "type": "string",
      "pattern": "^[0-9a-f]{3904}$"
    },
    "observerId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
    },
    "region": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,31}$"
    },
    "operatorGroup": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
    },
    "chain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network",
        "chain_id",
        "genesis_hash"
      ],
      "properties": {
        "network": {
          "enum": [
            "l1-devnet",
            "l1-testnet",
            "l1-mainnet"
          ]
        },
        "chain_id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{2,63}$"
        },
        "genesis_hash": {
          "$ref": "#/$defs/sha3_384_hex"
        }
      }
    }
  }
}
