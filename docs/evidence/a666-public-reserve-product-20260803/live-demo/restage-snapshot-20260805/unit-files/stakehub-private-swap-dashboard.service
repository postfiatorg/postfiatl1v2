[Unit]
Description=StakeHub private swap dashboard
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=60
StartLimitBurst=3

[Service]
Type=simple
WorkingDirectory=/home/postfiat/repos/StakeHub-repeat-demo
EnvironmentFile=/home/postfiat/repos/orc_directives/solid_e2e_stage3_supervised_services_20260710/private-swap.env
ExecStart=/home/postfiat/repos/StakeHub/.venv/bin/python -m stakehub.cli dashboard --port 8787
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/postfiat/.stakehub /home/postfiat/repos/orc_directives /home/postfiat/tmp
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
