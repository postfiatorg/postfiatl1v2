[Unit]
Description=PostFiat L1 RPC validator-5
After=network-online.target postfiat-validator-5.service
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=postfiat
Group=postfiat
EnvironmentFile=/etc/postfiat/releases/open-source-consensus-viewlock-b04c595e/validator-5.rpc.env
ExecStartPre=+/usr/bin/install -d -o postfiat -g postfiat -m 0700 /var/lib/postfiat/validator-5/finality-artifacts
ExecStartPre=/usr/bin/rm -f /var/lib/postfiat/validator-5/readiness/rpc.ready.json
ExecStartPre=/opt/postfiat/releases/open-source-consensus-viewlock-b04c595e/postfiat-node deployment-manifest-verify --manifest-file /etc/postfiat/releases/open-source-consensus-viewlock-b04c595e/deployment-manifest.json --trusted-publisher-key-file /etc/postfiat/releases/open-source-consensus-viewlock-b04c595e/deployment.public.json --validator-id validator-5 --validator-bindings-file /etc/postfiat/releases/open-source-consensus-viewlock-b04c595e/validator-5.bindings.json --runtime-binary-file /opt/postfiat/releases/open-source-consensus-viewlock-b04c595e/postfiat-node --runtime-topology-file /etc/postfiat/releases/open-source-consensus-viewlock-b04c595e/topology.json --runtime-swap-circuit-metadata-file /etc/postfiat/releases/open-source-consensus-viewlock-b04c595e/swap.metadata.json --runtime-private-egress-circuit-metadata-file /etc/postfiat/releases/open-source-consensus-viewlock-b04c595e/private-egress.metadata.json
ExecStart=/opt/postfiat/releases/open-source-consensus-viewlock-b04c595e/postfiat-node rpc-serve --unsafe-devnet-json-storage --data-dir /var/lib/postfiat/validator-5 --spool-dir /var/lib/postfiat/validator-5/runtime/rpc-spool --ready-file /var/lib/postfiat/validator-5/readiness/rpc.ready.json --bind-host 127.0.0.1 --port 27655 --max-requests 10000 --timeout-ms 30000 --child-timeout-ms 30000 --event-log /var/log/postfiat/validator-5/rpc-events.ndjson --allow-mempool-submit-finality --finality-topology /etc/postfiat/releases/open-source-consensus-viewlock-b04c595e/topology.json --finality-key-file /var/lib/postfiat/validator-5/validator_keys.json --finality-proposal-key-file /var/lib/postfiat/validator-5/validator_keys.json --finality-artifact-root /var/lib/postfiat/validator-5/finality-artifacts --finality-timeout-ms 30000 --finality-send-retries 16 --finality-retry-backoff-ms 250 --finality-quorum-early-full-propagation --keep-alive
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictRealtime=true
SystemCallArchitectures=native
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/postfiat/validator-5 /var/log/postfiat/validator-5
UMask=0077
LimitNOFILE=65536
LimitCORE=0
TasksMax=1024
KillMode=control-group
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
StandardOutput=append:/var/log/postfiat/validator-5/rpc-stdout.log
StandardError=append:/var/log/postfiat/validator-5/rpc-stderr.log

[Install]
WantedBy=multi-user.target
