# Never place funded keys in this file. Export values from a secret manager.
PRIVATE_KEY=
A666_GOVERNANCE=
SP1_VERIFIER=
A666_RECEIPT_PROGRAM_VKEY=
PFTL_CHAIN_ID_HASH=
PFTL_GENESIS_HASH_COMMITMENT=
PFTL_PROTOCOL_VERSION=
A666_INITIAL_CHECKPOINT_COMMITMENT=
A666_INITIAL_FINALIZED_HEIGHT=
A666_MAX_PROOF_BYTES=

# 0x-prefixed 48-byte PFTL values.
A666_ROUTE_CONFIG_DIGEST=
A666_SETTLEMENT_ASSET_ID=
A666_NATIVE_NAV_ASSET_ID=
A666_PRICING_RESERVE_PACKET_HASH=

# 0x-prefixed 32-byte Keccak commitment / EVM values. The route ID commitment
# is keccak256 of the exact UTF-8 PFTL route ID.
A666_ROUTE_ID_COMMITMENT=
A666_POLICY_HASH_COMMITMENT=
# May be zero only for the first disposable-fork derivation. Freeze the
# emitted nonzero hash before any production package is approved.
A666_CONTROLLER_RUNTIME_CODE_HASH=
A666_UNISWAP_POOL_ID=
A666_ROUTE_EPOCH=
A666_PRICING_NAV_EPOCH=

# Pool initialization. Verify official addresses and code hashes at the pinned
# fork block before populating these.
A666_WRAPPED_TOKEN=
A666_MAINNET_USDC=0xA0b86991c6218b36c1d19D4a2e9Eb0cE3606eB48
UNISWAP_V4_POOL_MANAGER=
UNISWAP_V4_POOL_MANAGER_CODE_HASH=
UNISWAP_V4_POSITION_MANAGER=
UNISWAP_V4_POSITION_MANAGER_CODE_HASH=
UNISWAP_PERMIT2=
UNISWAP_PERMIT2_CODE_HASH=
A666_POOL_POSITION_OWNER=
A666_POOL_WRAPPED_AMOUNT_MAX=15000000000
A666_POOL_USDC_AMOUNT_MAX=15000000000
