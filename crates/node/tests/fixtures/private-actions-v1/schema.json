{
  "schema": "postfiat-private-actions-v1",
  "status": "Contract for W-1 segment S1. The routes are not implemented yet; the shapes are pinned by crates/types/src/private_actions_v1.rs and crates/node/tests/private_actions_contract.rs.",
  "transport": "POST JSON with the W-2 native session bearer (Authorization header). No query parameters. No redirects.",
  "limits": {
    "max_action_json_bytes": 1048576,
    "max_request_bytes": 2097152,
    "max_response_bytes": 4194304
  },
  "admission_states": {
    "queued": "Reserved durably (domain, intent id, action bytes and hash, batch id); not yet sent to a validator.",
    "dispatched": "Sent to the validator admission service; outcome not known.",
    "accepted": "Included in a finalized block with an accepted receipt.",
    "rejected": "Included or refused with a final rejection; code and fee effects in the receipt.",
    "unknown": "No outcome is known. Stays pending and never authorizes a replacement action.",
    "abandoned": "Abandoned by the operator; the same action bytes may be resubmitted under the same intent. Terminal until the wallet resubmits; the gateway never resends on its own."
  },
  "refusals": {
    "private_intent_mismatch": "intent_id is not the recomputed id of (domain, action_json).",
    "private_intent_conflict": "different action bytes under an intent id that is already reserved.",
    "private_action_duplicate": "the canonical action hash or batch id is already reserved under another intent.",
    "private_action_malformed": "action_json does not decode as postfiat_types::ShieldedAction.",
    "private_action_kind_refused": "a kind other than asset_orchard_ingress_v2, shielded_swap_v1, asset_orchard_private_egress_v1.",
    "private_action_legacy_refused": "asset_orchard_ingress_v1 or asset_orchard_egress_v1 (they carry openings or spend material).",
    "private_action_unknown_fields": "a field the typed action does not define.",
    "private_swap_json_malformed": "swap_json is not a JSON object.",
    "private_swap_json_fields_refused": "swap_json fields differ from the exact public field set."
  },
  "routes": {
    "snapshot": {
      "path": "/api/private/v1/snapshot",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^pf[0-9a-f]{40}$"
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "domain",
          "address",
          "snapshot_token",
          "commitments",
          "nullifiers",
          "accepted_anchors",
          "outputs",
          "assets",
          "base_asset_id",
          "quote_asset_id",
          "pricing_claim_json",
          "policy_id",
          "disclosure_hash",
          "complete",
          "cursors"
        ],
        "properties": {
          "schema": {
            "const": "postfiat-private-actions-v1"
          },
          "domain": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "chain_id",
              "genesis_hash",
              "protocol_version"
            ],
            "properties": {
              "chain_id": {
                "type": "string"
              },
              "genesis_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{96}$"
              },
              "protocol_version": {
                "type": "integer",
                "minimum": 1
              }
            }
          },
          "address": {
            "type": "string",
            "pattern": "^pf[0-9a-f]{40}$"
          },
          "snapshot_token": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "height",
              "block_hash",
              "state_root"
            ],
            "properties": {
              "height": {
                "type": "integer",
                "minimum": 1
              },
              "block_hash": {
                "type": "string",
                "pattern": "^[0-9a-f]{96}$"
              },
              "state_root": {
                "type": "string",
                "pattern": "^[0-9a-f]{96}$"
              }
            }
          },
          "commitments": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "nullifiers": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "accepted_anchors": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "outputs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "commitment",
                "ciphertext"
              ],
              "properties": {
                "commitment": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "ciphertext": {
                  "type": "string",
                  "pattern": "^([0-9a-f]{2})*$"
                }
              }
            }
          },
          "assets": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "asset_id",
                "issuer",
                "code",
                "precision",
                "requires_authorization",
                "proof_profile_id"
              ],
              "properties": {
                "asset_id": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{96}$"
                },
                "issuer": {
                  "type": "string",
                  "pattern": "^pf[0-9a-f]{40}$"
                },
                "code": {
                  "type": "string"
                },
                "precision": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 255
                },
                "requires_authorization": {
                  "type": "boolean"
                },
                "proof_profile_id": {
                  "anyOf": [
                    {
                      "type": "string",
                      "pattern": "^[0-9a-f]{96}$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              }
            }
          },
          "base_asset_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          },
          "quote_asset_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          },
          "pricing_claim_json": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "policy_id": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "disclosure_hash": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "complete": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commitments",
              "nullifiers",
              "accepted_anchors",
              "outputs",
              "assets"
            ],
            "properties": {
              "commitments": {
                "type": "boolean"
              },
              "nullifiers": {
                "type": "boolean"
              },
              "accepted_anchors": {
                "type": "boolean"
              },
              "outputs": {
                "type": "boolean"
              },
              "assets": {
                "type": "boolean"
              }
            }
          },
          "cursors": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "commitments",
              "nullifiers",
              "accepted_anchors",
              "outputs"
            ],
            "properties": {
              "commitments": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "nullifiers": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "accepted_anchors": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "outputs": {
                "anyOf": [
                  {
                    "type": "string"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            }
          }
        }
      },
      "paging": "Every page carries the same snapshot_token. A page with a different token, a missing, duplicated or reordered item, or a cursor after complete=true is refused by the client."
    },
    "submit": {
      "path": "/api/private/v1/submit",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "intent_id",
          "action_json"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^pf[0-9a-f]{40}$"
          },
          "intent_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          },
          "action_json": {
            "type": "string",
            "maxLength": 1048576
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "intent_id",
          "state",
          "batch_id",
          "action_hash"
        ],
        "properties": {
          "schema": {
            "const": "postfiat-private-actions-v1"
          },
          "intent_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          },
          "state": {
            "enum": [
              "queued",
              "dispatched",
              "accepted",
              "rejected",
              "unknown",
              "abandoned"
            ]
          },
          "batch_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          },
          "action_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          }
        }
      },
      "semantics": "An acknowledgement means admitted and pending. Repeating the identical request returns the same reservation; it never starts a second round."
    },
    "receipt": {
      "path": "/api/private/v1/receipt",
      "request": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "address",
          "intent_id",
          "action_json"
        ],
        "properties": {
          "address": {
            "type": "string",
            "pattern": "^pf[0-9a-f]{40}$"
          },
          "intent_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          },
          "action_json": {
            "type": "string",
            "maxLength": 1048576
          }
        }
      },
      "response": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "schema",
          "intent_id",
          "state",
          "action_hash",
          "batch_id",
          "transaction_id",
          "inclusion_height",
          "block_hash",
          "state_root",
          "accepted",
          "code",
          "fee",
          "finality"
        ],
        "properties": {
          "schema": {
            "const": "postfiat-private-actions-v1"
          },
          "intent_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          },
          "state": {
            "enum": [
              "queued",
              "dispatched",
              "accepted",
              "rejected",
              "unknown",
              "abandoned"
            ]
          },
          "action_hash": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          },
          "batch_id": {
            "type": "string",
            "pattern": "^[0-9a-f]{96}$"
          },
          "transaction_id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{96}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "inclusion_height": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "block_hash": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{96}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "state_root": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[0-9a-f]{96}$"
              },
              {
                "type": "null"
              }
            ]
          },
          "accepted": {
            "anyOf": [
              {
                "type": "boolean"
              },
              {
                "type": "null"
              }
            ]
          },
          "code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "fee": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ]
          },
          "finality": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "kind",
                  "height",
                  "block_hash",
                  "state_root",
                  "quorum",
                  "validator_count",
                  "certificate_json"
                ],
                "properties": {
                  "kind": {
                    "const": "validator_quorum_block_certificate_v1"
                  },
                  "height": {
                    "type": "integer"
                  },
                  "block_hash": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{96}$"
                  },
                  "state_root": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{96}$"
                  },
                  "quorum": {
                    "type": "integer"
                  },
                  "validator_count": {
                    "type": "integer"
                  },
                  "certificate_json": {
                    "type": "string"
                  }
                }
              },
              {
                "type": "null"
              }
            ]
          },
          "abandon_reason": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "Only for abandoned: the operator's reason and Unix time; omitted for every other state."
          }
        }
      },
      "semantics": "Read-only. Bindings never change once set. Outcome fields are null while the state is queued, dispatched or unknown. An abandoned receipt carries abandon_reason; the wallet may resubmit the same bytes under the same intent."
    }
  },
