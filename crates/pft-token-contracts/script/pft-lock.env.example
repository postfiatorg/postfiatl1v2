# PFTLockV1 deployment values for script/DeployPFTLock.s.sol (Base, chain id
# 8453; test deployments on Base Sepolia, chain id 84532). Placeholders only:
# the script refuses any value that is empty, blank or contains "replace" in
# any casing. Keep the filled copy outside the repository (*.env is ignored).
#
# The PFTL finality verifier is deployed on Base first, then the lock contract
# (design note docs/specs/pft-erc20-base-bridge-phase2-design-20261026.md,
# sections 5 and 6). The RPC URL and the one-time deployer key are passed to
# `forge script` on the command line and are never stored in this file.

# 8453 (Base) or 84532 (Base Sepolia); must equal the RPC's chain id.
PFT_LOCK_CHAIN_ID=replace_with_8453_or_84532
# The PFTToken and the keccak256 of its runtime code (cast keccak $(cast code <token>)).
# On 84532 required (unless PFT_LOCK_ALLOW_TEST_TOKEN=1): the recorded test token
# 0x18fE4ca51A0cE042688D5A54917319d03B527D92 with
# 0xb0939a2407cd571d158498ba0f405f4ddb3857e688d2bc5ada170dcc655903df.
PFT_LOCK_TOKEN=0xreplace_with_the_pft_token_address
PFT_LOCK_TOKEN_CODEHASH=0xreplace_with_the_token_runtime_codehash
# The PFTL finality verifier on the same chain and the keccak256 of its runtime code.
PFT_LOCK_VERIFIER=0xreplace_with_the_finality_verifier_address
PFT_LOCK_VERIFIER_CODEHASH=0xreplace_with_the_verifier_runtime_codehash
# The current finalized PFTL checkpoint at the time of the deployment preflight
# (commitment, height, committee root commitment), from your own node, never by
# reading the verifier. On a mismatch re-pin all three together and rerun. If
# the rerun fails identically, the verifier's stored anchor is behind the chain
# (it advances only when a checkpoint proof is relayed): advance it with a
# checkpoint proof or deploy a new verifier; do not deploy the lock and never
# pin the verifier's own values.
PFT_LOCK_VERIFIER_EXPECTED_CHECKPOINT_COMMITMENT=0xreplace_with_the_finalized_checkpoint_commitment
PFT_LOCK_VERIFIER_EXPECTED_FINALIZED_HEIGHT=replace_with_the_finalized_height
PFT_LOCK_VERIFIER_EXPECTED_COMMITTEE_ROOT_COMMITMENT=0xreplace_with_the_committee_root_commitment
# The verifier's immutable PFTL-side configuration, from the chain and the
# genesis plan: keccak256 of the PFTL chain id string, keccak256 of the 48-byte
# genesis hash, and the route profile hash, route epoch and asset id commitment.
PFT_LOCK_VERIFIER_EXPECTED_PFTL_CHAIN_ID_HASH=0xreplace_with_the_pftl_chain_id_hash
PFT_LOCK_VERIFIER_EXPECTED_GENESIS_HASH_COMMITMENT=0xreplace_with_the_genesis_hash_commitment
PFT_LOCK_VERIFIER_EXPECTED_ROUTE_PROFILE_HASH_COMMITMENT=0xreplace_with_the_route_profile_hash_commitment
PFT_LOCK_VERIFIER_EXPECTED_ROUTE_EPOCH=replace_with_the_route_epoch
PFT_LOCK_VERIFIER_EXPECTED_ASSET_ID_COMMITMENT=0xreplace_with_the_asset_id_commitment
# The genesis per-window release cap twice: in six-decimal units (uint64) and in
# whole PFT (units = PFT * 1000000), as the genesis plan fixes it.
PFT_LOCK_MAX_LOCK_AMOUNT=replace_with_the_cap_in_six_decimal_units
PFT_LOCK_MAX_LOCK_AMOUNT_PFT=replace_with_the_cap_in_whole_pft
# The smallest Lock, in six-decimal units: the PFTL account reserve
# (ACCOUNT_RESERVE, crates/execution/src/entrypoints.rs). A smaller Lock to a
# new PFTL account could never be released there. This is the protocol value,
# not an operator choice: the script checks it against the protocol constant
# PFTL_ACCOUNT_RESERVE_UNITS and refuses any other value, test switches or not
# (MinimumLockAmountNotTheAccountReserve); a Rust test keeps the script
# constant, the contract's PFTL_ACCOUNT_RESERVE and this value equal to
# ACCOUNT_RESERVE (crates/execution/src/lock_minimum_binding_tests.rs).
PFT_LOCK_MINIMUM_LOCK_AMOUNT=10

# Required for the real deployment (writes deployments/...; never with a test switch).
# PFT_LOCK_REAL_DEPLOYMENT=1
# PFT_LOCK_SOURCE_COMMIT=replace_with_the_deployed_git_commit (required: exactly 40 hex characters)

# Test-only switches for a local anvil or test-network run on chain id 84532.
# Never set them for a real deployment; on 8453 the script refuses them.
# PFT_LOCK_ALLOW_TEST_VERIFIER=1 admits a verifier whose code hash is not
# PFT_LOCK_VERIFIER_CODEHASH (which may then stay unset, as may the expected
# anchor; the anchor check is skipped only for a stand-in without anchor
# getters): no PFTL finality verifier exists on Base yet.
# PFT_LOCK_ALLOW_TEST_VERIFIER=1
# PFT_LOCK_ALLOW_USED_DEPLOYER=1
# PFT_LOCK_ALLOW_TEST_TOKEN=1 admits a token other than the recorded test token.
# PFT_LOCK_ALLOW_TEST_TOKEN=1
