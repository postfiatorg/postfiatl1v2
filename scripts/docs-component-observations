#!/usr/bin/env python3
"""Generate the independently dated fleet, authority and proof-identity statements."""
import argparse
import json
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
PAGES = ("docs/index.md", "docs/status/network-status.md", "docs/runbooks/public-operator-runbook.md")
START = "<!-- component-observations -->"
END = "<!-- /component-observations -->"


def render(records):
    rows = ["| Component and evidence | Chain / height | Last observed | Result |",
            "| --- | --- | --- | --- |"]
    for key in ("fleet", "authority", "identity"):
        item = records[key]
        if key == "identity":
            status = "Verified" if item["conclusion"] == "success" else "Unverified"
            result = f"{status} (hosted comparison: {item['conclusion']})"
        else:
            result = item["result"]
        height = item["height"] if item["height"] is not None else "n/a"
        rows.append(f"| [{item['component']}]({item['evidence']}) | {item['chain']} / {height} | "
                    f"{item['observed_at']} | {result} |")
    return "\n\n" + "\n".join(rows) + "\n\n"


def main():
    args = argparse.ArgumentParser()
    args.add_argument("--check", action="store_true")
    check = args.parse_args().check
    records = json.loads((ROOT / "docs/status/component-observations.json").read_text())
    for name in PAGES:
        path = ROOT / name
        s = path.read_text()
        if s.count(START) != 1 or s.count(END) != 1:
            raise SystemExit(f"Missing or duplicate observation markers in {name}")
        a, b = s.index(START) + len(START), s.index(END)
        updated = s[:a] + render(records) + s[b:]
        if check and updated != s:
            raise SystemExit(f"Stale observations in {name}")
        if updated != s:
            path.write_text(updated)


if __name__ == "__main__":
    main()
