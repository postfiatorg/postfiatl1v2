#!/usr/bin/env python3
"""Regress evidence independence and the privacy example published alongside it."""
import copy
import json
import runpy
from pathlib import Path

root = Path(__file__).resolve().parents[1]
render = runpy.run_path(str(root / "scripts/docs-component-observations"))["render"]
original = json.loads((root / "docs/status/component-observations.json").read_text())
changed = copy.deepcopy(original)
changed["fleet"].update(height=2_000_000, observed_at="future")
authority = lambda records: next(row for row in render(records).splitlines() if "Validator-trust authority" in row)
assert authority(changed) == authority(original)
for outcome in ("failure", "skipped", "cancelled", "success"):
    changed["identity"].update(conclusion=outcome, comparison=outcome, job=outcome)
    expected = "Verified" if outcome == "success" else "Unverified"
    assert f"{expected} (workflow {outcome}, comparison {outcome})" in render(changed)
examples = json.loads((root / "docs/fixtures/privacy/candidate-weights.json").read_text())["examples"]
assert [row["best_guess"] for row in examples] == [625, 4000]
for row in examples:
    assert len(row["weights"]) == 16 and sum(row["weights"]) == 10000
    assert max(row["weights"]) == row["best_guess"]

observe = runpy.run_path(str(root / "scripts/docs-component-observations"))["identity_observation"]
run = dict(name="pft-lane-export-identity", head_repository={"full_name": "postfiatorg/postfiatl1v2"},
           head_branch="main", event="push", status="completed", conclusion="success", run_number=1000000,
           head_sha="a" * 40, updated_at="2099-01-01T00:00:00Z", html_url="https://example.invalid/run")
job = {"name": "build-lane-export-identity", "conclusion": "success", "steps": [{"name": "Compare with the committed identity",
                                                        "conclusion": "skipped"}]}
changed["identity"] = observe(run, [job], original["identity"])
assert "Unverified (workflow success, comparison skipped)" in render(changed)
job["steps"][0]["conclusion"] = "success"
assert observe(run, [job], original["identity"])["conclusion"] == "success"
assert observe(run, [], original["identity"])["comparison"] == "missing"
try:
    observe(dict(run, event="pull_request"), [job], original["identity"])
except ValueError:
    pass
else:
    raise AssertionError("PR run accepted as the identity of main")
