#!/usr/bin/env python3
"""Exercise every A666 recovery CI policy rejection class in miniature trees."""

from __future__ import annotations

import subprocess
import sys
import tempfile
from pathlib import Path

CHECKER = Path(__file__).resolve().with_name("check-a666-recovery-ci-policy")


def write_fixture(root: Path, relative: str, content: str) -> None:
    path = root / relative
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text(content, encoding="utf-8")


def invoke(root: Path) -> subprocess.CompletedProcess[str]:
    return subprocess.run(
        [sys.executable, str(CHECKER), "--root", str(root)],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        check=False,
    )


def clean_fixture(root: Path) -> None:
    write_fixture(
        root,
        "scripts/clean.py",
        "state = derive_result()\nreport = {'schema': 'v1', 'ok': state}\nif accepted:\n    warm_cache()\nwrite_report(report)\n",
    )
    write_fixture(root, "crates/demo/src/lib.rs", "pub fn verify() {}\n")
    write_fixture(
        root,
        "wallet-proxy/rpc.js",
        "const rpc = { schema: 'rpc-v1', ok: true };\nreturn rpc;\n",
    )
    write_fixture(
        root,
        "wallet-web/src/lib/status.e2e.js",
        "const acceptance = { schema: 'v1', accepted: true };\nwriteFile('ACCEPTANCE', acceptance);\n",
    )
    retired = "Stake" + "Hub"
    write_fixture(root, "scripts/check-absence.py", f"term = '{retired}'\n")


def require_clean() -> None:
    with tempfile.TemporaryDirectory(prefix="a666-ci-policy-clean-") as directory:
        root = Path(directory)
        clean_fixture(root)
        result = invoke(root)
        assert result.returncode == 0, result.stdout
        assert "a666_recovery_ci_policy=ok" in result.stdout, result.stdout


def require_failure(relative: str, content: str, rule: str, line: int) -> None:
    with tempfile.TemporaryDirectory(prefix="a666-ci-policy-fail-") as directory:
        root = Path(directory)
        clean_fixture(root)
        write_fixture(root, relative, content)
        result = invoke(root)
        expected = f"{relative}:{line}: {rule}"
        assert result.returncode != 0, result.stdout
        assert expected in result.stdout, result.stdout


def require_clean_with(relative: str, content: str) -> None:
    with tempfile.TemporaryDirectory(prefix="a666-ci-policy-clean-vector-") as directory:
        root = Path(directory)
        clean_fixture(root)
        write_fixture(root, relative, content)
        result = invoke(root)
        assert result.returncode == 0, result.stdout
        assert "a666_recovery_ci_policy=ok" in result.stdout, result.stdout


def require_exact_direct_proving_allowlist() -> None:
    repo_root = CHECKER.parent.parent
    vectors = {
        "scripts/test_native_campaign_driver.py": (445, 636),
        "scripts/test_native_prover_leaf.py": (180,),
    }
    for relative, allowed_lines in vectors.items():
        source_lines = (repo_root / relative).read_text(encoding="utf-8").splitlines()
        fixture_lines = [""] * max(allowed_lines)
        for line in allowed_lines:
            fixture_lines[line - 1] = source_lines[line - 1]
        with tempfile.TemporaryDirectory(prefix="a666-ci-policy-allowlist-") as directory:
            root = Path(directory)
            clean_fixture(root)
            write_fixture(root, relative, "\n".join(fixture_lines) + "\n")
            result = invoke(root)
            assert result.returncode == 0, result.stdout

            drift_line = allowed_lines[-1]
            fixture_lines[drift_line - 1] += " "
            write_fixture(root, relative, "\n".join(fixture_lines) + "\n")
            result = invoke(root)
            assert result.returncode != 0, result.stdout
            expected = f"{relative}:{drift_line}: stale-direct-proving-allowlist"
            assert expected in result.stdout, result.stdout


def main() -> int:
    require_clean()
    require_exact_direct_proving_allowlist()

    api = "pro" + "ve"
    require_failure(
        "crates/demo/src/tests/direct.rs",
        f"fn direct(client: Client) {{ client.{api}(); }}\n",
        "direct-proving-in-test",
        1,
    )

    status = "accept" + "ed"
    writer = "write_" + "report"
    require_failure(
        "scripts/branch.py",
        f"if {status}:\n    {writer}(report)\n",
        "success-only-report-evidence-write",
        2,
    )

    key_word = "o" + "k"
    require_failure(
        "scripts/branch-result.py",
        f"if result[\"{key_word}\"]:\n    output.write_text(report)\n",
        "success-only-report-evidence-write",
        2,
    )
    require_failure(
        "scripts/branch-status.py",
        f"if status == \"{key_word}\":\n    write_report(report)\n",
        "success-only-report-evidence-write",
        2,
    )

    require_clean_with(
        "scripts/monitor.py",
        "report = {\"schema\": \"v1\"}\n"
        "if args.alert_spool_dir is not None and checks[\"status\"] != \"ok\":\n"
        "    write_alert_event(report, args.alert_spool_dir)\n",
    )
    require_clean_with(
        "scripts/doctor.py",
        f"if not build[\"{key_word}\"]:\n    args.output.write_text(json.dumps(report))\n",
    )

    retired = "Stake" + "Hub"
    require_failure(
        "wallet-proxy/runtime.py",
        f"retired_identifier = '{retired}'\n",
        "retired-identifier-runtime",
        1,
    )

    key = "o" + "k"
    literal = "Tr" + "ue"
    require_failure(
        "scripts/emitter.py",
        f"report = {{'schema': 'v1', {key!r}: {literal}}}\nwrite_report(report)\n",
        "literal-result-boolean-schema-emitter",
        1,
    )

    print(
        "a666_recovery_ci_policy_selftest=ok clean=1 allowlist_vectors=2 "
        "allowlist_drift_rejected=2 failure_path_clean=2 rejected=6"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
