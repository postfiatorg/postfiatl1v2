#!/usr/bin/env python3
"""Check a downloaded PostFiat release without running anything from it.

  scripts/verify-release --manifest-file release-manifest.json \
      --keyset-file release-keyset.json --binary-file postfiat-node-linux-x86_64

A first install has no trusted `postfiat-node` yet, and a binary must not be
the one to say that it is genuine. This script is the check for that moment:
it needs Python 3.10+ and `dilithium-py` (`pip install dilithium-py`), and it
reads the three files only. It checks that

  - the manifest is a `postfiat.release_manifest.v3` inside its validity window;
  - at least `threshold` signers of the keyset signed these exact manifest
    bytes (ML-DSA-65, context `postfiat-l1-v2/release-manifest/v3`), each once,
    each with the key the keyset pins for it;
  - the binary is the one the manifest names for the architecture: same size,
    same SHA-256, and an ELF file for that machine.

The keyset is the root of trust. Get it from somewhere other than the place
the release was downloaded from, and compare its SHA-256 (printed below) with
the published one.

After the first install, `postfiat-node upgrade` does this check itself with
the installed, already trusted binary.

Exit 0: verified. Exit 1: not verified; the reason is on stderr.
"""

from __future__ import annotations

import argparse
import hashlib
import json
from pathlib import Path
import platform
import sys
import time
from typing import Any

MANIFEST_SCHEMA = "postfiat.release_manifest.v3"
KEYSET_SCHEMA = "postfiat.release_keyset.v1"
SIGNING_CONTEXT = b"postfiat-l1-v2/release-manifest/v3"
ALGORITHM = "ML-DSA-65"
ELF_MACHINE = {"linux-x86_64": 62, "linux-aarch64": 183}
HOST_ARCH = {"x86_64": "linux-x86_64", "amd64": "linux-x86_64", "aarch64": "linux-aarch64", "arm64": "linux-aarch64"}


class NotVerified(Exception):
    pass


def canonical_json_bytes(value: Any) -> bytes:
    """The bytes the signers sign: keys sorted, no spaces, UTF-8 as is."""
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode("utf-8")


def load_json(path: Path, what: str) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, ValueError) as exc:
        raise NotVerified(f"{what} `{path}` cannot be read: {exc}") from exc
    if not isinstance(value, dict):
        raise NotVerified(f"{what} `{path}` is not a JSON object")
    return value


def check_keyset(keyset: dict[str, Any]) -> dict[str, dict[str, Any]]:
    if keyset.get("schema") != KEYSET_SCHEMA:
        raise NotVerified(f"keyset schema is `{keyset.get('schema')}`, expected `{KEYSET_SCHEMA}`")
    if keyset.get("algorithm_id") != ALGORITHM or keyset.get("signing_context") != SIGNING_CONTEXT.decode():
        raise NotVerified("keyset is not for ML-DSA-65 release manifests")
    signers = keyset.get("signers")
    if not isinstance(signers, list) or len(signers) != keyset.get("total_signers"):
        raise NotVerified("keyset signer count differs from total_signers")
    threshold = keyset.get("threshold")
    if not isinstance(threshold, int) or threshold < 2 or threshold > len(signers):
        raise NotVerified("keyset threshold must be at least 2 and at most the number of signers")
    by_id = {s.get("signer_id"): s for s in signers if isinstance(s, dict)}
    keys = {s.get("public_key_hex") for s in by_id.values()}
    if len(by_id) != len(signers) or len(keys) != len(signers) or None in by_id or None in keys:
        raise NotVerified("keyset signers must have distinct ids and distinct keys")
    return by_id


def check_signatures(manifest: dict[str, Any], keyset: dict[str, Any], verify: Any) -> list[str]:
    pinned = check_keyset(keyset)
    signatures = manifest.get("signatures")
    if not isinstance(signatures, list):
        raise NotVerified("manifest has no signatures")
    message = canonical_json_bytes({**manifest, "signatures": []})
    verified: set[str] = set()
    for entry in signatures:
        signer_id = entry.get("signer_id") if isinstance(entry, dict) else None
        signer = pinned.get(signer_id)
        if signer is None:
            raise NotVerified(f"signature by `{signer_id}`, who is not in the keyset")
        if signer_id in verified:
            raise NotVerified(f"`{signer_id}` signed twice")
        if entry.get("algorithm_id") != ALGORITHM or entry.get("public_key_hex") != signer["public_key_hex"]:
            raise NotVerified(f"signature by `{signer_id}` is not under the key the keyset pins for it")
        try:
            ok = verify(bytes.fromhex(signer["public_key_hex"]), message, bytes.fromhex(entry.get("signature_hex", "")))
        except ValueError:
            ok = False
        if not ok:
            raise NotVerified(f"signature by `{signer_id}` does not verify")
        verified.add(signer_id)
    if len(verified) < keyset["threshold"]:
        raise NotVerified(f"{len(verified)} valid signature(s), the keyset needs {keyset['threshold']}")
    return sorted(verified)


def check_manifest(manifest: dict[str, Any], now_unix: int) -> None:
    if manifest.get("schema") != MANIFEST_SCHEMA:
        raise NotVerified(f"manifest schema is `{manifest.get('schema')}`, expected `{MANIFEST_SCHEMA}`")
    start, end = manifest.get("valid_from_unix"), manifest.get("valid_until_unix")
    if not isinstance(start, int) or not isinstance(end, int) or not start <= now_unix <= end:
        raise NotVerified(f"manifest validity window [{start}, {end}] does not cover {now_unix}")


def check_binary(manifest: dict[str, Any], binary: Path, arch: str) -> str:
    artifact = (manifest.get("artifacts") or {}).get(arch)
    if not isinstance(artifact, dict):
        raise NotVerified(f"manifest names no binary for `{arch}`")
    digest, size = hashlib.sha256(), 0
    try:
        with binary.open("rb") as handle:
            head = handle.read(20)
            digest.update(head)
            size += len(head)
            while chunk := handle.read(1 << 20):
                digest.update(chunk)
                size += len(chunk)
    except OSError as exc:
        raise NotVerified(f"binary `{binary}` cannot be read: {exc}") from exc
    if size != artifact.get("binary_size_bytes") or digest.hexdigest() != artifact.get("binary_sha256"):
        raise NotVerified(f"`{binary}` is not the `{arch}` binary of this manifest (size or SHA-256 differs)")
    if head[:4] != b"\x7fELF" or int.from_bytes(head[18:20], "little") != ELF_MACHINE[arch]:
        raise NotVerified(f"`{binary}` is not an ELF executable for `{arch}`")
    return digest.hexdigest()


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("--manifest-file", required=True)
    parser.add_argument("--keyset-file", required=True)
    parser.add_argument("--binary-file", required=True)
    parser.add_argument("--arch", choices=sorted(ELF_MACHINE), help="default: this machine's")
    parser.add_argument("--now-unix", type=int, help=argparse.SUPPRESS)  # tests
    args = parser.parse_args(argv)
    try:
        arch = args.arch or HOST_ARCH.get(platform.machine().lower())
        if arch is None:
            raise NotVerified(f"unsupported machine `{platform.machine()}`; pass --arch")
        try:
            from dilithium_py.ml_dsa import ML_DSA_65
        except ImportError as exc:
            raise NotVerified("dilithium-py is not installed: pip install dilithium-py") from exc
        manifest = load_json(Path(args.manifest_file), "manifest")
        keyset = load_json(Path(args.keyset_file), "keyset")
        check_manifest(manifest, args.now_unix if args.now_unix is not None else int(time.time()))
        signers = check_signatures(
            manifest, keyset, lambda key, message, signature: ML_DSA_65.verify(key, message, signature, ctx=SIGNING_CONTEXT)
        )
        binary_sha256 = check_binary(manifest, Path(args.binary_file), arch)
    except NotVerified as exc:
        print(f"verify-release: NOT VERIFIED: {exc}", file=sys.stderr)
        return 1
    print(json.dumps({
        "verified": True,
        "release_id": manifest.get("release_id"),
        "release_sequence": manifest.get("release_sequence"),
        "chain_id": manifest.get("chain_id"),
        "git_revision": manifest.get("git_revision"),
        "architecture": arch,
        "binary_sha256": binary_sha256,
        "verified_signers": signers,
        "threshold": keyset["threshold"],
        "keyset_id": keyset.get("keyset_id"),
        "keyset_sha256": hashlib.sha256(Path(args.keyset_file).read_bytes()).hexdigest(),
    }, indent=2))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
