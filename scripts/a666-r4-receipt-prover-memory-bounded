        "/home/postfiat/.foundry/bin/anvil --host 127.0.0.1 --port 8547 --chain-id 1",
        "scripts/a666-r4-ethereum-contract-stage",
    ],
    "automatic_restart": False,
    "host_decision_inputs": {
        "ram_gb": 122,
        "cores": 32,
        "gpu": "none",
        "swap_at_decision_observation": "15/15GB exhausted",
        "prior_peak_gb": 103.1,
        "disk_free_gb_minimum": 100,
        "disk_free_gb_observed": 185,
        "expected_duration": "multi-hour/overnight",
        "output": "proof checkpoint and shards on disk under unique mode-700 /tmp output dir",
        "no_memory_max": True,
        "success_claimed": False,
    },
    "authorization_status": "pending_nazgul_sequencing",
    "correction": "pause contract now captures the full live PID set (fleet, proxy, dependencies, pftl, anvil) into pause-pid-manifest.json before any mutation and refuses to prove unless every captured PID is dead (120s bounded wait, exit 7 naming survivors) and every paused port (31001-31012, 31021, 8798, 8799, 8547) refuses loopback connections; the dependency teardown control is resolved dynamically and only the evidence-verified Anvil PID is stopped",
    "prepared": True,
    "fired": False,
    "fire_authorized": False,
    "stakehub_interaction": False,
