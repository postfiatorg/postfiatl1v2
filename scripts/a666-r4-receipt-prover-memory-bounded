        "assert ports 31001-31012, 31021, 8798, 8799, 8547 absent before proving; any port still answering: refuse exit 4",
    ],
    "pause_absence_contract": {
        "pid_manifest": "\$OUT_DIR/pause-pid-manifest.json (schema postfiat.a666.r4.receipt-prover-pause-pid-manifest.v1, captured before any mutation)",
        "pid_absence": "every captured PID must fail kill -0 within 120 seconds after the stop sequence or fire refuses with exit 7 naming survivors; proving never starts while any captured process lives",
