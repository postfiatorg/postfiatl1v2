#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
manifest_dir="$repo_root/tools/nav-reserve-proof/manifests/a666"
tmp_dir="$(mktemp -d)"
trap 'rm -rf "$tmp_dir"' EXIT

for source in near solana; do
  cargo +1.95.0 run --quiet \
    --manifest-path "$repo_root/tools/nav-reserve-proof/Cargo.toml" \
    -p postfiat-reserve-proof -- \
    manifest evm-chainlink-policy-commitment \
    --policy "$manifest_dir/$source-chainlink-valuation-policy.json" \
    --output "$tmp_dir/$source.json" >/dev/null
  cmp "$manifest_dir/$source-chainlink-valuation-policy-commitment.json" \
    "$tmp_dir/$source.json"
done

for spec in \
  "hyperliquid_receipt hyperliquid-policy hyperliquid-policy-commitment" \
  "near_receipt near-receipt-policy near-receipt-policy-commitment" \
  "solana_stake_reader solana-stake-reader-policy solana-stake-reader-policy-commitment"
do
  set -- $spec
  cargo +1.95.0 run --quiet \
    --manifest-path "$repo_root/tools/nav-reserve-proof/Cargo.toml" \
    -p postfiat-reserve-proof -- \
    manifest quantity-policy-commitment \
    --kind "$1" \
    --policy "$manifest_dir/$2.json" \
    --committee "$manifest_dir/checkpoint-committee.json" \
    --output "$tmp_dir/$3.json" >/dev/null
  cmp "$manifest_dir/$3.json" "$tmp_dir/$3.json"
done

echo "A666 Hyperliquid, NEAR, and Solana quantity and valuation policy commitments verified"
