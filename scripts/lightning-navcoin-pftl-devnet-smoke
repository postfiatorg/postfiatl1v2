#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
RUN_ROOT="${RUN_ROOT:-$REPO_ROOT/reports/lightning-navcoin-pftl-$(date -u +%Y%m%dT%H%M%SZ)}"

if [[ -z "${POSTFIAT_NODE_BIN:-}" || -z "${POSTFIAT_NODE_GIT_REV:-}" ]]; then
  echo "POSTFIAT_NODE_BIN and POSTFIAT_NODE_GIT_REV are required" >&2
  exit 2
fi

"$REPO_ROOT/scripts/lightning-navcoin-pftl-devnet" probe \
  --output "$RUN_ROOT-binary-gate.json"
"$REPO_ROOT/scripts/lightning-navcoin-pftl-devnet" init --root "$RUN_ROOT"
"$REPO_ROOT/scripts/lightning-navcoin-pftl-devnet" up --root "$RUN_ROOT"
cleanup() {
  "$REPO_ROOT/scripts/lightning-navcoin-pftl-devnet" down --root "$RUN_ROOT" \
    >/dev/null 2>&1 || true
}
trap cleanup EXIT
"$REPO_ROOT/scripts/lightning-navcoin-pftl-devnet" status --root "$RUN_ROOT" \
  >"$RUN_ROOT/evidence/status-before-outage.json"
"$REPO_ROOT/scripts/lightning-navcoin-pftl-devnet" one-validator-down \
  --root "$RUN_ROOT" \
  --effect-key "smoke-one-validator-down" \
  >"$RUN_ROOT/evidence/one-validator-down.json"
"$REPO_ROOT/scripts/lightning-navcoin-pftl-devnet" restart-proof \
  --root "$RUN_ROOT" \
  --effect-key "smoke-rpc-crash-restart" \
  >"$RUN_ROOT/evidence/rpc-crash-restart.json"
"$REPO_ROOT/scripts/lightning-navcoin-pftl-devnet" status --root "$RUN_ROOT" \
  >"$RUN_ROOT/evidence/status-after-outage.json"
echo "pftl_lightning_devnet_smoke=ok root=$RUN_ROOT"
