#!/usr/bin/env python3
"""Reject maintainer-machine paths in supported source/config surfaces."""

from __future__ import annotations

import pathlib
import ipaddress
import re
import subprocess


ROOT = pathlib.Path(__file__).resolve().parents[1]
SUPPORTED_TRACKED_PREFIXES = (
    "systemd/",
    "python/postfiat_rpc/",
    "wallet-proxy/",
    "wallet-web/src/",
    "crates/execution/src/",
    "crates/node/src/",
    "crates/rpc_sdk/src/",
    "crates/types/src/",
    "crates/wallet/src/",
    "tools/nav-reserve-proof/",
)
FORBIDDEN = b"/home/" + b"postfiat"
IPV4 = re.compile(rb"(?<![0-9.])(?:[0-9]{1,3}\.){3}[0-9]{1,3}(?![0-9.])")
# Compiled SP1 guest ELF artifacts embed cargo-registry/source build paths as panic-location
# strings inside the RISC-V program image. They are include_bytes! dependencies pinned to the
# deployed program verifying key, so those bytes cannot be scrubbed without changing the vkey
# (which would require redeploying the on-chain verifier). Portability of these artifacts is
# governed by their reproducible build configuration, not by source scanning.
# TODO(mainnet): rebuild the guests with --remap-path-prefix for a path-independent, reproducible
# vkey and remove this allowlist.
BINARY_ARTIFACT_ALLOWLIST = frozenset(
    {
        "programs/pfusdc-egress/elf/pfusdc-egress-program",
        "programs/pfusdc-eth-ingress/elf/pfusdc-eth-ingress-program",
        "programs/pfusdc-eth-mainnet-ingress/elf/pfusdc-eth-mainnet-ingress-program",
        "programs/pfusdc-ingress/elf/pfusdc-ingress-bonded-program",
        "programs/pfusdc-ingress/elf/pfusdc-ingress-program",
        "tools/nav-reserve-proof/elf/postfiat-reserve-proof-guest",
        "wallet-web/src/wasm/postfiat_wallet_wasm_bg.wasm",
    }
)


def main() -> int:
    findings: list[str] = []
    tracked = subprocess.check_output(["git", "ls-files", "-z"], cwd=ROOT)
    for raw_path in tracked.split(b"\0"):
        if not raw_path:
            continue
        relative = raw_path.decode("utf-8")
        if not relative.startswith(SUPPORTED_TRACKED_PREFIXES):
            continue
        path = ROOT / relative
        if not path.is_file():
            continue
        data = path.read_bytes()
        if (
            FORBIDDEN in data
            and relative not in BINARY_ARTIFACT_ALLOWLIST
        ):
            findings.append(f"{relative} (embedded maintainer path)")
        if b"\0" in data[:8192]:
            continue
        for match in IPV4.findall(data):
            try:
                address = ipaddress.ip_address(match.decode("ascii"))
            except ValueError:
                continue
            if address.is_global:
                findings.append(f"{relative} (public IPv4 literal)")
                break
    if findings:
        raise SystemExit(
            "nonportable or live-infrastructure literal in public source: "
            + ", ".join(findings)
        )
    print("public source portability regression passed")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
