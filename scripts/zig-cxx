#!/usr/bin/env bash
set -eu

zig_bin=${POSTFIAT_ZIG:-}
if [ -z "$zig_bin" ]; then
    zig_bin=$(command -v zig || true)
fi
if [ -z "$zig_bin" ] || [ ! -x "$zig_bin" ]; then
    echo "set POSTFIAT_ZIG to an executable pinned Zig binary" >&2
    exit 2
fi

args=()
while [ "$#" -gt 0 ]; do
    case "$1" in
        --target=x86_64-unknown-linux-gnu|--target=x86_64-pc-linux)
            # Normalize vendor-qualified triples emitted by Rust and Boost.
            args+=(--target=x86_64-linux-gnu)
            shift
            ;;
        -target|--target)
            if [ "$#" -lt 2 ]; then
                echo "$1 requires a target value" >&2
                exit 2
            fi
            case "$2" in
                x86_64-unknown-linux-gnu|x86_64-pc-linux)
                    args+=(--target=x86_64-linux-gnu)
                    ;;
                *) args+=("$1" "$2") ;;
            esac
            shift 2
            ;;
        *)
            args+=("$1")
            shift
            ;;
    esac
done

exec "$zig_bin" c++ "${args[@]}"
