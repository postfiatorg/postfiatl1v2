#!/usr/bin/env python3
import os
import pathlib
import subprocess
import tempfile

repo = pathlib.Path(__file__).resolve().parents[1]
scanner = repo / "scripts" / "public-secret-scan"

with tempfile.TemporaryDirectory(prefix="postfiat-secret-scan-") as raw:
    root = pathlib.Path(raw)
    subprocess.run(["git", "init", "-q"], cwd=root, check=True)
    (root / "clean.txt").write_text("public documentation\n", encoding="utf-8")
    subprocess.run(["git", "add", "clean.txt"], cwd=root, check=True)
    env = {**os.environ, "POSTFIAT_SECRET_SCAN_ROOT": str(root)}
    clean = subprocess.run([scanner], env=env, text=True, capture_output=True)
    assert clean.returncode == 0, clean.stderr

    # A tracked submodule is represented by a gitlink whose working-tree path
    # is a directory. The scanner must skip that directory instead of trying
    # to read it as a regular file.
    nested = root / "external" / "pinned"
    nested.mkdir(parents=True)
    subprocess.run(["git", "init", "-q"], cwd=nested, check=True)
    subprocess.run(["git", "config", "user.name", "Secret Scan Test"], cwd=nested, check=True)
    subprocess.run(["git", "config", "user.email", "secret-scan@example.invalid"], cwd=nested, check=True)
    (nested / "README.md").write_text("pinned source\n", encoding="utf-8")
    subprocess.run(["git", "add", "README.md"], cwd=nested, check=True)
    subprocess.run(["git", "commit", "-qm", "pinned source"], cwd=nested, check=True)
    subprocess.run(
        ["git", "add", "external/pinned"],
        cwd=root,
        check=True,
        text=True,
        capture_output=True,
    )
    gitlink = subprocess.run([scanner], env=env, text=True, capture_output=True)
    assert gitlink.returncode == 0, gitlink.stderr

    secret = "a" * 64
    (root / "leak.json").write_text(
        f'{{"jupyter_token":"{secret}"}}\n', encoding="utf-8"
    )
    subprocess.run(["git", "add", "leak.json"], cwd=root, check=True)
    leak = subprocess.run([scanner], env=env, text=True, capture_output=True)
    assert leak.returncode != 0, "known credential shape must fail"
    assert "jupyter-token" in leak.stderr
    assert secret not in leak.stderr, "scanner output must not disclose candidate values"

    # A shielded note opening is spend/privacy material even when it appears in
    # a JSON evidence packet rather than under a conventional key filename.
    # The scanner must fail without echoing the opening value.
    (root / "leak.json").unlink()
    note_opening = "b" * 64
    (root / "orchard-evidence.json").write_text(
        f'{{"note":{{"rho":"{note_opening}","psi":"{note_opening}",'
        f'"rcm":"{note_opening}"}}}}\n',
        encoding="utf-8",
    )
    subprocess.run(["git", "add", "-A"], cwd=root, check=True)
    privacy_leak = subprocess.run([scanner], env=env, text=True, capture_output=True)
    assert privacy_leak.returncode != 0, "shielded note opening must fail"
    assert "private-note-opening" in privacy_leak.stderr
    assert note_opening not in privacy_leak.stderr, "scanner must not disclose note openings"

# Deleted fixtures must remain exempt in history, while the same literal in a
# sibling path and a different rule at the exempt path must still fail closed.
with tempfile.TemporaryDirectory(prefix="postfiat-secret-scan-history-") as raw:
    root = pathlib.Path(raw)
    subprocess.run(["git", "init", "-q"], cwd=root, check=True)
    env = {**os.environ, "POSTFIAT_SECRET_SCAN_ROOT": str(root)}

    def commit(message):
        subprocess.run(["git", "add", "-A"], cwd=root, check=True)
        subprocess.run(
            [
                "git", "-c", "user.name=Secret Scan Test",
                "-c", "user.email=secret-scan@example.invalid",
                "-c", "core.hooksPath=/dev/null",
                "commit", "--no-gpg-sign", "-qm", message,
            ],
            cwd=root,
            check=True,
        )

    allowed_path = "wallet-extension/lib/security-regression.test.mjs"
    fixture = root / allowed_path
    fixture.parent.mkdir(parents=True)
    value = "c" * 24
    fixture_text = f'const passphrase = "{value}";\n'
    fixture.write_text(fixture_text, encoding="utf-8")
    commit("Add test-only passphrase")
    fixture.unlink()
    commit("Remove test-only passphrase")

    allowed_history = subprocess.run(
        [scanner, "--history"], env=env, text=True, capture_output=True
    )
    assert allowed_history.returncode == 0, allowed_history.stderr
    assert "passed mode=history" in allowed_history.stdout
    assert value not in allowed_history.stdout + allowed_history.stderr

    unlisted_path = "wallet-extension/lib/unlisted-history-fixture.mjs"
    unlisted = root / unlisted_path
    unlisted.write_text(fixture_text, encoding="utf-8")
    # The allowlist is keyed by (rule, path), not by path alone.
    token = "ghp_" + "d" * 36
    fixture.write_text(f'const token = "{token}";\n', encoding="utf-8")
    commit("Add non-allow-listed history findings")
    unlisted.unlink()
    fixture.unlink()
    commit("Remove non-allow-listed findings from the tree")

    clean_tree = subprocess.run([scanner], env=env, text=True, capture_output=True)
    assert clean_tree.returncode == 0, clean_tree.stderr
    rejected_history = subprocess.run(
        [scanner, "--history"], env=env, text=True, capture_output=True
    )
    assert rejected_history.returncode == 1, "removed non-allow-listed findings must fail"
    assert f"rule=secret-field location={unlisted_path}:1" in rejected_history.stderr
    assert f"rule=github-token location={allowed_path}:1" in rejected_history.stderr
    assert f"rule=secret-field location={allowed_path}:" not in rejected_history.stderr
    assert "FAILED mode=history findings=2" in rejected_history.stderr
    output = rejected_history.stdout + rejected_history.stderr
    assert value not in output and token not in output, "history output must redact values"

print("public secret scan regression passed")
