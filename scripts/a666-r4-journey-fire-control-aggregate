#!/usr/bin/env bash
set -Eeuo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
evidence_root="$repo/docs/evidence/a666-public-reserve-product-20260803/browser"
construction="$evidence_root/r4-construction"
pass1="$evidence_root/r4-pass1"
preflight="$pass1/journey-fire-control-preflight.json"
refire_prepared="$construction/receipt-verifier-spike/docker-refire-prepared.json"
refire_probe="$construction/receipt-verifier-spike/docker-refire-probe.json"
refire_fired="$construction/receipt-verifier-spike/docker-refire-fired.json"
b_stage="$construction/ethereum-contract-stage.json"
historical_fleet="$construction/fleet/construction-fleet.json"
fresh_fleet="$construction/fleet/fresh-restore.json"
route_stage="$construction/route-activation.json"
candidate_proxy="$construction/candidate-proxy-provenance.json"
dependencies="$construction/private-swap-dependencies-refresh.json"
pftl_stage="$construction/private-swap-stage.json"
d_runner="$construction/journey-runner-dry-run.json"
async_proof_slot="$construction/async-proof-slot.json"
stakehub_inventory="$pass1/stakehub-restart-proof.json"
preprove_binding="$construction/pre-prove-binding-check.json"
path_b_schema="postfiat.a666.r4.path-b-pre-prove-binding-check.v1"
path_b_candidate="39f7fae3191aa34c376ae1657650a9ec2444f421"
path_b_decoder_sha256="6fb2fb9ac693e5cea787eeb4a80701de562d3b12ce47d837d121d8dc361f6d4a"

binding_json() {
    local path="$1"
    if [[ ! -r "$path" ]] || ! jq -e . "$path" >/dev/null 2>&1; then
        printf '%s' '{"candidate_revision":null,"rehearsal_root":null,"run_id":null}'
        return
    fi
    jq -c '
        . as $raw
        | (if ($raw | type) == "object" then $raw else {} end) as $o
        | (if ($o.bindings | type) == "object" then $o.bindings elif ($o.binding | type) == "object" then $o.binding else {} end) as $binding
        | (if ($o.candidate | type) == "object" then $o.candidate else {} end) as $candidate
        | {
            candidate_revision: ($binding.candidate_revision // $candidate.revision_observed // $o.candidate_revision // null),
            rehearsal_root: ($binding.rehearsal_root // (if ($o.rehearsal_root | type) == "string" then $o.rehearsal_root elif ($o.preserved_root | type) == "string" then $o.preserved_root elif ($o.preserved_root | type) == "object" then $o.preserved_root.path else null end)),
            run_id: ($binding.run_id // $o.run_id // $o.setup_run_id // null)
        }
    ' "$path"
}

input_summary() {
    local path="$1"
    if [[ ! -e "$path" ]]; then
        jq -cn --arg path "$path" '{path: $path, exists: false, valid_json: false, observed_status: "absent", observed_reason: "evidence_absent", bindings: {candidate_revision: null, rehearsal_root: null, run_id: null}}'
        return
    fi
    if ! jq -e . "$path" >/dev/null 2>&1; then
        jq -cn --arg path "$path" '{path: $path, exists: true, valid_json: false, observed_status: "invalid_json", observed_reason: "evidence_invalid_json", bindings: {candidate_revision: null, rehearsal_root: null, run_id: null}}'
        return
    fi
    jq -c --arg path "$path" '
        . as $raw
        | (if ($raw | type) == "object" then $raw else {} end) as $o
        | (if ($o.bindings | type) == "object" then $o.bindings elif ($o.binding | type) == "object" then $o.binding else {} end) as $binding
        | (if ($o.candidate | type) == "object" then $o.candidate else {} end) as $candidate
        | {
            path: $path,
            exists: true,
            valid_json: true,
            observed_status: ($o.assessment // $o.outcome // $o.status // $o.ready // $o.accepted // $o.construction_ready // $o.probe2.verdict // null),
            observed_reason: ($o.first_failing_check // $o.first_blocker // $o.required_next_action // $o.post_activation_dependency.wall // $o.probe1.root_cause // null),
            bindings: {
                candidate_revision: ($binding.candidate_revision // $candidate.revision_observed // $o.candidate_revision // null),
                rehearsal_root: ($binding.rehearsal_root // (if ($o.rehearsal_root | type) == "string" then $o.rehearsal_root elif ($o.preserved_root | type) == "string" then $o.preserved_root elif ($o.preserved_root | type) == "object" then $o.preserved_root.path else null end)),
                run_id: ($binding.run_id // $o.run_id // $o.setup_run_id // null)
            }
        }
    ' "$path"
}

json_true() {
    local path="$1"
    local filter="$2"
    [[ -r "$path" ]] && jq -e "$filter" "$path" >/dev/null 2>&1
}

preprove_ok_for_file() {
    local path="$1"
    [[ -r "$path" ]] || return 1
    jq -e --arg schema "$path_b_schema" --arg candidate "$path_b_candidate" --arg decoder "$path_b_decoder_sha256" '
        .schema == $schema
        and .candidate_revision == $candidate
        and (.witness_sha256 | type == "string" and length > 0)
        and (.deployment_evidence_path | type == "string" and length > 0)
        and (.deployment_commit | type == "string" and length > 0)
        and .decoder_sha256 == $decoder
        and .decoded_field_count == 35
        and .conjunction_field_count == 35
        and .exact_mismatch_count == 0
        and .all_match == true
        and (.prior_checkpoint_commitment | type == "string" and length > 0)
        and (.initial_checkpoint_commitment | type == "string" and length > 0)
        and .prior_checkpoint_matches_initial == true
        and .route_matches == true
        and .controller_matches == true
        and .wrapped_matches == true
        and .chain_matches == true
        and .genesis_matches == true
        and .protocol_matches == true
        and .program_vkey_matches == true
        and .live_chain == false
        and .business_value == 0
        and .stakehub == false
    ' "$path" >/dev/null 2>&1
}

run_preprove_self_test() {
    local test_root
    test_root=$(mktemp -d /tmp/a666-r4-preprove-binding-self-test.XXXXXX)
    chmod 700 "$test_root"
    cat >"$test_root/green.json" <<'JSON'
{
  "schema": "postfiat.a666.r4.path-b-pre-prove-binding-check.v1",
  "candidate_revision": "39f7fae3191aa34c376ae1657650a9ec2444f421",
  "witness_sha256": "self-test-witness",
  "deployment_evidence_path": "self-test-deployment",
  "deployment_commit": "self-test-commit",
  "decoder_sha256": "6fb2fb9ac693e5cea787eeb4a80701de562d3b12ce47d837d121d8dc361f6d4a",
  "decoded_field_count": 35,
  "conjunction_field_count": 35,
  "exact_mismatch_count": 0,
  "all_match": true,
  "prior_checkpoint_commitment": "self-test-prior",
  "initial_checkpoint_commitment": "self-test-initial",
  "prior_checkpoint_matches_initial": true,
  "route_matches": true,
  "controller_matches": true,
  "wrapped_matches": true,
  "chain_matches": true,
  "genesis_matches": true,
  "protocol_matches": true,
  "program_vkey_matches": true,
  "live_chain": false,
  "business_value": 0,
  "stakehub": false
}
JSON
    jq '.prior_checkpoint_matches_initial = false' "$test_root/green.json" >"$test_root/prior-checkpoint-mismatch.json"
    preprove_ok_for_file "$test_root/green.json"
    if preprove_ok_for_file "$test_root/prior-checkpoint-mismatch.json"; then
        printf '%s\n' "pre_prove_binding_self_test=FAIL fixture_root=$test_root"
        return 1
    fi
    printf '%s\n' "pre_prove_binding_self_test=PASS green=true prior_checkpoint_mismatch=false fixture_root=$test_root"
}

if [[ $# -gt 0 ]]; then
    if [[ "$1" == "--self-test" && $# == 1 ]]; then
        run_preprove_self_test
        exit 0
    fi
    printf '%s\n' "usage: $0 [--self-test]" >&2
    exit 2
fi

bound_and() {
    local path="$1"
    local filter="$2"
    [[ -n "$candidate_revision" && -n "$fresh_root" && -n "$fresh_run" ]] || return 1
    [[ -r "$path" ]] || return 1
    jq -e --arg candidate "$candidate_revision" --arg root "$fresh_root" --arg run "$fresh_run" '
        . as $raw
        | (if ($raw | type) == "object" then $raw else {} end) as $o
        | (if ($o.bindings | type) == "object" then $o.bindings elif ($o.binding | type) == "object" then $o.binding else {} end) as $binding
        | ($binding.candidate_revision == $candidate)
        and ($binding.rehearsal_root == $root)
        and ($binding.run_id == $run)
    ' "$path" >/dev/null 2>&1 || return 1
    jq -e "$filter" "$path" >/dev/null 2>&1
}

refire_prepared_ok=false
refire_probe_ok=false
refire_fired_ok=false
refire_unit_or_terminal_ok=false
b_contract_stage_ok=false
b_verifier_acceptance_ok=false
fresh_fleet_ok=false
fresh_route_ok=false
candidate_proxy_ok=false
dependencies_ok=false
pftl_ok=false
d_runner_dry_ok=false
async_proof_slot_ok=false
stakehub_inventory_ok=false
stakehub_official_absent_ok=false
candidate_provenance_ok=false
no_live_chain_ok=false
preprove_bindings_ok=false

candidate_revision=""
if [[ -r "$candidate_proxy" ]]; then
    candidate_revision=$(jq -r 'if (.candidate | type) == "object" then .candidate.revision_observed // empty else .candidate_revision // empty end' "$candidate_proxy")
fi
if [[ -z "$candidate_revision" && -r "$preflight" ]]; then
    candidate_revision=$(jq -r '.aggregation.current_binding.candidate_revision // empty' "$preflight")
fi
fresh_binding=$(binding_json "$fresh_fleet")
fresh_root=$(jq -r '.rehearsal_root // empty' <<<"$fresh_binding")
fresh_run=$(jq -r '.run_id // empty' <<<"$fresh_binding")

if json_true "$refire_prepared" '.prepared == true and (.run_id | type == "string" and length > 0)'; then
    refire_prepared_ok=true
fi
prepared_run=""
if [[ "$refire_prepared_ok" == true ]]; then
    prepared_run=$(jq -r '.run_id' "$refire_prepared")
fi
if [[ "$refire_prepared_ok" == true && -n "$prepared_run" ]] && [[ -r "$refire_probe" ]] && jq -e --arg run "$prepared_run" '.run_id == $run and (.passed == true or .probe.passed == true or (.probe2.exit_code == 0 and .probe2.verdict == "GREEN" and .probe2.server_reachable == true and .probe2.pinned_image_visible_inside_unit == true))' "$refire_probe" >/dev/null 2>&1; then
    refire_probe_ok=true
fi
if [[ "$refire_prepared_ok" == true && -n "$prepared_run" ]] && [[ -r "$refire_fired" ]] && jq -e --arg run "$prepared_run" '.fired == true and .run_id == $run' "$refire_fired" >/dev/null 2>&1; then
    refire_fired_ok=true
fi
if [[ "$refire_fired_ok" == true ]] && json_true "$refire_fired" '(.unit.active_state == "active") or (.unit.state == "active") or (.terminal.accepted == true and .terminal.outcome == "accepted")'; then
    refire_unit_or_terminal_ok=true
fi

if bound_and "$b_stage" '.deployment.green == true and (.deployment.contracts.sp1_verifier.address | type == "string") and (.deployment.contracts.wrapped_venue_navcoin.address | type == "string") and (.deployment.contracts.pftl_receipt_finality_verifier_v1.address | type == "string") and (.deployment.contracts.pftl_uniswap_primary_market_v2.address | type == "string")'; then
    b_contract_stage_ok=true
fi
if bound_and "$b_stage" '.verifier_acceptance.ready == true and (.verifier_acceptance.accepted == true or .verifier_acceptance.outcome == "accepted")'; then
    b_verifier_acceptance_ok=true
fi
if json_true "$fresh_fleet" '.construction_ready == true and (.checks.fleet_12_live_six_equal == true or .checks.construction_fleet_12_live_six_equal == true or .checks.six_way_equal == true) and (.bindings.candidate_revision | type == "string" and length > 0) and (.bindings.rehearsal_root | type == "string" and length > 0) and (.bindings.run_id | type == "string" and length > 0)'; then
    fresh_fleet_ok=true
fi
if bound_and "$route_stage" '.accepted == true and .activation_checks.route_live == true and .activation_checks.six_way_convergence == true'; then
    fresh_route_ok=true
fi
if bound_and "$candidate_proxy" '.ready == true and .candidate.revision_exact == true and .candidate.tracked_dirty_count == 0 and .proxy_hold.healthz_reachable == true'; then
    candidate_proxy_ok=true
fi
if bound_and "$dependencies" '.ready == true and .checks.construction_fleet_12_live_six_equal == true and .checks.route_live_epoch_5_on_six == true'; then
    dependencies_ok=true
fi
if bound_and "$pftl_stage" '.ready == true and .checks.daemon_readiness == true and .checks.rehearsal_rpc_fleet_live == true'; then
    pftl_ok=true
fi
if bound_and "$d_runner" '.dry_run == true and .checks.steps_1_6_9_10_dry_run == true'; then
    d_runner_dry_ok=true
fi
if bound_and "$async_proof_slot" '.checks.steps_7_8_async_proof_slot == true and .contract.mode == "asynchronous_content_addressed_artifact_consumption" and .contract.inline_proving_forbidden == true'; then
    async_proof_slot_ok=true
fi
if preprove_ok_for_file "$preprove_binding"; then
    preprove_bindings_ok=true
fi

proof_contract='null'
if proof_contract_candidate=$(git show ad30bcb:docs/evidence/a666-public-reserve-product-20260803/browser/r4-pass1/journey-fire-control-preflight.json 2>/dev/null | jq -ce '.proof_artifact_consumption_contract' 2>/dev/null); then
    proof_contract="$proof_contract_candidate"
fi

stakehub_scan_ok=false
stakehub_active_units='[]'
if stakehub_units=$(systemctl --user list-units --type=service --all --no-legend 'stakehub*' 2>/dev/null); then
    stakehub_scan_ok=true
    stakehub_active_units=$(printf '%s\n' "$stakehub_units" | awk '$3 == "active" {print $1}' | jq -Rsc 'split("\n") | map(select(length > 0))')
fi
if bound_and "$stakehub_inventory" '(.units | type == "array" and length > 0)'; then
    stakehub_inventory_ok=true
fi
if [[ "$stakehub_scan_ok" == true && "$stakehub_inventory_ok" == true ]] && [[ "$(jq 'length' <<<"$stakehub_active_units")" == 0 ]]; then
    stakehub_official_absent_ok=true
fi
if bound_and "$candidate_proxy" '.candidate.revision_exact == true and .candidate.tracked_dirty_count == 0'; then
    candidate_provenance_ok=true
fi
if bound_and "$d_runner" '.checks.no_live_chain == true and .checks.loopback_only == true'; then
    no_live_chain_ok=true
fi

check_records=$(jq -cn \
    --argjson refire_prepared_ok "$refire_prepared_ok" \
    --argjson refire_probe_ok "$refire_probe_ok" \
    --argjson refire_fired_ok "$refire_fired_ok" \
    --argjson refire_unit_or_terminal_ok "$refire_unit_or_terminal_ok" \
    --argjson b_contract_stage_ok "$b_contract_stage_ok" \
    --argjson b_verifier_acceptance_ok "$b_verifier_acceptance_ok" \
    --argjson fresh_fleet_ok "$fresh_fleet_ok" \
    --argjson fresh_route_ok "$fresh_route_ok" \
    --argjson candidate_proxy_ok "$candidate_proxy_ok" \
    --argjson dependencies_ok "$dependencies_ok" \
    --argjson pftl_ok "$pftl_ok" \
    --argjson d_runner_dry_ok "$d_runner_dry_ok" \
    --argjson async_proof_slot_ok "$async_proof_slot_ok" \
    --argjson stakehub_inventory_ok "$stakehub_inventory_ok" \
    --argjson stakehub_official_absent_ok "$stakehub_official_absent_ok" \
    --argjson candidate_provenance_ok "$candidate_provenance_ok" \
    --argjson no_live_chain_ok "$no_live_chain_ok" \
    --argjson preprove_bindings_ok "$preprove_bindings_ok" \
    '[
        {id: "docker_refire_prepared", ok: $refire_prepared_ok, input: "refire_prepared"},
        {id: "docker_refire_probe", ok: $refire_probe_ok, input: "refire_probe"},
        {id: "docker_refire_fired", ok: $refire_fired_ok, input: "refire_fired"},
        {id: "docker_refire_unit_live_or_terminal_proof_success", ok: $refire_unit_or_terminal_ok, input: "refire_fired"},
        {id: "b_full_real_contract_stage_green", ok: $b_contract_stage_ok, input: "b_contract_stage"},
        {id: "b_real_verifier_acceptance", ok: $b_verifier_acceptance_ok, input: "b_contract_stage"},
        {id: "fresh_fleet_12_of_12_six_equal", ok: $fresh_fleet_ok, input: "fresh_fleet"},
        {id: "fresh_route_live", ok: $fresh_route_ok, input: "fresh_route"},
        {id: "candidate_proxy_ready", ok: $candidate_proxy_ok, input: "candidate_proxy"},
        {id: "private_dependencies_ready", ok: $dependencies_ok, input: "dependencies"},
        {id: "pftl_private_swap_ready", ok: $pftl_ok, input: "pftl"},
        {id: "d_runner_steps_1_6_9_10_dry_run", ok: $d_runner_dry_ok, input: "d_runner"},
        {id: "async_proof_slot_steps_7_8", ok: $async_proof_slot_ok, input: "async_proof_slot"},
        {id: "stakehub_restart_inventory_present", ok: $stakehub_inventory_ok, input: "stakehub_restart_inventory"},
        {id: "stakehub_official_absent", ok: $stakehub_official_absent_ok, input: "stakehub_official_scan"},
        {id: "candidate_revision_and_provenance", ok: $candidate_provenance_ok, input: "candidate_proxy"},
        {id: "no_live_chain_dependency", ok: $no_live_chain_ok, input: "d_runner"},
        {id: "pre_prove_all_35_bindings", ok: $preprove_bindings_ok, input: "pre_prove_binding"}
    ]')

jq -n \
    --arg candidate_revision "$candidate_revision" \
    --arg fresh_root "$fresh_root" \
    --arg fresh_run "$fresh_run" \
    --argjson proof_contract "$proof_contract" \
    --argjson refire_prepared_input "$(input_summary "$refire_prepared")" \
    --argjson refire_probe_input "$(input_summary "$refire_probe")" \
    --argjson refire_fired_input "$(input_summary "$refire_fired")" \
    --argjson b_stage_input "$(input_summary "$b_stage")" \
    --argjson historical_fleet_input "$(input_summary "$historical_fleet")" \
    --argjson fresh_fleet_input "$(input_summary "$fresh_fleet")" \
    --argjson route_input "$(input_summary "$route_stage")" \
    --argjson proxy_input "$(input_summary "$candidate_proxy")" \
    --argjson dependencies_input "$(input_summary "$dependencies")" \
    --argjson pftl_input "$(input_summary "$pftl_stage")" \
    --argjson d_runner_input "$(input_summary "$d_runner")" \
    --argjson async_slot_input "$(input_summary "$async_proof_slot")" \
    --argjson stakehub_input "$(input_summary "$stakehub_inventory")" \
    --argjson preprove_input "$(input_summary "$preprove_binding")" \
    --argjson stakehub_scan_ok "$stakehub_scan_ok" \
    --argjson stakehub_active_units "$stakehub_active_units" \
    --argjson check_records "$check_records" \
    '{
        schema: "postfiat.a666.r4.journey-fire-control-preflight.v3",
        aggregation: {
            mode: "fail_closed_current_evidence",
            binding_contract: {
                required_fields: ["bindings.candidate_revision", "bindings.rehearsal_root", "bindings.run_id"],
                historical_evidence_rejected_without_matching_binding: true
            },
            current_binding: {
                candidate_revision: (if $candidate_revision == "" then null else $candidate_revision end),
                rehearsal_root: (if $fresh_root == "" then null else $fresh_root end),
                run_id: (if $fresh_run == "" then null else $fresh_run end)
            }
        },
        inputs: {
            refire_prepared: $refire_prepared_input,
            refire_probe: $refire_probe_input,
            refire_fired: $refire_fired_input,
            b_contract_stage: $b_stage_input,
            historical_fleet_rejected: $historical_fleet_input,
            fresh_fleet: $fresh_fleet_input,
            fresh_route: $route_input,
            candidate_proxy: $proxy_input,
            dependencies: $dependencies_input,
            pftl: $pftl_input,
            d_runner: $d_runner_input,
            async_proof_slot: $async_slot_input,
            stakehub_restart_inventory: $stakehub_input,
            pre_prove_binding: $preprove_input,
            stakehub_official_scan: {
                command_succeeded: $stakehub_scan_ok,
                active_units: $stakehub_active_units
            }
        },
        proof_artifact_consumption_contract: $proof_contract,
        checks: $check_records
    }
    | .checks as $checks
    | . + {
        check_count: ($checks | length),
        blocker_names: [$checks[] | select(.ok | not) | .id],
        ready_to_fire: ([$checks[].ok] | all),
        ready_to_fire_computation: "all checks[].ok values must be true",
        mutations_executed: false
    }'
