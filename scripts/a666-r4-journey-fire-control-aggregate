        $s.schema == "postfiat.a666.r4.async-proof-slot.v1" and $s.status == "accepted" and $s.run_id == $run and $s.export_slot_accepted == true and $s.first_blocker == null
        and $s.inline_proving_forbidden == true and $s.prover_invocations == 0 and $s.business_mutations == 0
        and $e.schema == "postfiat.a666.r4.export-artifact-slot.v1" and $e.status == "accepted" and $e.accepted == true and $e.run_id == $run
        and $e.proof_report.program_vkey == $t.pin_checks.program_vkey and $e.artifact_sha256 == $t.artifacts.proof_bin.sha256 and $e.proof_calldata.sha256 == $t.artifacts.proof_calldata_bin.sha256 and $e.public_values.sha256 == $t.artifacts.public_values_bin.sha256
