binding_json() {
    local path="$1"
    if [[ ! -r "$path" ]] || ! jq -e . "$path" >/dev/null 2>&1; then
        printf '%s' '{"candidate_revision":null,"rehearsal_root":null,"run_id":null}'
        return
    fi
    jq -c '
        . as $raw
        | (if ($raw | type) == "object" then $raw else {} end) as $o
        | (if ($o.bindings | type) == "object" then $o.bindings elif ($o.binding | type) == "object" then $o.binding else {} end) as $binding
        | (if ($o.candidate | type) == "object" then $o.candidate else {} end) as $candidate
        | {
            candidate_revision: ($binding.candidate_revision // $candidate.revision_observed // $o.candidate_revision // null),
            rehearsal_root: ($binding.rehearsal_root // (if ($o.rehearsal_root | type) == "string" then $o.rehearsal_root elif ($o.preserved_root | type) == "string" then $o.preserved_root elif ($o.preserved_root | type) == "object" then $o.preserved_root.path else null end)),
            run_id: ($binding.run_id // $o.run_id // $o.setup_run_id // null)
        }
    ' "$path"
}

input_summary() {
    local path="$1"
    if [[ ! -e "$path" ]]; then
        jq -cn --arg path "$path" '{path: $path, exists: false, valid_json: false, observed_status: "absent", observed_reason: "evidence_absent", bindings: {candidate_revision: null, rehearsal_root: null, run_id: null}}'
        return
    fi
    if ! jq -e . "$path" >/dev/null 2>&1; then
        jq -cn --arg path "$path" '{path: $path, exists: true, valid_json: false, observed_status: "invalid_json", observed_reason: "evidence_invalid_json", bindings: {candidate_revision: null, rehearsal_root: null, run_id: null}}'
        return
    fi
    jq -c --arg path "$path" '
        . as $raw
        | (if ($raw | type) == "object" then $raw else {} end) as $o
        | (if ($o.bindings | type) == "object" then $o.bindings elif ($o.binding | type) == "object" then $o.binding else {} end) as $binding
        | (if ($o.candidate | type) == "object" then $o.candidate else {} end) as $candidate
        | {
            path: $path,
            exists: true,
            valid_json: true,
            observed_status: ($o.assessment // $o.outcome // $o.status // $o.ready // $o.accepted // $o.construction_ready // $o.probe2.verdict // null),
            observed_reason: ($o.first_failing_check // $o.first_blocker // $o.required_next_action // $o.post_activation_dependency.wall // $o.probe1.root_cause // null),
            bindings: {
                candidate_revision: ($binding.candidate_revision // $candidate.revision_observed // $o.candidate_revision // null),
                rehearsal_root: ($binding.rehearsal_root // (if ($o.rehearsal_root | type) == "string" then $o.rehearsal_root elif ($o.preserved_root | type) == "string" then $o.preserved_root elif ($o.preserved_root | type) == "object" then $o.preserved_root.path else null end)),
                run_id: ($binding.run_id // $o.run_id // $o.setup_run_id // null)
            }
        }
    ' "$path"
}

json_true() {
    local path="$1"
    local filter="$2"
    [[ -r "$path" ]] && jq -e "$filter" "$path" >/dev/null 2>&1
}

repository_relative_readable_path() {
    local path="$1"
    [[ -n "$path" && "$path" != /* && "$path" != *".."* && "$path" =~ ^[A-Za-z0-9._/-]+$ && -r "$repo/$path" ]]
}

resolve_under() {
    local root="$1"
    local path="$2"
    local candidate="$path"
    [[ "$candidate" == /* ]] || candidate="$root/$candidate"
    local resolved
    resolved=$(realpath -m "$candidate") || return 1
    [[ "$resolved" == "$root/"* && -r "$resolved" ]] || return 1
    printf '%s\n' "$resolved"
}

fleet_validation_for_files() {
    local fleet_path="$1" staging_path="$2" allowed_root="$3"
    local report_ref report_path staging_ref staging_path_resolved declared_sha actual_sha root tip
    if [[ ! -r "$fleet_path" || ! -r "$staging_path" ]] || ! jq -e . "$fleet_path" >/dev/null 2>&1 || ! jq -e . "$staging_path" >/dev/null 2>&1; then
        jq -cn --arg path "$fleet_path" '{path:$path,ok:false,reason:"fleet_or_staging_evidence_absent_or_invalid",binding_identifier:null,rehearsal_root:null,tip:null}'
        return
    fi
    report_ref=$(jq -r '.controlled_report.path // empty' "$fleet_path")
    staging_ref=$(jq -r '.lifecycle.report_path // empty' "$staging_path")
    report_path=$(resolve_under "$allowed_root" "$report_ref" 2>/dev/null || true)
    staging_path_resolved=$(resolve_under "$allowed_root" "$staging_ref" 2>/dev/null || true)
    declared_sha=$(jq -r '.controlled_report.sha256 // empty' "$fleet_path")
    actual_sha=""
    [[ -n "$report_path" ]] && actual_sha=$(sha256sum "$report_path" | awk '{print $1}')
    root=$(jq -r '.preserved_root // empty' "$fleet_path")
    tip=$(jq -r '.post_rollback.tip // empty' "$staging_path")
    jq -cn \
        --arg fleet "$fleet_path" --arg report "$report_path" --arg staging_report "$staging_path_resolved" \
        --arg declared "$declared_sha" --arg actual "$actual_sha" --arg root "$root" --arg tip "$tip" \
        --arg candidate "$path_b_candidate" \
        --argjson fleet_doc "$(cat "$fleet_path")" --argjson staging_doc "$(cat "$staging_path")" \
        --argjson report_doc "$(if [[ -n "$report_path" ]]; then cat "$report_path"; else printf '{}'; fi)" \
        '{
            path:$fleet, controlled_report_path:(if $report=="" then null else $report end),
            controlled_report_sha256:(if $actual=="" then null else $actual end),
            binding_identifier:(if $actual=="" then null else $actual end), rehearsal_root:(if $root=="" then null else $root end), tip:(if $tip=="" then null else $tip end),
            ok:(
                $fleet_doc.schema == "postfiat.a666.r4.construction-fleet.v1"
                and $fleet_doc.construction_ready == true
                and $fleet_doc.candidate.revision == $candidate
                and ($root | type == "string" and length > 0)
                and $fleet_doc.checks.processes_live == true and $fleet_doc.checks.ready_files == true and $fleet_doc.checks.six_way_equal == true
                and $fleet_doc.checks.stakehub_interaction == false and $fleet_doc.checks.business_operations_submitted == 0
                and ($report | type == "string" and length > 0) and $report == $staging_report
                and ($declared | test("^[0-9a-f]{64}$")) and $declared == $actual and $staging_doc.lifecycle.report_sha256 == $actual
                and $fleet_doc.controlled_report.final_height == 826
                and $report_doc.ok == true and $report_doc.validator_count == 6 and $report_doc.final_state.height == 826
                and $report_doc.final_state.all_six_equal == true and $report_doc.final_state.verify_state_all_six == true and $report_doc.final_state.tip == $tip
                and $report_doc.final_state.state_root == $staging_doc.post_rollback.state_root
                and $staging_doc.schema == "postfiat.a666.r4.fresh-fleet-staging.v1" and $staging_doc.state == "ready"
                and $staging_doc.candidate.revision == $candidate and $staging_doc.post_rollback.preserved_root == $root
                and $staging_doc.post_rollback.height == 826 and ($tip | test("^[0-9a-f]{96}$")) and $staging_doc.post_rollback.six_way_equal == true
                and $staging_doc.fleet.children_live == 12 and $staging_doc.fleet.ready_files == 12 and $staging_doc.fleet.validator_count == 6 and $staging_doc.fleet.six_way_equal == true
                and $staging_doc.checks.stakehub_untouched == true and $staging_doc.checks.business_operations_outside_controlled_lifecycle == 0
            )
        }'
}

path_b_stage_validation() {
    local path="$1" fleet_json="$2"
    local tip root expected_checkpoint
    tip=$(jq -r '.tip // empty' <<<"$fleet_json")
    root=$(jq -r '.rehearsal_root // empty' <<<"$fleet_json")
    expected_checkpoint=""
    [[ "$tip" =~ ^[0-9a-f]{96}$ ]] && expected_checkpoint=$(cast keccak "0x$tip")
    if [[ ! -r "$path" ]] || ! jq -e . "$path" >/dev/null 2>&1; then
        jq -cn '{ok:false,reason:"b_stage_evidence_absent_or_invalid"}'
        return
    fi
    jq -cn --arg tip "$tip" --arg root "$root" --arg checkpoint "$expected_checkpoint" --arg candidate "$path_b_candidate" --argjson doc "$(cat "$path")" '
        {
          expected:{candidate_revision:$candidate,prior_block_id:$tip,initial_checkpoint_commitment:$checkpoint,initial_height:826,rehearsal_root:$root},
          ok:(
            $doc.corrective_deployment.candidate_revision == "39f7fae"
            and $doc.bindings.candidate_revision == $candidate and $doc.bindings.rehearsal_root == $root
            and $doc.path_b.initial_finalized_height == 826 and $doc.path_b.prior_block_id == $tip
            and ($checkpoint | test("^0x[0-9a-f]{64}$")) and ($doc.path_b.initial_checkpoint_commitment | ascii_downcase) == ($checkpoint | ascii_downcase)
            and $doc.deployment.green == true and $doc.deployment.mocks == 0
            and ($doc.deployment.contracts.sp1_verifier.address | type == "string" and length > 0)
            and ($doc.deployment.contracts.wrapped_venue_navcoin.address | type == "string" and length > 0)
            and ($doc.deployment.contracts.pftl_receipt_finality_verifier_v1.address | type == "string" and length > 0)
            and ($doc.deployment.contracts.pftl_uniswap_primary_market_v2.address | type == "string" and length > 0)
          )
        }'
}

candidate_proxy_validation_for_file() {
    local path="$1" fleet_json="$2"
    local root
    root=$(jq -r '.rehearsal_root // empty' <<<"$fleet_json")
    if [[ ! -r "$path" ]] || ! jq -e . "$path" >/dev/null 2>&1; then
        jq -cn '{ok:false,reason:"candidate_proxy_evidence_absent_or_invalid"}'
        return
    fi
    jq -cn --arg candidate "$path_b_candidate" --arg root "$root" --argjson doc "$(cat "$path")" '
        {
          expected:{candidate_revision:$candidate,rehearsal_root:$root,proxy_listen:"127.0.0.1:31021"},
          ok:(
            $doc.schema == "postfiat.a666.r4.candidate-proxy-provenance.v1"
            and $doc.ready == true
            and $doc.candidate.revision_expected == $candidate and $doc.candidate.revision_observed == $candidate
            and $doc.candidate.revision_exact == true and $doc.candidate.tracked_dirty_count == 0
            and ($doc.node_binary.sha256 | type == "string" and test("^[0-9a-f]{64}$"))
            and ($doc.wallet_proxy_source.tree_hash_at_candidate | type == "string" and test("^[0-9a-f]{40}$"))
            and ($doc.wallet_proxy_source.server_js_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
            and ($doc.wallet_proxy_source.package_lock_sha256 | type == "string" and test("^[0-9a-f]{64}$"))
            and $doc.fresh_fleet.preserved_root == $root and $doc.fresh_fleet.children_live == 12 and $doc.fresh_fleet.accepted == true
            and $doc.rpc_endpoints.count == 6 and $doc.rpc_endpoints.loopback == true and $doc.rpc_endpoints.live == true
            and $doc.rpc_endpoints.live_all_equal == true and $doc.rpc_endpoints.matches_committed_tuples == true and $doc.rpc_endpoints.height == 826
            and ($doc.proxy_hold.pid | type == "number" and . > 0) and $doc.proxy_hold.listen == "127.0.0.1:31021"
            and $doc.proxy_hold.healthz_reachable == true and $doc.proxy_hold.process_identity_exact == true
            and $doc.proxy_hold.business_operations_submitted == 0 and $doc.d_preflight_observation.business_mutations == 0
            and $doc.no_live_chain_route == true and $doc.stakehub_dependency_free == true and $doc.stakehub_interaction == false
          )
        }'
}

current_route_validation() {
    python3 - "$route_stage" "$return_artifact_slot" <<'PY'
import json,socket,sys
p=json.load(open(sys.argv[1],encoding='utf-8'))
return_slot=json.load(open(sys.argv[2],encoding='utf-8'))
observed=return_slot.get('observed_chain_state',{})
expected_tuple={'equal':True,'height':observed.get('height'),'block_tip_hash':observed.get('tip'),'state_root':observed.get('state_root')}
expected_tip=expected_tuple['block_tip_hash']
expected_root=expected_tuple['state_root']
return_ok=(return_slot.get('schema')=='postfiat.a666.r4.return-artifact-slot.v1' and return_slot.get('status')=='accepted' and return_slot.get('ok') is True and return_slot.get('accepted') is True and observed.get('height')==833 and observed.get('finalized') is True and return_slot.get('conservation',{}).get('equal') is True and return_slot.get('live_chain') is False and return_slot.get('stakehub_interaction') is False and return_slot.get('business_mutations')==0)
route=p.get('six_rpc_route',{}); tup=p.get('six_rpc_tuple',{}); endpoints=p.get('query',{}).get('endpoints',[])
base=(p.get('schema')=='postfiat.a666.r4.route-current-state.v1' and p.get('accepted') is True and p.get('candidate_revision')=='39f7fae3191aa34c376ae1657650a9ec2444f421' and p.get('bindings',{}).get('controlled_report_sha256')=='c2fb973f284d92cf3b866c4abe86aca237f8e4bd753cbf03075ab71702810cf2' and len(endpoints)==6 and len(set(endpoints))==6 and all(x.startswith('127.0.0.1:') for x in endpoints) and tup==expected_tuple and return_ok and route.get('route_id')=='pftl-a666-r4-offline-rehearsal-v1' and route.get('route_epoch')==2 and route.get('policy_epoch')==2 and route.get('live_value_enabled') is True and route.get('paused') is False and route.get('invariant_holds') is True and route.get('route_config_digest')=='b2'*48 and route.get('policy_hash')=='5dcc28ea82872d05716dbb94af480f6dd1355dde8a931633a01dfdec309c4bbd5e5ee16e104afba75913eb0100123044' and p.get('activation_submitted') is False and p.get('business_operations')==0 and p.get('stakehub_interaction') is False and p.get('live_chain') is False)
if not base:
 print(json.dumps({'ok':False,'queried_endpoint_count':0,'base_evidence_valid':False})); raise SystemExit(0)
rows=[]
try:
 for endpoint in endpoints:
  host,port=endpoint.rsplit(':',1); vals=[]
  for method,params in [('status',{}),('navcoin_bridge_supply_status',{'route_id':route.get('route_id')})]:
   with socket.create_connection((host,int(port)),timeout=3) as s:
    q={'version':'postfiat-local-rpc-v1','id':'a666-r4-fire-control-route-current','method':method,'params':params}; s.sendall((json.dumps(q,separators=(',',':'))+'\n').encode()); v=json.loads(s.makefile('rb').readline())
   if not v.get('ok'): raise RuntimeError(method)
   vals.append(v['result'])
  status,supply=vals; rows.append(status.get('block_height')==expected_tuple['height'] and status.get('block_tip_hash')==expected_tip and status.get('state_root')==expected_root and supply.get('route_id')==route.get('route_id') and supply.get('route_epoch')==2 and supply.get('policy_epoch')==2 and supply.get('live_value_enabled') is True and supply.get('paused') is False and supply.get('invariant_holds') is True and supply.get('route_config_digest')==route.get('route_config_digest') and supply.get('policy_hash')==route.get('policy_hash'))
except Exception: rows=[]
print(json.dumps({'ok':base and len(rows)==6 and all(rows),'queried_endpoint_count':len(rows),'base_evidence_valid':base}))
PY
}

stakehub_inventory_validation() {
    local active="$1"
    jq -cn --argjson active "$active" --argjson doc "$(cat "$stakehub_inventory")" '
      {ok:(
        $doc.schema == "postfiat.a666.r4.stakehub-restart-inventory.v1" and $doc.inventory_only == true and $doc.mutations_executed == 0
        and $doc.dashboard_currently_active == true and $doc.official_absence_proof == false and $doc.restart_verified_after_run == false
        and $doc.active_unit_count == 1 and $doc.active_unit_names == ["stakehub-private-swap-dashboard.service"] and $active == $doc.active_unit_names
        and ([$doc.observed_units[] | select(.restart_target == true)] | length == 1) and ([$doc.observed_units[] | select(.restart_target == true)][0].name == "stakehub-private-swap-dashboard.service")
        and ([$doc.observed_units[] | select(.active_state == "active") | .name] == $doc.active_unit_names)
      )}'
}

stakehub_official_absence_validation() {
    local inventory_sha mode
    inventory_sha=$(sha256sum "$stakehub_inventory" | awk '{print $1}'); mode=$(stat -c '%a' "$stakehub_absence")
    jq -cn --arg sha "$inventory_sha" --arg mode "$mode" --argjson active "$stakehub_active_units" --argjson doc "$(cat "$stakehub_absence")" '
      {ok:(
        $mode == "600" and $doc.schema == "postfiat.a666.r4.stakehub-official-absence.v1" and $doc.inventory_sha256 == $sha
        and $doc.before_active_count == 1 and $doc.before_active_names == ["stakehub-private-swap-dashboard.service"]
        and $doc.mutation_count == 1 and $doc.mutations == ["systemctl --user stop stakehub-private-swap-dashboard.service"] and $doc.after_active_count == 0 and $doc.after_active_names == []
        and $doc.official_absence_proof == true and $doc.restart_required == true and $doc.restart_verified_after_run == false
        and $doc.funds_actions == 0 and $doc.data_actions == 0 and $doc.keys_actions == 0 and $doc.config_actions == 0 and $doc.software_actions == 0 and $active == []
      )}'
}

dependencies_evidence_validation_for_file() {
    local path="$1"
    local actual_sha
    [[ -r "$path" ]] || { jq -cn '{ok:false}'; return; }
    actual_sha=$(sha256sum "$path" | awk '{print $1}')
    jq -cn --arg sha "$actual_sha" --argjson d "$(cat "$path")" '
      {ok:(
       $sha == "f9414e57edd7ff28e1acc38a7e1de3146287a85ca2f59b63d9f74438946ff50e"
       and $d.schema == "postfiat.a666.r4.private-swap-dependencies-refresh.v2" and $d.candidate.revision == "39f7fae3191aa34c376ae1657650a9ec2444f421"
       and $d.bindings.preserved_root == "/tmp/postfiat-atomic-swap-local-six-1848893-1785831355561267349" and $d.bindings.fleet.commit == "ee23d58822e89df5a24a10ecea42ed0bd985653a"
       and $d.bindings.route_current_state.sha256 == "10886b11920e07e08a8caa9eaeebf1e9f7b400336cb14949e963953715421714" and $d.expected_fleet_tuple.height == 833 and $d.expected_fleet_tuple.tip == "569d64e178273b0bff2c935afaef9fea7ba94d04c2af3b7f0611ec9743a6197e8864364ba435aa5ee21b8c61d3fc12aa" and $d.expected_fleet_tuple.state_root == "e06949b6066150d2b7703bffec3f0e091cc617922452e19a0933df0c728e23060b91dfbfa1d521634f5809ecc2315d89"
       and $d.route.route_epoch == 2 and $d.route.policy_epoch == 2 and $d.route.live_value_enabled == true and $d.route.paused == false and $d.route.invariant_holds == true
       and $d.ready == true and $d.state == "ready" and $d.business_operations == 0 and $d.stakehub_interaction == false and $d.live_chain == false
       and $d.supervisor.systemd_unit == "a666-r4-private-swap-dependencies-pathb-v3.service" and $d.supervisor.live == true
       and $d.asset_service.endpoint == "127.0.0.1:8799" and $d.asset_service.ready == true and $d.certified_round_driver.local_height == 833 and $d.certified_round_driver.start_height == 834 and $d.certified_round_driver.next_height == 834 and $d.certified_round_driver.authenticated_peer_count == 5 and $d.certified_round_driver.authenticated_quorum == true and $d.certified_round_driver.processed_round_count == 0
       and $d.checks.empty_batch_and_processed_dirs == true
      )}'
}

dependencies_runtime_validation() {
    local d="$dependencies" supervisor asset round heartbeat now
    jq -e '.ok == true' <<<"$(dependencies_evidence_validation_for_file "$d")" >/dev/null || { jq -cn '{ok:false}'; return; }
    supervisor=$(jq -r '.supervisor.pid' "$d"); asset=$(jq -r '.asset_service.pid' "$d"); round=$(jq -r '.certified_round_driver.pid' "$d")
    systemctl --user is-active a666-r4-private-swap-dependencies-pathb-v3.service >/dev/null 2>&1 || { jq -cn '{ok:false}'; return; }
    [[ "$(systemctl --user show a666-r4-private-swap-dependencies-pathb-v3.service -p ActiveState -p SubState --value)" == $'active\nrunning' ]] || { jq -cn '{ok:false}'; return; }
    kill -0 "$supervisor" && kill -0 "$asset" && kill -0 "$round" && ss -ltn | grep -q '127.0.0.1:8799' || { jq -cn '{ok:false}'; return; }
    jq -e '.schema == "postfiat-transport-peer-certified-batch-loop-ready-v2" and .local_state.block_height == 833 and .start_height == 834 and .local_state.block_tip_hash == "569d64e178273b0bff2c935afaef9fea7ba94d04c2af3b7f0611ec9743a6197e8864364ba435aa5ee21b8c61d3fc12aa" and .authenticated_peer_count == 5 and .authenticated_quorum == true and .processed_round_count == 0' "$(jq -r '.certified_round_driver.ready_file' "$d")" >/dev/null || { jq -cn '{ok:false}'; return; }
    [[ -s "$(jq -r '.asset_service.ready_file' "$d")" ]] && [[ -z "$(find "$(jq -r '.paths.batch_outbox' "$d")" -mindepth 1 -print -quit)" ]] && [[ -z "$(find "$(jq -r '.paths.processed_batches' "$d")" -mindepth 1 -print -quit)" ]] || { jq -cn '{ok:false}'; return; }
    jq -cn '{ok:true}'
}

pftl_runtime_validation() {
    local d="$pftl_stage" sha supervisor daemon readiness
    sha=$(sha256sum "$d" | awk '{print $1}')
    jq -e --arg sha "$sha" '
      $sha == "cc3bd4903a41b1ef243285b93f4651bc603ca20d0cd4d26d137150c8ddce282b"
      and .schema == "postfiat.a666.r4.private-swap-stage.v2" and .candidate.revision == "39f7fae3191aa34c376ae1657650a9ec2444f421"
      and .bindings.preserved_root == "/tmp/postfiat-atomic-swap-local-six-1848893-1785831355561267349" and .bindings.route_current_state.sha256 == "10886b11920e07e08a8caa9eaeebf1e9f7b400336cb14949e963953715421714" and .bindings.dependency_evidence.sha256 == "f9414e57edd7ff28e1acc38a7e1de3146287a85ca2f59b63d9f74438946ff50e" and .bindings.witness_stage.witness_sha256 == "8c2c7ee6d3209bfb21e5d442de7e80cb2ab4affabe06a0008527717eaae13ef4"
      and .governed_identity.route_id == "pftl-a666-r4-offline-rehearsal-v1" and .governed_identity.route_epoch == 2 and .governed_identity.policy_epoch == 2 and .governed_identity.live_value_enabled == true and .governed_identity.paused == false and .governed_identity.invariant_holds == true
      and .ready == true and .state == "ready" and .submitted_private_operations == 0 and .live_chain == false and .stakehub_interaction == false and .credentials_included == false
      and .endpoint.url == "http://127.0.0.1:8798" and .endpoint.loopback_only == true and .endpoint.ready == true
    ' "$d" >/dev/null || { jq -cn '{ok:false}'; return; }
    supervisor=$(jq -r '.supervisor.pid' "$d"); daemon=$(jq -r '.endpoint.pid' "$d")
    systemctl --user is-active a666-r4-pftl-swapd-pathb-v3.service >/dev/null 2>&1 && [[ "$(systemctl --user show a666-r4-pftl-swapd-pathb-v3.service -p ActiveState -p SubState --value)" == $'active\nrunning' ]] && kill -0 "$supervisor" && kill -0 "$daemon" && ss -ltn | grep -q '127.0.0.1:8798' && ss -ltn | grep -q '127.0.0.1:8799' || { jq -cn '{ok:false}'; return; }
    readiness=$(curl --fail --silent --show-error --max-time 3 http://127.0.0.1:8798/v1/ready) || { jq -cn '{ok:false}'; return; }
    jq -e '.schema == "postfiat.pftl_swap.readiness.v1" and .ready == true and .local_only == true and .route_id == "pftl-a666-r4-offline-rehearsal-v1" and .controlled_wallet_id == "pfab9b9228942e5c529633a13aa271d5297bec6353" and .checks.asset_service.ok == true and .checks.asset_service.report.mirror.height == 833 and .checks.certified_round_driver.ok == true and .checks.certified_round_driver.local_height == 833 and .checks.certified_round_driver.next_round_height == 834 and .checks.certified_round_driver.authenticated_peer_count == 5' <<<"$readiness" >/dev/null || { jq -cn '{ok:false}'; return; }
    jq -cn '{ok:true}'
}

d_runner_validation() {
    local runner="${1:-$d_runner}" report="${2:-/tmp/a666-r4-d-preflight-LttxGK0X.json}" expected_sha="${3:-d7175635447ad52156a880eb198b45c030ca21ca1882e7e9db11dc406b425ca9}"
    [[ -r "$report" && "$(sha256sum "$report" | awk '{print $1}')" == "$expected_sha" ]] || { jq -cn '{ok:false}'; return; }
    jq -cn --argjson d "$(cat "$runner")" --argjson r "$(cat "$report")" '
      {ok:(
        $d.schema == "postfiat.a666.r4.journey-runner-dry-run.v1" and $d.candidate_revision == "39f7fae3191aa34c376ae1657650a9ec2444f421" and $d.dry_run == true and $d.official_pass == false
        and $d.execution.matched_tests == 1 and $d.execution.exit_code == 0 and $d.execution.passed_tests == 1 and $d.execution.failed_tests == 0
        and $d.business_operations == 0 and $d.business_mutations == 0 and $d.wallet_business_steps_executed == 0
        and $d.computed_checks.steps_1_6_9_10_dry_run == true and $d.computed_checks.async_proof_slot_steps_7_8 == true and $d.computed_checks.loopback_only == true and $d.computed_checks.no_live_chain == true and $d.computed_checks.zero_business_mutations == true
        and ([$d.step_readiness[] | select(.step != 7 and .step != 8) | (.ready == true and .executed == false)] | all)
        and $r.schema == "postfiat.a666.r4.offline-ethereum-browser-preflight.v1" and $r.mode == "preflight_only" and $r.official_pass == false and $r.business_mutations == 0 and $r.wallet_business_steps_executed == 0
        and ([$r.step_readiness[] | select(.step != 7 and .step != 8) | (.ready == true and .executed == false)] | all)
        and $r.computed_checks.steps_1_6_9_10_dry_run == true and $r.computed_checks.async_proof_slot_steps_7_8 == true and $r.computed_checks.loopback_only == true and $r.computed_checks.no_live_chain == true and $r.computed_checks.zero_business_mutations == true
        and $r.async_proof_slot.accepted == true and $r.async_proof_slot.checks.inline_proving_forbidden == true and $r.async_proof_slot.checks.prover_invocations_zero == true
      )}'
}

return_slot_validation() {
    local path="$return_artifact_slot" artifact actual export_receipt
    [[ -r "$path" ]] || { jq -cn '{ok:false,reason:"return_slot_unreadable"}'; return; }
    artifact=$(jq -r '.artifact_path // empty' "$path")
    [[ -n "$artifact" && -r "$artifact" ]] || { jq -cn '{ok:false,reason:"return_artifact_unreadable"}'; return; }
    actual=$(sha256sum "$artifact" | awk '{print $1}')
    export_receipt=$(jq -r '.receipt_identity // empty' "$export_artifact_slot")
    jq -cn --arg actual "$actual" --arg export_receipt "$export_receipt" --argjson slot "$(cat "$path")" '
      {ok:(
        $slot.schema == "postfiat.a666.r4.return-artifact-slot.v1"
        and $slot.status == "accepted" and $slot.ok == true and $slot.accepted == true
        and ($slot.run_id | type == "string" and length > 0)
        and ($slot.artifact_sha256 | type == "string" and test("^[0-9a-f]{64}$") and . == $actual)
        and ($slot.receipt_identity | type == "string" and length > 0 and . != $export_receipt)
        and $slot.observed_chain_state.height == 833 and $slot.observed_chain_state.finalized == true
        and ($slot.observed_chain_state.tip | type == "string" and test("^[0-9a-f]{96}$"))
        and ($slot.observed_chain_state.state_root | type == "string" and test("^[0-9a-f]{96}$"))
        and $slot.conservation.equal == true and $slot.conservation.invariant_holds == true
        and $slot.live_chain == false and $slot.stakehub_interaction == false and $slot.business_mutations == 0
      )}'
}

setup_wallet_identity_validation() {
    local candidate="$path_b_candidate" package_blob package_sha package_version
    package_blob=$(git rev-parse "$candidate:wallet-web/package.json" 2>/dev/null || true)
    package_sha=$(git show "$candidate:wallet-web/package.json" 2>/dev/null | sha256sum | awk '{print $1}')
    package_version=$(git show "$candidate:wallet-web/package.json" 2>/dev/null | jq -r '.version // empty')
    jq -cn --arg candidate "$candidate" --arg blob "$package_blob" --arg sha "$package_sha" --arg version "$package_version" --argjson setup "$(cat "$setup_manifest")" '
      {
        expected:{candidate_revision:$candidate,git_object:$blob,package_json_sha256:$sha,package_version:$version},
        observed:{
          candidate_revision:($setup.candidate.revision // null),
          package_json_sha256:($setup.wallet.package_json_sha256 // $setup.wallet_package_json_sha256 // null),
          package_version:($setup.wallet.package_version // $setup.wallet_package_version // null)
        },
        ok:(
          ($blob | test("^[0-9a-f]{40}$"))
          and ($sha | test("^[0-9a-f]{64}$"))
          and ($version | test("^\\d+\\.\\d+\\.\\d+$"))
          and $setup.schema == "postfiat.a666.r4.construction-setup-endpoints.v1"
          and $setup.candidate.revision == $candidate and $setup.candidate.revision_exact == true and $setup.candidate.tracked_clean == true
          and ($setup.wallet.package_version // $setup.wallet_package_version) == $version
          and (($setup.wallet.package_json_sha256 // $setup.wallet_package_json_sha256) | ascii_downcase) == $sha
          and $setup.wallet.loopback == true and $setup.wallet.reachable == true and $setup.wallet.http_status == 200
          and $setup.business_mutations == 0 and $setup.official_pass == false
        )
      }'
}

official_input_contract_enforcement_validation() {
    local targets="$1"
    python3 - "$official_input_contract" "$official_input_extractor" "$repo" "$targets" <<'PY'
import hashlib, json, subprocess, sys
from pathlib import Path

contract_path, extractor, repo = map(Path, sys.argv[1:4])
targets = json.loads(sys.argv[4])
raw = contract_path.read_bytes()
contract = json.loads(raw)
entries = contract.get("accessors", [])
check = subprocess.run([str(extractor), "check"], cwd=repo, text=True, capture_output=True)
try:
    extracted = json.loads(check.stdout)
except json.JSONDecodeError:
    extracted = {"ok": False, "accessor_count": 0, "mismatch_count": None}
runtime_kinds = {"runtime_observe", "runtime_slot_read"}
valid_required = {"always", "official_only", "optional_defaults_construction_refused_full", "optional_mode_flag", "preflight_only"}
table, invalid, unmapped = [], [], []
ids = set()
for entry in entries:
    accessor_id = entry.get("id")
    kind = entry.get("access_kind")
    target = entry.get("fire_control_target")
    runtime = kind in runtime_kinds
    enforcement = entry.get("enforcement") if isinstance(entry.get("enforcement"), dict) else {}
    expected_class = "runtime_derived" if runtime else "prelaunch_external"
    target_known = isinstance(target, str) and target in targets
    target_ok = bool(targets.get(target, False)) if target_known else False
    predicate = entry.get("validation_predicate")
    producer = enforcement.get("producer_binding")
    class_ok = enforcement.get("input_class") == expected_class
    producer_ok = (isinstance(producer, str) and producer.startswith("runner:")) if runtime else (isinstance(producer, str) and producer.startswith("fire_control:"))
    shape_ok = (
        isinstance(accessor_id, str) and bool(accessor_id) and accessor_id not in ids
        and kind in {"env", "manifest_field", "slot_field", "slot_state", "runtime_slot_read", "runtime_observe", "file_read", "endpoint_read"}
        and entry.get("required") in valid_required
        and isinstance(predicate, str) and bool(predicate)
        and target_known and enforcement.get("validation_target") == target
        and class_ok and producer_ok and entry.get("currently_enforced_in_fire_control") is True
    )
    ids.add(accessor_id)
    validation_result = bool(shape_ok and target_ok)
    observed = {
        "classification": expected_class,
        "target_present": target_known,
        "target_ok_now": target_ok,
        "producer_bound": producer_ok,
    }
    row = {
        "accessor_id": accessor_id,
        "source": entry.get("source"),
        "required_condition": predicate,
        "observed_bound_status": observed,
        "validation_result": validation_result,
        "consuming_steps": entry.get("consuming_steps"),
        "fire_control_predicate": target,
    }
    table.append(row)
    if not target_known:
        unmapped.append(accessor_id)
    if not validation_result:
        invalid.append(accessor_id)
contract_hash = hashlib.sha256(raw).hexdigest()
result = {
    "ok": (
        check.returncode == 0 and extracted.get("ok") is True
        and extracted.get("accessor_count") == 120 and extracted.get("mismatch_count") == 0
        and len(entries) == 120 and len(table) == 120
        and len(ids) == 120 and not invalid and not unmapped
    ),
    "contract_sha256": contract_hash,
    "accessor_count": len(entries),
    "extractor": {
        "ok": check.returncode == 0 and extracted.get("ok") is True,
        "accessor_count": extracted.get("accessor_count"),
        "mismatch_count": extracted.get("mismatch_count"),
    },
    "enforced_count": sum(1 for row in table if row["validation_result"]),
    "invalid_count": len(invalid),
    "unmapped_count": len(unmapped),
    "invalid_accessor_ids": invalid,
    "unmapped_accessor_ids": unmapped,
    "counts_by_access_kind": {
        kind: sum(1 for entry in entries if entry.get("access_kind") == kind)
        for kind in sorted({entry.get("access_kind") for entry in entries})
    },
    "counts_by_step": {
        str(step): sum(1 for entry in entries if step in entry.get("consuming_steps", []))
        for step in sorted({step for entry in entries for step in entry.get("consuming_steps", [])}, key=str)
    },
    "table": table,
}
print(json.dumps(result, separators=(",", ":")))
PY
}

