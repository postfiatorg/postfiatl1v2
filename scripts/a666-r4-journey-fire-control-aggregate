v3_async_validation() {
    jq -cn --arg run "a666-r4-receipt-prover-pathb-20260804-v3" \
      --argjson s "$(cat "$async_proof_slot")" --argjson e "$(cat "$export_artifact_slot")" --argjson t "$(cat "$refire_terminal")" --argjson a "$(cat "$b_acceptance")" '
