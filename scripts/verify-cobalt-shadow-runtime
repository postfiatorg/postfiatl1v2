#!/usr/bin/env bash
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
cd "$root"

output_dir=${1:-".tih/cobalt-shadow-runtime-$(date -u +%Y%m%dT%H%M%SZ)"}
if [ -e "$output_dir" ]; then
    echo "output directory already exists: $output_dir" >&2
    exit 2
fi
mkdir -p "$output_dir"

zig_bin=${POSTFIAT_ZIG:-/home/postfiatchad/.local/zig-0.17.0-dev.1857/zig}
if [ ! -x "$zig_bin" ]; then
    echo "POSTFIAT_ZIG must name an executable pinned Zig binary" >&2
    exit 2
fi
export POSTFIAT_ZIG="$zig_bin"
export CC="$root/scripts/zig-cc"
export AR="$root/scripts/zig-ar"
export CARGO_TARGET_X86_64_UNKNOWN_LINUX_GNU_LINKER="$root/scripts/zig-cc"

cargo fmt --all -- --check >"$output_dir/fmt.log" 2>&1
cargo test -p postfiat-node --lib cobalt_shadow --locked -- --nocapture     >"$output_dir/rust-tests.log" 2>&1
cargo clippy -p postfiat-node --lib --bin postfiat-cobalt-shadow --locked --     -D warnings >"$output_dir/clippy.log" 2>&1
PYTHONPATH=python python3 -m unittest python.tests.test_cobalt python.tests.test_cobalt_ui -v     >"$output_dir/python-tests.log" 2>&1
PYTHONPATH=python python3 -m postfiat_rpc.cobalt --help     >"$output_dir/python-cli-help.txt"
cargo run --quiet --locked -p postfiat-node --bin postfiat-cobalt-shadow -- help     >"$output_dir/rust-cli-help.txt"
cargo run --quiet --locked -p postfiat-node --bin postfiat-cobalt-shadow --     network-drill --data-dir "$output_dir/network-state"     >"$output_dir/network-drill.json"

probe_port=$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1]); s.close()')
target/debug/postfiat-cobalt-shadow run --data-dir "$output_dir/network-state/validator-0" --listen "127.0.0.1:$probe_port" >"$output_dir/listener.log" 2>&1 &
listener_pid=$!
cleanup_listener() {
    kill "$listener_pid" 2>/dev/null || true
    wait "$listener_pid" 2>/dev/null || true
}
trap cleanup_listener EXIT
python3 - "$probe_port" <<'PY'
import socket
import sys
import time

port = int(sys.argv[1])
for _ in range(100):
    try:
        with socket.create_connection(("127.0.0.1", port), timeout=0.1):
            break
    except OSError:
        time.sleep(0.05)
else:
    raise SystemExit("Rust shadow listener did not become reachable")
PY
PYTHONPATH=python python3 -m postfiat_rpc.cobalt --json --endpoint "127.0.0.1:$probe_port" probe >"$output_dir/python-probe.json"
PYTHONPATH=python python3 -m postfiat_rpc.cobalt --json --endpoint "127.0.0.1:$probe_port" snapshot >"$output_dir/python-snapshot.json"
PYTHONPATH=python python3 -m postfiat_rpc.cobalt --json --endpoint "127.0.0.1:$probe_port" replay >"$output_dir/python-replay.json"
PYTHONPATH=python python3 -m postfiat_rpc.cobalt --json --endpoint "127.0.0.1:$probe_port" --start-sequence 1 --limit 1 history-export >"$output_dir/python-history-export.json"
cleanup_listener
trap - EXIT

python3 - "$output_dir" <<'PY'
import hashlib
import json
import pathlib
import sys

output = pathlib.Path(sys.argv[1])
report = json.loads((output / "network-drill.json").read_text())
required_true = [
    "ok",
    "converged",
    "restart_equivalent",
    "tampered_signature_rejected",
    "oversized_frame_rejected",
    "live_authority_remained_disabled",
]
for field in required_true:
    if report.get(field) is not True:
        raise SystemExit(f"network drill field is not true: {field}")
if report.get("socket_count") != 3:
    raise SystemExit("network drill did not use three sockets")
if report.get("signed_message_count", 0) < 25:
    raise SystemExit("network drill did not validate the complete signed stage set")
for probe in report.get("probes", []):
    if probe.get("live_authority") is not False:
        raise SystemExit("probe claimed live authority")
    if probe.get("controls_block_consensus") is not False:
        raise SystemExit("probe claimed block-consensus control")
    if probe.get("peer_health") != "healthy":
        raise SystemExit("probe peer health is not healthy")
    if probe.get("replay_posture") != "consistent":
        raise SystemExit("probe replay posture is inconsistent")
    if probe.get("catch_up_status") != "current":
        raise SystemExit("probe catch-up posture is not current")
    if probe.get("contiguous_sequence") != 1:
        raise SystemExit("probe did not expose one contiguous history entry")
    if probe.get("certificate_signer_count") != 3:
        raise SystemExit("probe certificate signer count mismatch")
for name in ["python-probe.json", "python-snapshot.json", "python-replay.json", "python-history-export.json"]:
    cli = json.loads((output / name).read_text())
    if cli.get("ok") is not True:
        raise SystemExit(f"Python CLI command failed: {name}")
    if cli.get("authority", {}).get("live") is not False:
        raise SystemExit(f"Python CLI claimed live authority: {name}")

source_files = [
    "crates/node/src/cobalt_shadow.rs",
    "crates/node/src/cobalt_shadow_runtime.rs",
    "crates/node/src/bin/postfiat_cobalt_shadow.rs",
    "crates/node/src/lib.rs",
    "python/postfiat_rpc/cobalt.py",
    "python/postfiat_rpc/cobalt_ui.py",
    "python/postfiat_rpc/cobalt_ui_assets/app.js",
    "python/tests/test_cobalt.py",
    "python/tests/test_cobalt_ui.py",
    "systemd/postfiat-cobalt-shadow.service.example",
    "scripts/verify-cobalt-shadow-runtime",
]
digest = hashlib.sha256()
for name in source_files:
    path = pathlib.Path(name)
    digest.update(name.encode())
    digest.update(b"\0")
    digest.update(path.read_bytes())
    digest.update(b"\0")
classification = {
    "schema": "postfiat-cobalt-shadow-verification-v2",
    "status": "passed",
    "scope": "local-loopback-sockets",
    "local_simulation_only": True,
    "live_validator_evidence": False,
    "live_authority": False,
    "controls_block_consensus": False,
    "source_sha256": digest.hexdigest(),
    "task_id": "task_84c0561295204bcf5e7c389475e5fcdc",
}
(output / "classification.json").write_text(
    json.dumps(classification, indent=2, sort_keys=True) + "\n"
)
files = sorted(
    path
    for path in output.iterdir()
    if path.is_file() and path.name != "SHA256SUMS"
)
with (output / "SHA256SUMS").open("w") as sums:
    for path in files:
        sums.write(f"{hashlib.sha256(path.read_bytes()).hexdigest()}  {path.name}\n")
manifest_hash = hashlib.sha256((output / "SHA256SUMS").read_bytes()).hexdigest()
print(f"status=passed")
print(f"scope=local-loopback-sockets")
print(f"live_validator_evidence=false")
print(f"source_sha256={classification['source_sha256']}")
print(f"manifest_sha256={manifest_hash}")
print(f"socket_count={report['socket_count']}")
print(f"signed_message_count={report['signed_message_count']}")
print(f"ratification_id={report['ratification_id']}")
PY
