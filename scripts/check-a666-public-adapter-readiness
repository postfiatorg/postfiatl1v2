#!/usr/bin/env python3
"""Reject inaccurate StakeHub-deprecation claims for A666."""

from __future__ import annotations

import json
import pathlib


ROOT = pathlib.Path(__file__).resolve().parents[1]
READINESS = ROOT / "docs/status/A666-PUBLIC-ADAPTER-READINESS-20260802.json"
PLAN = ROOT / (
    "docs/plans/"
    "STAKEHUB-DECOUPLING-AND-OPEN-RESERVE-PROOF-INFRASTRUCTURE-PLAN-20260801.md"
)
RETIRED_HANDOFF = ROOT / (
    "docs/handoffs/"
    "STAKEHUB-DECOUPLING-CONTINUATION-HANDOFF-20260802.md"
)
REQUIRED = {
    "aave-arbitrum",
    "evm-spot",
    "hyperliquid",
    "staked-near",
    "staked-solana",
    "xmr-reserve",
}


def fail(message: str) -> None:
    raise SystemExit(f"a666 public-adapter readiness: {message}")


def validate_deprecation_state(*, deprecated: bool, all_qualified: bool, plan: str) -> None:
    """Keep adapter qualification distinct from complete StakeHub deprecation."""
    if deprecated and not all_qualified:
        fail("StakeHub cannot be marked deprecated before all six adapters are qualified")
    if deprecated:
        for gate in range(8):
            marker = f"| `G{gate}`"
            rows = [line for line in plan.splitlines() if line.startswith(marker)]
            if len(rows) != 1 or "| PASS |" not in rows[0]:
                fail(
                    "StakeHub cannot be marked deprecated until the canonical plan "
                    f"records a passing G{gate}"
                )


def main() -> None:
    if RETIRED_HANDOFF.exists():
        fail("retired continuation handoff must remain deleted; update the canonical plan")
    architecture_documents = sorted(
        path
        for directory in (ROOT / "docs/plans", ROOT / "docs/handoffs")
        for path in directory.glob("*STAKEHUB*DECOUPLING*.md")
    )
    if architecture_documents != [PLAN]:
        fail("exactly one StakeHub-deprecation Markdown must exist: the canonical plan")

    document = json.loads(READINESS.read_text(encoding="utf-8"))
    if document.get("schema") != "postfiat-a666-public-adapter-readiness-v1":
        fail("schema mismatch")
    if document.get("nav_asset") != "A666":
        fail("NAV asset must be A666")

    entries = document.get("required_adapters")
    if not isinstance(entries, list):
        fail("required_adapters must be a list")
    by_id = {entry.get("id"): entry for entry in entries}
    if set(by_id) != REQUIRED or len(entries) != len(REQUIRED):
        fail("required adapter set must be exact and duplicate-free")

    allowed_statuses = {"missing", "partial", "implemented", "qualified"}
    for adapter_id, entry in by_id.items():
        status = entry.get("status")
        qualified = entry.get("production_qualified")
        implementation = entry.get("public_implementation")
        if status not in allowed_statuses:
            fail(f"{adapter_id}: invalid status")
        if not isinstance(qualified, bool):
            fail(f"{adapter_id}: production_qualified must be boolean")
        if qualified != (status == "qualified"):
            fail(f"{adapter_id}: qualified status/boolean mismatch")
        if status in {"implemented", "qualified"}:
            if not isinstance(implementation, str) or not implementation:
                fail(f"{adapter_id}: public implementation is required")
            path = ROOT / implementation
            if not path.is_file():
                fail(f"{adapter_id}: public implementation does not exist")
        if status == "missing" and implementation is not None:
            fail(f"{adapter_id}: missing adapter cannot name an implementation")
        if not isinstance(entry.get("note"), str) or not entry["note"].strip():
            fail(f"{adapter_id}: an accurate note is required")

    all_qualified = all(entry["production_qualified"] for entry in entries)
    deprecated = document.get("stakehub_deprecated")
    if not isinstance(deprecated, bool):
        fail("stakehub_deprecated must be boolean")
    plan = PLAN.read_text(encoding="utf-8")
    if "**Sole authoritative Markdown:** this file" not in plan:
        fail("canonical plan does not declare the single-document rule")
    validate_deprecation_state(
        deprecated=deprecated,
        all_qualified=all_qualified,
        plan=plan,
    )
    if not deprecated:
        required_markers = (
            "**Status:** **INCOMPLETE — StakeHub is not deprecated",
            "| `G3` Public A666 adapters",
            "| **FAIL/OPEN** |",
            "StakeHub is not deprecated.",
        )
        for marker in required_markers:
            if marker not in plan:
                fail(f"canonical plan is missing incomplete-state marker: {marker}")

    print(
        "a666_public_adapter_readiness=ok "
        f"qualified={sum(entry['production_qualified'] for entry in entries)}/"
        f"{len(entries)} stakehub_deprecated={str(deprecated).lower()}"
    )


if __name__ == "__main__":
    main()
