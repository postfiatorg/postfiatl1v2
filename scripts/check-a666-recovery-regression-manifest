#!/usr/bin/env python3
"""Validate and optionally execute the A666 recovery regression manifest."""

from __future__ import annotations

import argparse
import json
import os
import re
import shlex
import subprocess
import sys
import time
from pathlib import Path
from typing import Any

SCHEMA = "postfiat.a666.recovery.regression_manifest.v1"
REQUIRED_AR_IDS = {f"AR-{index:02d}" for index in range(1, 12)}
REQUIRED_BROWSER_REGRESSION_IDS = {
    "R4-STEP10-DOWNLOAD",
    "R4-RECOVERED-RECEIPT",
    "R4-SELF-CUSTODY-TRUSTLINES",
}
REQUIRED_WALLET_UNIT_REGRESSIONS = {
    "R4-ROUTE-LIVE-FILTER": {
        "source_file": "wallet-web/src/lib/navcoin-markets.test.js",
        "test_name": "governed NAVCoin markets consume only route_live registry rows",
    },
}
COMMIT_RE = re.compile(r"^[0-9a-f]{40}$")
RUNNING_RE = re.compile(r"^running (\d+) tests?$", re.MULTILINE)
RESULT_RE = re.compile(
    r"^test result: ok\. (\d+) passed; (\d+) failed; .*?finished in ([0-9.]+)s$",
    re.MULTILINE,
)
NODE_TESTS_RE = re.compile(r"^# tests (\d+)$", re.MULTILINE)
NODE_PASS_RE = re.compile(r"^# pass (\d+)$", re.MULTILINE)
NODE_FAIL_RE = re.compile(r"^# fail (\d+)$", re.MULTILINE)
NODE_TODO_RE = re.compile(r"^# todo (\d+)$", re.MULTILINE)


class ManifestError(RuntimeError):
    pass


def require(condition: bool, message: str) -> None:
    if not condition:
        raise ManifestError(message)


def load_manifest(path: Path) -> dict[str, Any]:
    try:
        payload = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ManifestError(f"{path}: cannot load JSON: {error}") from error
    require(isinstance(payload, dict), f"{path}: root must be an object")
    return payload


def evidence_paths(entry: dict[str, Any]) -> list[str]:
    evidence = entry.get("evidence")
    if isinstance(evidence, str):
        return [evidence]
    if isinstance(evidence, list) and all(isinstance(item, str) for item in evidence):
        return evidence
    raise ManifestError(f"{entry.get('id')}: evidence must be a path or path list")


def validate_manifest(repo: Path, manifest: dict[str, Any]) -> list[dict[str, Any]]:
    require(manifest.get("schema") == SCHEMA, f"schema must be {SCHEMA}")
    require(manifest.get("status") == "complete", "manifest status must be complete")
    require(manifest.get("remaining_acceptance_work") == [],
            "remaining_acceptance_work must be empty")

    policy = manifest.get("invocation_policy")
    require(isinstance(policy, dict), "invocation_policy must be an object")
    maximum_ms = policy.get("maximum_runtime_milliseconds")
    require(isinstance(maximum_ms, int) and 0 < maximum_ms <= 120_000,
            "maximum_runtime_milliseconds must be in 1..120000")
    require(policy.get("minimum_matched_test_count") == 1,
            "minimum_matched_test_count must equal 1")
    require(policy.get("zero_match_with_exit_zero_is_failure") is True,
            "zero-match exit-zero policy must fail closed")

    stakehub_scope = manifest.get("stakehub_scope_constraint")
    require(isinstance(stakehub_scope, dict),
            "stakehub_scope_constraint must be an object")
    for field in (
        "authority_deprecation_only",
        "delete_decommission_uninstall_prohibited",
        "funds_balances_keys_data_untouched",
        "r4_temporary_unit_stop_allowed",
        "r4_teardown_restart_required",
        "r4_restart_unit_count_must_match_inventory",
        "actions_beyond_unit_start_stop_require_sauron",
    ):
        require(stakehub_scope.get(field) is True,
                f"stakehub scope constraint {field} must be true")
    require(stakehub_scope.get("ci_identifier_scope")
            == "layer1v2 public runtime paths only; external StakeHub tooling is excluded",
            "StakeHub identifier CI scope must remain limited to L1v2 runtime")

    successor = manifest.get("successor_candidate_qualification")
    require(isinstance(successor, dict),
            "successor_candidate_qualification must be an object")
    require(successor.get("status") == "passed",
            "successor candidate qualification must be passed")
    require(COMMIT_RE.fullmatch(str(successor.get("candidate_revision", ""))) is not None,
            "successor candidate revision must be a 40-character lowercase SHA")
    successor_evidence = successor.get("evidence")
    require(isinstance(successor_evidence, str) and (repo / successor_evidence).is_file(),
            "successor candidate qualification evidence must exist")
    require(successor.get("rust_standalone_tests") == 26,
            "successor candidate must rerun exactly 26 Rust tests")
    require(successor.get("wallet_unit_tests") == 233,
            "successor candidate wallet unit count must be 233")
    require(successor.get("custody_browser_tests") == 1,
            "successor candidate custody browser count must be 1")
    require(successor.get("public_browser_tests") == 3,
            "successor candidate public browser count must be 3")
    require(successor.get("exact_step_9_tests") == 1,
            "successor candidate exact step-9 count must be 1")

    defects = manifest.get("observed_defect_classes")
    require(isinstance(defects, list) and len(defects) == 13,
            "exactly thirteen observed defect classes are required")
    defect_ids = [item.get("id") for item in defects if isinstance(item, dict)]
    require(len(defect_ids) == len(set(defect_ids)) == 13,
            "observed defect IDs must be unique")

    regressions = manifest.get("regressions")
    require(isinstance(regressions, list), "regressions must be an array")
    rows: dict[str, dict[str, Any]] = {}
    for row in regressions:
        require(isinstance(row, dict), "every regression row must be an object")
        ar_id = row.get("id")
        require(isinstance(ar_id, str) and ar_id not in rows,
                f"duplicate or invalid regression id: {ar_id!r}")
        rows[ar_id] = row

    missing = sorted(REQUIRED_AR_IDS - rows.keys())
    unexpected = sorted(rows.keys() - REQUIRED_AR_IDS)
    require(not missing, f"missing regression rows: {', '.join(missing)}")
    require(not unexpected, f"unexpected regression rows: {', '.join(unexpected)}")

    browser_regressions = manifest.get("browser_regressions")
    require(isinstance(browser_regressions, list),
            "browser_regressions must be an array")
    browser_rows: dict[str, dict[str, Any]] = {}
    for row in browser_regressions:
        require(isinstance(row, dict),
                "every browser regression row must be an object")
        regression_id = row.get("id")
        require(isinstance(regression_id, str) and regression_id not in browser_rows,
                f"duplicate or invalid browser regression id: {regression_id!r}")
        browser_rows[regression_id] = row
    missing_browser = sorted(REQUIRED_BROWSER_REGRESSION_IDS - browser_rows.keys())
    unexpected_browser = sorted(browser_rows.keys() - REQUIRED_BROWSER_REGRESSION_IDS)
    require(not missing_browser,
            f"missing browser regression rows: {', '.join(missing_browser)}")
    require(not unexpected_browser,
            f"unexpected browser regression rows: {', '.join(unexpected_browser)}")

    wallet_unit_regressions = manifest.get("wallet_unit_regressions")
    require(isinstance(wallet_unit_regressions, list),
            "wallet_unit_regressions must be an array")
    wallet_unit_rows: dict[str, dict[str, Any]] = {}
    for row in wallet_unit_regressions:
        require(isinstance(row, dict),
                "every wallet unit regression row must be an object")
        regression_id = row.get("id")
        require(isinstance(regression_id, str) and regression_id not in wallet_unit_rows,
                f"duplicate or invalid wallet unit regression id: {regression_id!r}")
        wallet_unit_rows[regression_id] = row
    expected_wallet_unit_ids = set(REQUIRED_WALLET_UNIT_REGRESSIONS)
    missing_wallet_unit = sorted(expected_wallet_unit_ids - wallet_unit_rows.keys())
    unexpected_wallet_unit = sorted(wallet_unit_rows.keys() - expected_wallet_unit_ids)
    require(not missing_wallet_unit,
            f"missing wallet unit regression rows: {', '.join(missing_wallet_unit)}")
    require(not unexpected_wallet_unit,
            f"unexpected wallet unit regression rows: {', '.join(unexpected_wallet_unit)}")

    all_regression_ids = rows.keys() | browser_rows.keys() | wallet_unit_rows.keys()
    for defect in defects:
        require(defect.get("regression_status") == "passed",
                f"{defect.get('id')}: regression_status must be passed")
        mapped = defect.get("regression_ids")
        require(isinstance(mapped, list) and mapped,
                f"{defect.get('id')}: regression_ids must be non-empty")
        require(all(item in all_regression_ids for item in mapped),
                f"{defect.get('id')}: regression_ids reference a missing row")

    tests: list[dict[str, Any]] = []
    for ar_id in sorted(rows):
        row = rows[ar_id]
        require(row.get("status") == "passed", f"{ar_id}: status must be passed")
        require(COMMIT_RE.fullmatch(str(row.get("first_passing_commit", ""))) is not None,
                f"{ar_id}: first_passing_commit must be a 40-character lowercase SHA")

        source_values: list[str] = []
        if isinstance(row.get("source_file"), str):
            source_values.append(row["source_file"])
        if isinstance(row.get("source_files"), list):
            source_values.extend(row["source_files"])
        require(source_values, f"{ar_id}: source_file(s) are required")
        for source in source_values:
            require((repo / source).is_file(), f"{ar_id}: missing source file {source}")

        for evidence in evidence_paths(row):
            require((repo / evidence).is_file(), f"{ar_id}: missing evidence {evidence}")

        row_tests = row.get("tests")
        require(isinstance(row_tests, list) and row_tests,
                f"{ar_id}: at least one standalone test is required")
        for test in row_tests:
            require(isinstance(test, dict), f"{ar_id}: test entry must be an object")
            name = test.get("name")
            command = test.get("command")
            runtime_ms = test.get("runtime_milliseconds")
            matched = test.get("matched_test_count")
            require(isinstance(name, str) and name, f"{ar_id}: test name is required")
            require(isinstance(command, str) and command.startswith("cargo test "),
                    f"{ar_id}/{name}: command must be a cargo test invocation")
            require(name in command, f"{ar_id}/{name}: command must name the exact test")
            require(" -- --exact --nocapture" in command,
                    f"{ar_id}/{name}: command must use --exact --nocapture")
            require(isinstance(runtime_ms, int) and 0 <= runtime_ms < maximum_ms,
                    f"{ar_id}/{name}: recorded runtime exceeds the fast-loop budget")
            require(isinstance(matched, int) and matched >= 1,
                    f"{ar_id}/{name}: recorded matched-test count must be positive")
            tests.append({"regression_id": ar_id, "runner": "rust", **test})

    for regression_id in sorted(browser_rows):
        row = browser_rows[regression_id]
        require(row.get("status") == "passed",
                f"{regression_id}: status must be passed")
        require(COMMIT_RE.fullmatch(str(row.get("first_passing_commit", ""))) is not None,
                f"{regression_id}: first_passing_commit must be a 40-character lowercase SHA")
        root_cause = row.get("root_cause")
        require(isinstance(root_cause, str) and re.search(r":\d+", root_cause) is not None,
                f"{regression_id}: root_cause must contain a file:line anchor")
        sources = row.get("source_files")
        require(isinstance(sources, list) and sources,
                f"{regression_id}: source_files are required")
        for source in sources:
            require(isinstance(source, str) and (repo / source).is_file(),
                    f"{regression_id}: missing source file {source}")
        for evidence in evidence_paths(row):
            require((repo / evidence).is_file(),
                    f"{regression_id}: missing evidence {evidence}")
        row_tests = row.get("tests")
        require(isinstance(row_tests, list) and row_tests,
                f"{regression_id}: at least one browser test is required")
        for test in row_tests:
            require(isinstance(test, dict),
                    f"{regression_id}: test entry must be an object")
            name = test.get("name")
            command = test.get("command")
            working_directory = test.get("working_directory")
            runtime_ms = test.get("runtime_milliseconds")
            matched = test.get("matched_test_count")
            require(isinstance(name, str) and name,
                    f"{regression_id}: test name is required")
            require(command == "npm run test:public-browser",
                    f"{regression_id}/{name}: command must run the public browser suite")
            require(working_directory == "wallet-web"
                    and (repo / working_directory).is_dir(),
                    f"{regression_id}/{name}: working_directory must be wallet-web")
            require(isinstance(runtime_ms, int) and 0 <= runtime_ms < maximum_ms,
                    f"{regression_id}/{name}: recorded runtime exceeds the fast-loop budget")
            require(isinstance(matched, int) and matched >= 1,
                    f"{regression_id}/{name}: matched-test count must be positive")

    for regression_id in sorted(wallet_unit_rows):
        row = wallet_unit_rows[regression_id]
        expected = REQUIRED_WALLET_UNIT_REGRESSIONS[regression_id]
        require(row.get("status") == "passed",
                f"{regression_id}: status must be passed")
        require(COMMIT_RE.fullmatch(str(row.get("red_commit", ""))) is not None,
                f"{regression_id}: red_commit must be a 40-character lowercase SHA")
        require(COMMIT_RE.fullmatch(str(row.get("first_passing_commit", ""))) is not None,
                f"{regression_id}: first_passing_commit must be a 40-character lowercase SHA")
        require(row.get("source_file") == expected["source_file"]
                and (repo / expected["source_file"]).is_file(),
                f"{regression_id}: source_file must be {expected['source_file']}")
        root_cause = row.get("root_cause")
        require(isinstance(root_cause, str) and re.search(r":\d+", root_cause) is not None,
                f"{regression_id}: root_cause must contain a file:line anchor")
        for evidence in evidence_paths(row):
            require((repo / evidence).is_file(),
                    f"{regression_id}: missing evidence {evidence}")
        row_tests = row.get("tests")
        require(isinstance(row_tests, list) and len(row_tests) == 1,
                f"{regression_id}: exactly one wallet unit suite entry is required")
        test = row_tests[0]
        require(isinstance(test, dict),
                f"{regression_id}: test entry must be an object")
        name = test.get("name")
        command = test.get("command")
        working_directory = test.get("working_directory")
        runtime_ms = test.get("runtime_milliseconds")
        matched = test.get("matched_test_count")
        require(name == expected["test_name"],
                f"{regression_id}: named test must be {expected['test_name']}")
        require(command == "npm test",
                f"{regression_id}/{name}: command must run the wallet unit suite")
        require(working_directory == "wallet-web"
                and (repo / working_directory).is_dir(),
                f"{regression_id}/{name}: working_directory must be wallet-web")
        require(isinstance(runtime_ms, int) and 0 <= runtime_ms < maximum_ms,
                f"{regression_id}/{name}: recorded runtime exceeds the fast-loop budget")
        require(isinstance(matched, int) and matched >= 1,
                f"{regression_id}/{name}: matched-test count must be positive")
        tests.append({"regression_id": regression_id, "runner": "node_tap", **test})

    return tests


def run_tests(repo: Path, tests: list[dict[str, Any]], maximum_ms: int) -> None:
    for test in tests:
        label = f"{test['regression_id']}/{test['name']}"
        command = shlex.split(test["command"])
        working_directory = test.get("working_directory")
        cwd = repo / working_directory if isinstance(working_directory, str) else repo
        started = time.monotonic()
        try:
            environment = os.environ.copy()
            environment["CARGO_TERM_COLOR"] = "never"
            result = subprocess.run(
                command,
                cwd=cwd,
                env=environment,
                text=True,
                stdout=subprocess.PIPE,
                stderr=subprocess.STDOUT,
                timeout=maximum_ms / 1000,
                check=False,
            )
        except subprocess.TimeoutExpired as error:
            raise ManifestError(f"{label}: exceeded {maximum_ms}ms") from error
        elapsed_ms = round((time.monotonic() - started) * 1000)
        output = result.stdout or ""
        runner = test["runner"]
        if runner == "rust":
            running_counts = [int(value) for value in RUNNING_RE.findall(output)]
            results = [(int(passed), int(failed), float(seconds))
                       for passed, failed, seconds in RESULT_RE.findall(output)]
            matched = max(running_counts, default=0)
            passed = max((item[0] for item in results if item[1] == 0), default=0)
            failed = min((item[1] for item in results), default=1)
            todo = 0
        elif runner == "node_tap":
            matched = max((int(value) for value in NODE_TESTS_RE.findall(output)), default=0)
            passed = max((int(value) for value in NODE_PASS_RE.findall(output)), default=0)
            failed = max((int(value) for value in NODE_FAIL_RE.findall(output)), default=1)
            todo = max((int(value) for value in NODE_TODO_RE.findall(output)), default=1)
            require(test["name"] in output,
                    f"{label}: named wallet unit test was absent from npm test output")
        else:
            raise ManifestError(f"{label}: unsupported test runner {runner!r}")
        if result.returncode != 0 or matched < 1 or passed < 1 or failed != 0 or todo != 0:
            tail = "\n".join(output.splitlines()[-30:])
            raise ManifestError(
                f"{label}: exit={result.returncode} matched={matched} passed={passed} "
                f"failed={failed} todo={todo}\n{tail}"
            )
        require(elapsed_ms < maximum_ms,
                f"{label}: wall clock {elapsed_ms}ms exceeds {maximum_ms}ms")
        print(f"PASS {label} matched={matched} passed={passed} elapsed_ms={elapsed_ms}")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "--manifest",
        default="docs/evidence/a666-public-reserve-product-20260803/regressions/regression-manifest.json",
    )
    parser.add_argument("--run", action="store_true", help="execute every exact test command")
    args = parser.parse_args()

    repo = Path(__file__).resolve().parent.parent
    manifest_path = (repo / args.manifest).resolve()
    try:
        manifest = load_manifest(manifest_path)
        tests = validate_manifest(repo, manifest)
        if args.run:
            maximum_ms = manifest["invocation_policy"]["maximum_runtime_milliseconds"]
            run_tests(repo, tests, maximum_ms)
    except ManifestError as error:
        print(f"A666 recovery manifest FAIL: {error}", file=sys.stderr)
        return 1

    rust_test_count = sum(test["runner"] == "rust" for test in tests)
    print(
        f"A666 recovery manifest PASS: defects=13 regressions={len(REQUIRED_AR_IDS)} "
        f"browser_regressions={len(REQUIRED_BROWSER_REGRESSION_IDS)} "
        f"wallet_unit_regressions={len(REQUIRED_WALLET_UNIT_REGRESSIONS)} "
        f"standalone_tests={rust_test_count} run={str(args.run).lower()}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
