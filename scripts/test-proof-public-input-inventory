#!/usr/bin/env python3
"""Fail when proof source or its reviewed public-input inventory drifts."""

from __future__ import annotations

import hashlib
import json
import pathlib
import re


ROOT = pathlib.Path(__file__).resolve().parents[1]
INVENTORY = ROOT / "docs/status/OPEN-SOURCE-PROOF-PUBLIC-INPUT-INVENTORY-20260716.json"
PFETH_STALE = "source_changed_after_committed_build"
PFUSDC_STATEMENT_SOURCES = (
    "crates/types/src/account_owned_asset_types.rs",
    "crates/types/src/market_nav_asset_types.rs",
    "crates/ethereum-contracts/src/ERC20BridgeVaultL1.sol",
    "crates/execution/src/vault_bridge_profile_resolution.rs",
    "crates/node/src/execution_actions.rs",
)


def sha256_file(relative: str) -> str:
    return hashlib.sha256((ROOT / relative).read_bytes()).hexdigest()


def struct_fields(source: str, name: str) -> list[str]:
    match = re.search(r"pub struct " + name + r" \{(.*?)\n\}", source, re.S)
    if not match:
        raise SystemExit(f"struct {name} missing")
    return re.findall(r"^\s*pub (\w+):", match.group(1), re.M)


def main() -> None:
    document = json.loads(INVENTORY.read_text(encoding="utf-8"))
    if document.get("schema") != "postfiat-open-source-proof-public-input-inventory-v1":
        raise SystemExit("proof inventory schema mismatch")
    systems = {item["name"]: item for item in document["systems"]}
    for relative, expected in document["source_hashes"].items():
        actual = sha256_file(relative)
        if actual != expected:
            users = [name for name, item in systems.items() if relative in item.get("sources", [])]
            raise SystemExit(
                f"proof inventory source drift: {relative} expected={expected} actual={actual}"
                + (f" (sources of: {', '.join(users)})" if users else "")
            )

    if len(systems) != 9:
        raise SystemExit("proof inventory must classify exactly nine proof systems")
    expected_layouts = {
        "AssetOrchard swap": (28, "ASSET_ORCHARD_PUBLIC_INSTANCE_LEN: usize = 28"),
        "AssetOrchard private egress": (
            13,
            "ASSET_ORCHARD_PRIVATE_EGRESS_PUBLIC_INSTANCE_LEN: usize = 13",
        ),
    }
    orchard_source = (ROOT / "crates/privacy_orchard/src/asset_orchard.rs").read_text(
        encoding="utf-8"
    )
    for name, (length, source_marker) in expected_layouts.items():
        system = systems[name]
        fields = system["public_instances"]
        if system["public_instance_length"] != length:
            raise SystemExit(f"{name}: public instance length mismatch")
        if [field["index"] for field in fields] != list(range(length)):
            raise SystemExit(f"{name}: indices must cover exactly 0..{length - 1}")
        if any(not field.get("name") or not field.get("binding") for field in fields):
            raise SystemExit(f"{name}: every public field needs a name and binding")
        if source_marker not in orchard_source:
            raise SystemExit(f"{name}: source length marker missing")

    if "Groth16Verifier::verify(" not in (
        ROOT / "crates/execution/src/nav_sp1_verifier.rs"
    ).read_text(encoding="utf-8"):
        raise SystemExit("SP1 Groth16 verification call missing")

    reserve = systems["NAV provider-neutral reserve proof"]
    if reserve["proof_system_id"] != "sp1-nav-reserve-v1":
        raise SystemExit("provider-neutral NAV proof-system ID mismatch")
    if reserve["public_values_length"] != 584:
        raise SystemExit("provider-neutral NAV public-values length mismatch")
    reserve_fields = reserve["public_values"]
    if any(not field.get("name") or not field.get("binding") for field in reserve_fields):
        raise SystemExit("provider-neutral NAV public fields need names and bindings")
    expected_offset = 0
    for field in reserve_fields:
        if field["byte_offset"] != expected_offset or field["byte_length"] <= 0:
            raise SystemExit("provider-neutral NAV public fields are not contiguous")
        expected_offset += field["byte_length"]
    if expected_offset != 584:
        raise SystemExit("provider-neutral NAV public fields do not cover exactly 584 bytes")

    reserve_types = (
        ROOT / "crates/types/src/nav_reserve_public_values.rs"
    ).read_text(encoding="utf-8")
    for marker in (
        'NAV_RESERVE_PUBLIC_VALUES_MAGIC_V1: &[u8; 8] = b"PFNAV001"',
        "NAV_RESERVE_PUBLIC_VALUES_VERSION_V1: u32 = 1",
        "NAV_RESERVE_PUBLIC_VALUES_V1_BYTES: usize = 584",
    ):
        if marker not in reserve_types:
            raise SystemExit(f"provider-neutral NAV source marker missing: {marker}")
    reserve_guest = (
        ROOT / "tools/nav-reserve-proof/programs/reserve-proof-guest/src/main.rs"
    ).read_text(encoding="utf-8")
    if "sp1_zkvm::io::commit_slice(&public_values)" not in reserve_guest:
        raise SystemExit("provider-neutral NAV guest public-values commitment missing")

    pfeth_ingress = systems["Ethereum mainnet pfETH ingress"]
    if (
        pfeth_ingress["proof_system_id"]
        != "sp1-pfeth-ethereum-mainnet-ingress-v1"
        or pfeth_ingress["public_values_schema"]
        != "postfiat.pfeth.ethereum_ingress_public_values.v1"
        or pfeth_ingress["program_vkey"]
        != "0x000dd724902a8a24abde9f3fda01477e0d454ac506fbb6a0613fd4486ad4953c"
    ):
        raise SystemExit("pfETH ingress proof identity mismatch")
    ingress_fields = pfeth_ingress["public_values"]
    if [field["index"] for field in ingress_fields] != list(range(26)):
        raise SystemExit("pfETH ingress fields must cover exactly indices 0..25")
    if any(not field.get("name") or not field.get("binding") for field in ingress_fields):
        raise SystemExit("pfETH ingress public fields need names and bindings")
    labels = [a.split(":", 1)[0] for a in pfeth_ingress.get("assumptions", [])]
    if labels != ["A1", "A2", "A3", "A4"]:
        raise SystemExit("pfETH ingress must record binding assumptions A1-A4 (or why one does not apply)")
    ingress_guest = (
        ROOT / "programs/pfeth-eth-mainnet-ingress/src/main.rs"
    ).read_text(encoding="utf-8")
    ingress_library = (
        ROOT / "programs/pfusdc-eth-mainnet-ingress/src/lib.rs"
    ).read_text(encoding="utf-8")
    ingress_tool = (
        ROOT / "tools/eth-l1-mainnet-fast-lane-p0/src/main.rs"
    ).read_text(encoding="utf-8")
    for marker, source in (
        ("verify_weth_witness(&witness)", ingress_guest),
        ("PFETH_PUBLIC_VALUES_SCHEMA", ingress_library),
        ("WETH_WEI_PER_PFETH_ATOM: u64 = 1_000_000_000", ingress_library),
    ):
        if marker not in source:
            raise SystemExit(f"pfETH ingress source marker missing: {marker}")
    # The pfETH ELF is built from the shared ingress library. When that source
    # has moved on, the entry must say so and the prover must refuse pfETH.
    build = pfeth_ingress.get("build_state", {})
    if sha256_file(build.get("committed_elf", "")) != build.get("committed_elf_sha256"):
        raise SystemExit("pfETH committed ELF hash mismatch")
    changed = [
        relative
        for relative, built in build["built_from_source_sha256"].items()
        if sha256_file(relative) != built
    ]
    if changed and build.get("state") != PFETH_STALE:
        raise SystemExit(f"pfETH ELF predates its sources {changed}; record {PFETH_STALE}")
    if not changed and build.get("state") == PFETH_STALE:
        raise SystemExit("pfETH sources match the committed build; clear its stale build state")
    if changed and "Self::Pfeth => bail!(" not in ingress_tool:
        raise SystemExit("pfETH ELF is stale but the prover tool does not refuse pfETH proving")
    pfeth_state = (
        f"pfeth_ingress={PFETH_STALE} key={pfeth_ingress['program_vkey']} "
        f"changed={','.join(changed)}: {build['note']}"
        if changed
        else "pfeth_ingress=built_from_current_sources"
    )

    pfusdc = systems["Ethereum mainnet pfUSDC ingress"]
    if (
        pfusdc["proof_system_id"] != "sp1-pfusdc-ethereum-mainnet-ingress-v1"
        or pfusdc["public_values_schema"]
        != "postfiat.pfusdc.ethereum_ingress_public_values.v1"
        or pfusdc["program_vkey"]
        != "0x00d8cbf06d5640adde0fef863b3c689c4ab3442b0dc91d28ac4cc5f9c9b2ccbb"
        or pfusdc["elf_sha256"]
        != "b6a06cb90ee81477a33c9a5902458db5b379cc40b765988cebb0ec46d08766fe"
        or sha256_file(pfusdc["elf"]) != pfusdc["elf_sha256"]
    ):
        raise SystemExit("pfUSDC ingress proof identity mismatch")
    missing = [s for s in pfusdc["sources"] if s not in document["source_hashes"]]
    if missing:
        raise SystemExit(f"pfUSDC ingress sources are not pinned: {missing}")
    # Statement and binding owners outside the guest crate: deposit-record
    # helpers, route allowlist, vault storage layout and active-policy selectors.
    unlisted = [s for s in PFUSDC_STATEMENT_SOURCES if s not in pfusdc["sources"]]
    if unlisted:
        raise SystemExit(f"pfUSDC ingress statement sources are not listed: {unlisted}")
    if len(pfusdc.get("assumptions", [])) != 4:
        raise SystemExit("pfUSDC ingress must record its four binding assumptions A1-A4")
    pfusdc_fields = pfusdc["public_values"]
    if [field["index"] for field in pfusdc_fields] != list(range(29)):
        raise SystemExit("pfUSDC ingress fields must cover exactly indices 0..28")
    if any(not field.get("name") or not field.get("binding") for field in pfusdc_fields):
        raise SystemExit("pfUSDC ingress public fields need names and bindings")
    names = [field["name"] for field in pfusdc_fields]
    host_types = (ROOT / "crates/types/src/pfusdc_tier4_types.rs").read_text(encoding="utf-8")
    legacy_types = (ROOT / "crates/types/src/b23_ingress_legacy.rs").read_text(encoding="utf-8")
    if (
        struct_fields(ingress_library, "EthIngressPublicValuesV1") != names
        or struct_fields(host_types, "PfUsdcEthereumIngressPublicValuesV1") != names
    ):
        raise SystemExit("pfUSDC ingress fields differ from the guest or host layout")
    legacy = [n for n in names if n not in pfusdc["legacy_omitted_fields"]]
    if (
        len(legacy) != 26
        or pfusdc["legacy_public_values_length"] != 26
        or struct_fields(legacy_types, "PfUsdcEthereumIngressPublicValuesLegacyV1") != legacy
    ):
        raise SystemExit("pfUSDC legacy 26-field layout mismatch")
    execution = (ROOT / "crates/execution/src/nav_vault_asset_execution.rs").read_text(
        encoding="utf-8"
    )
    for marker in (
        "ethereum_ingress_legacy_public_values_on_anchored_route",
        "PfUsdcBeaconFinalityStateV1::advance_for_deposit(",
    ):
        if marker not in execution:
            raise SystemExit(f"pfUSDC ingress host marker missing: {marker}")

    egress = systems["PFTL bridge finality egress"]
    if (
        egress["proof_system_id"] != "sp1-pftl-finality-egress-v1"
        or egress["program_vkey"]
        != "0x00140f09ca6f1b917e3999a806df5ef4ac4468bd65b85e8580cbc16f832dfe47"
    ):
        raise SystemExit("PFTL egress proof identity mismatch")
    withdrawal_fields = egress["withdrawal_public_values"]
    checkpoint_fields = egress["checkpoint_public_values"]
    if [field["tag"] for field in withdrawal_fields] != list(range(1, 40)):
        raise SystemExit("PFTL withdrawal fields must cover exactly tags 1..39")
    if [field["tag"] for field in checkpoint_fields] != list(range(1, 16)):
        raise SystemExit("PFTL checkpoint fields must cover exactly tags 1..15")
    if any(
        not field.get("name") or not field.get("binding")
        for field in withdrawal_fields + checkpoint_fields
    ):
        raise SystemExit("PFTL egress public fields need names and bindings")
    egress_guest = (ROOT / "programs/pfusdc-egress/src/main.rs").read_text(
        encoding="utf-8"
    )
    egress_types = (ROOT / "crates/types/src/pfusdc_tier4_types.rs").read_text(
        encoding="utf-8"
    )
    for marker, source in (
        ("verify_egress_witness_v1", egress_guest),
        ("verify_checkpoint_witness_v1", egress_guest),
        ("pfusdc_append_hex(&mut out, 39, &self.proof_nullifier)?", egress_types),
        ("pfusdc_append_hex(&mut out, 15, &self.finalized_state_root)?", egress_types),
    ):
        if marker not in source:
            raise SystemExit(f"PFTL egress source marker missing: {marker}")

    lane = systems["PFT lane export egress"]
    lane_info = json.loads(
        (ROOT / "programs/pft-lane-export/program-info.json").read_text(encoding="utf-8")
    )
    lane_elf = hashlib.sha256(
        (ROOT / "programs/pft-lane-export/elf/pft-lane-export-program").read_bytes()
    ).hexdigest()
    if (
        lane["proof_system_id"] != "sp1-pft-lane-export-v1"
        or lane["program_vkey"] != lane_info["program_vkey"]
        or lane["elf_sha256"] != lane_info["elf_sha256"]
        or lane_elf != lane_info["elf_sha256"]
    ):
        raise SystemExit("PFT lane export proof identity mismatch")
    if [field["tag"] for field in lane["withdrawal_public_values"]] != list(range(1, 40)):
        raise SystemExit("PFT lane export fields must cover exactly tags 1..39")
    if [field["tag"] for field in lane["checkpoint_public_values"]] != list(range(1, 16)):
        raise SystemExit("PFT lane checkpoint fields must cover exactly tags 1..15")
    if any(
        not field.get("name") or not field.get("binding")
        for field in lane["withdrawal_public_values"] + lane["checkpoint_public_values"]
    ):
        raise SystemExit("PFT lane export public fields need names and bindings")
    lane_guest = (ROOT / "programs/pft-lane-export/src/main.rs").read_text(encoding="utf-8")
    lane_statement = (ROOT / "crates/pft_lane_proofs/src/lib.rs").read_text(encoding="utf-8")
    lane_values = (ROOT / "crates/types/src/external_lane_egress_types.rs").read_text(
        encoding="utf-8"
    )
    for marker, source in (
        ("verify_external_lane_export_witness_v1", lane_guest),
        ("verify_external_lane_checkpoint_witness_v1", lane_guest),
        ("external_lane_export_egress_public_values(lane, packet, &checkpoint)", lane_statement),
        ("verify_pftl_finality_segment_v1(", lane_statement),
        ("pub fn external_lane_export_egress_public_values(", lane_values),
    ):
        if marker not in source:
            raise SystemExit(f"PFT lane export source marker missing: {marker}")

    public_fields = sum(
        len(system.get("public_instances", system.get("public_values", [])))
        + len(system.get("withdrawal_public_values", []))
        + len(system.get("checkpoint_public_values", []))
        for system in systems.values()
    )
    print(pfeth_state)
    print(
        "proof_public_input_inventory=ok "
        f"systems={len(systems)} public_fields={public_fields} "
        f"source_hashes={len(document['source_hashes'])}"
    )


if __name__ == "__main__":
    main()
