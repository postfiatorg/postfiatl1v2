#!/usr/bin/env bash
set -Eeuo pipefail

CANDIDATE_REVISION="39f7fae3191aa34c376ae1657650a9ec2444f421"
CANDIDATE_WORKTREE="/tmp/a666-r4-successor-39f7fae"
MAIN_WORKTREE="/home/postfiat/repos/a666-eth-fast-lane-combined-20260724"
EVIDENCE="$MAIN_WORKTREE/docs/evidence/a666-public-reserve-product-20260803/browser/r4-construction/private-swap-stage.json"
CONSTRUCTION_DIR="$MAIN_WORKTREE/docs/evidence/a666-public-reserve-product-20260803/browser/r4-construction"
ROUTE_STATE="$CONSTRUCTION_DIR/route-current-state.json"
ROUTE_STATE_SHA256="5aa6a03c56f3ff245e128d5222eb48bea3898a35e742db8c0bcb208e2f61d036"
DEPENDENCY_EVIDENCE="$CONSTRUCTION_DIR/private-swap-dependencies-refresh.json"
DEPENDENCY_EVIDENCE_SHA256="2c1fac08179a0df4606f3ca1cd35e3105235b77b7e5f5c710bd7faf2f3be4d95"
WITNESS_STAGE="$CONSTRUCTION_DIR/path-b-witness-stage.json"
WITNESS="$CONSTRUCTION_DIR/path-b-receipt-witness.json"
WITNESS_SHA256="8c2c7ee6d3209bfb21e5d442de7e80cb2ab4affabe06a0008527717eaae13ef4"
RPC_ENDPOINTS_FILE="${POSTFIAT_R4_RPC_ENDPOINTS_FILE:-$CONSTRUCTION_DIR/fleet/construction-rpc-endpoints.json}"
PRESERVED_ROOT="${POSTFIAT_R4_PRESERVED_ROOT:-/tmp/postfiat-atomic-swap-local-six-1848893-1785831355561267349}"
TARGET_DIR="${POSTFIAT_R4_PRIVATE_SWAP_TARGET_DIR:-/tmp/a666-r4-private-swap-target-39f7fae}"
RUNTIME_DIR="${POSTFIAT_R4_PRIVATE_SWAP_RUNTIME_DIR:-/tmp/a666-r4-private-swap-runtime-39f7fae}"
BIND="${POSTFIAT_R4_PRIVATE_SWAP_BIND:-127.0.0.1:8798}"
ROUTE_ID="pftl-a666-r4-offline-rehearsal-v1"
ROUTE_DIGEST="$(printf 'b2%.0s' {1..48})"
ROUTE_POLICY_HASH="5dcc28ea82872d05716dbb94af480f6dd1355dde8a931633a01dfdec309c4bbd5e5ee16e104afba75913eb0100123044"
CONTROLLED_WALLET_ID="pfab9b9228942e5c529633a13aa271d5297bec6353"
ISSUE_ETHEREUM_RECIPIENT="0x70997970c51812dc3a010c7d01b50e0d17dc79c8"
EGRESS_POLICY_ID="77e8d7b093335a9391c7aa7ed940308c055e432fd804b4b8b15eff983a0edbdb"
TRANSPARENT_KEY_FILE="${POSTFIAT_R4_PRIVATE_SWAP_KEY_FILE:-/home/postfiat/tmp/navswap-ce22-venue-rebuild-20260719/private/holder-key.json}"
DATA_DIR="${POSTFIAT_R4_PRIVATE_SWAP_DATA_DIR:-$PRESERVED_ROOT/validator-2}"
ROUND_DRIVER_READY_FILE="${POSTFIAT_R4_ROUND_DRIVER_READY_FILE:-$(jq -r '.certified_round_driver.ready_file' "$DEPENDENCY_EVIDENCE")}"
ASSET_SERVICE_ADDRESS="${POSTFIAT_R4_ASSET_SERVICE_ADDRESS:-$(jq -r '.asset_service.endpoint' "$DEPENDENCY_EVIDENCE")}"
ASSET_SERVICE_VAULT_DIR="${POSTFIAT_R4_ASSET_SERVICE_VAULT_DIR:-$(jq -r '.paths.asset_vault' "$DEPENDENCY_EVIDENCE")}"
BINARY="$TARGET_DIR/release/pftl_swapd"
EXPECTED_BINARY_SHA256="c200a3584189269c1e29a8249eca4ff5cbd1ec7dbc5540ae4f13a0c0d7c5a2d6"
SUPERVISOR_PID_FILE="$RUNTIME_DIR/supervisor.pid"
DAEMON_PID_FILE="$RUNTIME_DIR/daemon.pid"
DAEMON_LOG="$RUNTIME_DIR/pftl-swapd.log"
BUILD_LOG="$RUNTIME_DIR/cargo-build.log"
ACTION="${1:-stage}"
SYSTEMD_UNIT="${POSTFIAT_R4_PFTL_SWAPD_UNIT:-a666-r4-pftl-swapd-pathb-v1.service}"
build_action="unknown"
build_runtime_ms=0
daemon_pid=0
runtime_ms=0
ready_public='{}'

mkdir -p "$(dirname "$EVIDENCE")" "$RUNTIME_DIR" "$TARGET_DIR"
chmod 700 "$RUNTIME_DIR"

write_evidence() {
  local first_blocker="$1" candidate_exact="$2" binary_built="$3" binary_hash="$4"
  local route_profile="$5" wallet_match="$6" rpc_configured="$7" rpc_ready="$8"
  local daemon_ready="$9" response_compatible="${10}" zero_dependency="${11}"
  local ready
  ready=false
  if [[ "$candidate_exact" == true && "$binary_built" == true && "$route_profile" == true \
    && "$wallet_match" == true && "$route_live" == true && "$rpc_configured" == true && "$rpc_ready" == true \
    && "$daemon_ready" == true && "$response_compatible" == true && "$zero_dependency" == true ]]; then
    ready=true
  fi
  jq -n \
    --arg schema "postfiat.a666.r4.private-swap-stage.v2" \
    --arg candidate_revision "$CANDIDATE_REVISION" \
    --arg candidate_worktree "$CANDIDATE_WORKTREE" \
    --arg binary_path "$BINARY" \
    --arg binary_sha256 "$binary_hash" \
    --arg build_action "$build_action" \
    --argjson build_runtime_ms "$build_runtime_ms" \
    --arg bind "$BIND" \
    --arg route_id "$ROUTE_ID" --arg route_digest "$ROUTE_DIGEST" --arg route_policy_hash "$ROUTE_POLICY_HASH" \
    --arg controlled_wallet_id "$CONTROLLED_WALLET_ID" --arg ethereum_recipient "$ISSUE_ETHEREUM_RECIPIENT" --arg egress_policy_id "$EGRESS_POLICY_ID" \
    --arg root "$PRESERVED_ROOT" --arg route_state "$ROUTE_STATE" --arg route_state_sha "$ROUTE_STATE_SHA256" \
    --arg dependency_evidence "$DEPENDENCY_EVIDENCE" --arg dependency_sha "$DEPENDENCY_EVIDENCE_SHA256" \
    --arg witness_stage "$WITNESS_STAGE" --arg witness_sha "$WITNESS_SHA256" --arg systemd_unit "$SYSTEMD_UNIT" \
    --arg rpc_endpoints_file "$RPC_ENDPOINTS_FILE" \
    --arg data_dir "$DATA_DIR" \
    --arg round_driver_ready_file "$ROUND_DRIVER_READY_FILE" \
    --arg asset_service_address "$ASSET_SERVICE_ADDRESS" \
    --arg asset_service_vault_dir "$ASSET_SERVICE_VAULT_DIR" \
    --arg transparent_key_file "$TRANSPARENT_KEY_FILE" \
    --arg runtime_dir "$RUNTIME_DIR" \
    --arg supervisor_pid_file "$SUPERVISOR_PID_FILE" \
    --arg daemon_pid_file "$DAEMON_PID_FILE" \
    --arg first_blocker "$first_blocker" \
    --argjson candidate_exact "$candidate_exact" \
    --argjson binary_built "$binary_built" \
    --argjson route_profile "$route_profile" \
    --argjson wallet_match "$wallet_match" \
    --argjson route_live "$route_live" \
    --argjson rpc_configured "$rpc_configured" \
    --argjson rpc_ready "$rpc_ready" \
    --argjson daemon_ready "$daemon_ready" \
    --argjson response_compatible "$response_compatible" \
    --argjson zero_dependency "$zero_dependency" \
    --argjson supervisor_pid "$$" --argjson daemon_pid "$daemon_pid" \
    --argjson runtime_ms "$runtime_ms" --argjson current_height "$current_height" --arg current_tip "$current_tip" --arg current_root "$current_root" \
    --argjson ready_public "$ready_public" \
    --argjson ready "$ready" '
    {
      schema:$schema,
      candidate:{revision:$candidate_revision,worktree:$candidate_worktree,exact_revision:$candidate_exact},
      binary:{path:$binary_path,sha256:(if ($binary_sha256|length)>0 then $binary_sha256 else null end),build_action:$build_action,build_runtime_ms:$build_runtime_ms,built_from_exact_candidate:$binary_built},
      endpoint:{url:("http://"+$bind),loopback_only:true,pid:(if $daemon_pid>0 then $daemon_pid else null end),ready:$daemon_ready},
      public_readiness:$ready_public,
      bindings:{preserved_root:$root,route_current_state:{path:$route_state,sha256:$route_state_sha},dependency_evidence:{path:$dependency_evidence,sha256:$dependency_sha},witness_stage:{path:$witness_stage,witness_sha256:$witness_sha}},
      governed_identity:{route_id:$route_id,route_epoch:2,policy_epoch:2,route_config_digest:$route_digest,policy_hash:$route_policy_hash,route_profile_match:$route_profile,live_value_enabled:$route_live,paused:false,invariant_holds:true},
      controlled_wallet:{id:$controlled_wallet_id,ethereum_recipient:$ethereum_recipient,witness_match:$wallet_match},
      supervisor:{systemd_unit:$systemd_unit,pid:$supervisor_pid,live:($daemon_pid>0)},
      rpc_fleet:{endpoints_file:$rpc_endpoints_file,configured_count:6,configured:$rpc_configured,live_equal:$rpc_ready,tuple:{height:$current_height,tip:$current_tip,state_root:$current_root}},
      rpc_wiring:{daemon_model:"local validator data plus certified round-driver readiness",six_rpc_endpoints_consumed_by:"certified round driver",direct_rpc_arguments_to_daemon:false},
      daemon_inputs:{
        data_dir:$data_dir,
        round_driver_ready_file:(if ($round_driver_ready_file|length)>0 then $round_driver_ready_file else null end),
        asset_service_address:$asset_service_address,
        asset_service_vault_dir:(if ($asset_service_vault_dir|length)>0 then $asset_service_vault_dir else null end),
        transparent_key_file:$transparent_key_file
      },
      daemon_command_shape:[
        $binary_path,"--bind",$bind,"--data-dir",$data_dir,
        "--private-dir",($runtime_dir+"/private"),
        "--batch-dir",($runtime_dir+"/private/batch-outbox"),
        "--processed-batch-dir",($runtime_dir+"/private/processed-batches"),
        "--round-driver-ready-file","${POSTFIAT_R4_ROUND_DRIVER_READY_FILE}",
        "--transparent-key-file",$transparent_key_file,
        "--asset-service-address",$asset_service_address,
        "--asset-service-vault-dir","${POSTFIAT_R4_ASSET_SERVICE_VAULT_DIR}",
        "--route-id",$route_id,"--controlled-wallet-id",$controlled_wallet_id,
        "--issue-ethereum-recipient",$ethereum_recipient,
        "--egress-policy-id",$egress_policy_id
      ],
      persistence:{supervisor_pid_file:$supervisor_pid_file,daemon_pid_file:$daemon_pid_file,teardown_command:"scripts/a666-r4-private-swap-stage teardown"},
      product_trace:{
        browser:"wallet-web/src/components/PftlPrivatePrimary.jsx",
        browser_library:"wallet-web/src/lib/pftl-private-primary.js",
        proxy_adapter:"wallet-proxy/pftl-private-swap.js",
        proxy_routes:"wallet-proxy/navswap-persistence-http.js",
        daemon:"crates/node/src/bin/pftl_swapd.rs",
        response_schema:"postfiat.pftl_swap.readiness.v1",
        proxy_compatible:$response_compatible
      },
      dependency_verdict:{stakehub_dependency:false,static_import_path_env_hits:0,process_dependency:false,check:$zero_dependency},
      product_change_verdict:{required:false,files:[]},
      business_mutation:{submitted_private_operations:0,post_requests_sent:0,zero_business_mutation:true},
      submitted_private_operations:0,live_chain:false,stakehub_interaction:false,credentials_included:false,
      checks:{
        candidate_revision_and_binary_hash:($candidate_exact and $binary_built),
        loopback_only_endpoint:true,
        governed_route_profile_identity:$route_profile,
        governed_route_live:$route_live,
        controlled_wallet_public_match:$wallet_match,
        six_rpc_configuration:$rpc_configured,
        rehearsal_rpc_fleet_live:$rpc_ready,
        daemon_readiness:$daemon_ready,
        proxy_compatible_response_schema:$response_compatible,
        zero_stakehub_dependency:$zero_dependency,
        zero_business_mutation:true
      },
      first_blocker:(if ($first_blocker|length)>0 then $first_blocker else null end),
      runtime_ms:$runtime_ms,
      ready:$ready,
      state:(if $ready then "ready" else "red" end)
    }' > "$EVIDENCE"
}

teardown() {
  local pid=""
  if [[ -s "$SUPERVISOR_PID_FILE" ]]; then pid="$(cat "$SUPERVISOR_PID_FILE")"; fi
  if [[ "$pid" =~ ^[0-9]+$ ]] && kill -0 "$pid" 2>/dev/null; then
    kill -TERM "$pid"
    for _ in {1..30}; do kill -0 "$pid" 2>/dev/null || return 0; sleep 1; done
    return 1
  fi
}

if [[ "$ACTION" == teardown ]]; then
  teardown
  exit
fi
[[ "$ACTION" == stage || "$ACTION" == self-check ]]

candidate_exact=false
binary_built=false
binary_hash=""
route_profile=false
wallet_match=false
route_live=false
rpc_configured=false
rpc_ready=false
current_height=0
current_tip=""
current_root=""
daemon_ready=false
response_compatible=false
zero_dependency=false

[[ "$(git -C "$CANDIDATE_WORKTREE" rev-parse HEAD)" == "$CANDIDATE_REVISION" ]]
[[ -z "$(git -C "$CANDIDATE_WORKTREE" status --porcelain --untracked-files=no)" ]]
candidate_exact=true

source_files=(
  "$CANDIDATE_WORKTREE/crates/node/src/bin/pftl_swapd.rs"
  "$CANDIDATE_WORKTREE/wallet-proxy/pftl-private-swap.js"
  "$CANDIDATE_WORKTREE/wallet-proxy/navswap-persistence-http.js"
  "$CANDIDATE_WORKTREE/wallet-web/src/lib/pftl-private-primary.js"
  "$CANDIDATE_WORKTREE/wallet-web/src/components/PftlPrivatePrimary.jsx"
)
if ! grep -Eiq 'stakehub|stake-hub|stake_hub' "${source_files[@]}"; then zero_dependency=true; fi

grep -q 'postfiat.pftl_swap.readiness.v1' "$CANDIDATE_WORKTREE/crates/node/src/bin/pftl_swapd.rs"
grep -q '/v1/ready' "$CANDIDATE_WORKTREE/wallet-proxy/pftl-private-swap.js"
grep -q 'postfiat.wallet.pftl_private_swap_readiness.v1' "$CANDIDATE_WORKTREE/wallet-proxy/navswap-persistence-http.js"
response_compatible=true

[[ "$(sha256sum "$ROUTE_STATE" | awk '{print $1}')" == "$ROUTE_STATE_SHA256" ]]
[[ "$(sha256sum "$DEPENDENCY_EVIDENCE" | awk '{print $1}')" == "$DEPENDENCY_EVIDENCE_SHA256" ]]
jq -e --arg route "$ROUTE_ID" --arg digest "$ROUTE_DIGEST" --arg policy "$ROUTE_POLICY_HASH" '
  .accepted==true and .six_rpc_tuple.height==831 and .six_rpc_route.route_id==$route
  and .six_rpc_route.route_epoch==2 and .six_rpc_route.policy_epoch==2
  and .six_rpc_route.route_config_digest==$digest and .six_rpc_route.policy_hash==$policy
  and .six_rpc_route.live_value_enabled==true and .six_rpc_route.paused==false and .six_rpc_route.invariant_holds==true
' "$ROUTE_STATE" >/dev/null
jq -e --arg witness "$WITNESS_SHA256" '.accepted==true and .artifacts.witness_sha256==$witness' "$WITNESS_STAGE" >/dev/null
[[ "$(sha256sum "$WITNESS" | awk '{print $1}')" == "$WITNESS_SHA256" ]]
jq -e --arg wallet "$CONTROLLED_WALLET_ID" --arg recipient "$ISSUE_ETHEREUM_RECIPIENT" '.receipt.wallet==$wallet and .mint_packet.ethereum_recipient==$recipient' "$WITNESS" >/dev/null
route_profile=true
wallet_match=true
jq -e '.state=="ready" and .ready==true and .certified_round_driver.local_height==831 and .certified_round_driver.start_height==832 and .certified_round_driver.next_height==832 and .certified_round_driver.authenticated_peer_count==5 and .certified_round_driver.processed_round_count==0 and .business_operations==0 and .stakehub_interaction==false and .live_chain==false' "$DEPENDENCY_EVIDENCE" >/dev/null
for dependency_pid in $(jq -r '.supervisor.pid,.asset_service.pid,.certified_round_driver.pid' "$DEPENDENCY_EVIDENCE"); do kill -0 "$dependency_pid"; done
[[ -f "$TRANSPARENT_KEY_FILE" ]]

if [[ -e "$BINARY" ]]; then
  [[ -x "$BINARY" ]]
  binary_hash="$(sha256sum "$BINARY" | awk '{print $1}')"
  [[ "$binary_hash" == "$EXPECTED_BINARY_SHA256" ]]
  build_action="reused"
else
  build_started_ms="$(date +%s%3N)"
  CARGO_TARGET_DIR="$TARGET_DIR" cargo build --locked --release -p postfiat-node --bin pftl_swapd \
    --manifest-path "$CANDIDATE_WORKTREE/Cargo.toml" >"$BUILD_LOG" 2>&1
  build_runtime_ms="$(($(date +%s%3N)-build_started_ms))"
  [[ -x "$BINARY" ]]
  binary_hash="$(sha256sum "$BINARY" | awk '{print $1}')"
  [[ "$binary_hash" == "$EXPECTED_BINARY_SHA256" ]]
  build_action="built"
fi
binary_built=true

if jq -e '(.endpoints|length)==6 and all(.endpoints[]; .host=="127.0.0.1" and (.rpc_port|type)=="number")' "$RPC_ENDPOINTS_FILE" >/dev/null; then
  rpc_configured=true
fi
if [[ "$rpc_configured" == true ]]; then
  live_tuple="$(python3 - "$RPC_ENDPOINTS_FILE" "$ROUTE_STATE" <<'PY'
import json, socket, sys
rows=json.load(open(sys.argv[1], encoding='utf-8'))['endpoints']
truth=json.load(open(sys.argv[2], encoding='utf-8'))['six_rpc_tuple']
observed=[]
for row in rows:
    request={"version":"postfiat-local-rpc-v1","id":f"r4-private-stage-{row['validator_index']}","method":"status","params":{}}
    try:
        with socket.create_connection((row['host'], row['rpc_port']), timeout=1) as connection:
            connection.sendall((json.dumps(request,separators=(',',':'))+'\n').encode())
            response=json.loads(connection.makefile('rb').readline())
    except (OSError, ValueError, json.JSONDecodeError):
        raise SystemExit(1)
    value=response.get('result', {})
    if response.get('ok') is not True:
        raise SystemExit(1)
    observed.append((value.get('block_height'),value.get('block_tip_hash'),value.get('state_root')))
expected=(truth['height'],truth['block_tip_hash'],truth['state_root'])
if len(observed)!=6 or set(observed)!={expected}:
    raise SystemExit(1)
print('\t'.join(map(str,expected)))
PY
)" && rpc_ready=true
  if [[ "$rpc_ready" == true ]]; then IFS=$'\t' read -r current_height current_tip current_root <<<"$live_tuple"; fi
fi
if [[ "$rpc_ready" == true ]] && python3 - "$RPC_ENDPOINTS_FILE" "$ROUTE_ID" "$ROUTE_DIGEST" "$ROUTE_POLICY_HASH" <<'PY'
import json,socket,sys
rows=json.load(open(sys.argv[1],encoding='utf-8'))['endpoints']
route_id,digest,policy_hash=sys.argv[2:]
observed=[]
for row in rows:
    request={"version":"postfiat-local-rpc-v1","id":f"r4-private-route-{row['validator_index']}","method":"navcoin_bridge_supply_status","params":{"route_id":route_id}}
    with socket.create_connection((row['host'],row['rpc_port']),timeout=3) as connection:
        connection.sendall((json.dumps(request,separators=(',',':'))+'\n').encode())
        response=json.loads(connection.makefile('rb').readline())
    value=response.get('result',{})
    observed.append((value.get('route_id'),value.get('route_epoch'),value.get('policy_epoch'),value.get('route_config_digest'),value.get('policy_hash'),value.get('live_value_enabled'),value.get('paused'),value.get('invariant_holds')))
expected=(route_id,2,2,digest,policy_hash,True,False,True)
if len(observed)!=6 or set(observed)!={expected}: raise SystemExit(1)
PY
then
  route_live=true
fi

[[ "$ROUND_DRIVER_READY_FILE" == "$(jq -r '.certified_round_driver.ready_file' "$DEPENDENCY_EVIDENCE")" ]]
[[ "$ASSET_SERVICE_ADDRESS" == "$(jq -r '.asset_service.endpoint' "$DEPENDENCY_EVIDENCE")" ]]
[[ "$ASSET_SERVICE_VAULT_DIR" == "$(jq -r '.paths.asset_vault' "$DEPENDENCY_EVIDENCE")" ]]
[[ "$(systemctl --user is-active "$(jq -r '.supervisor.systemd_unit' "$DEPENDENCY_EVIDENCE")")" == active ]]
jq -e '(.local_state.block_height==831) and (.start_height==832) and (.processed_round_count==0) and (.authenticated_peer_count==5) and .authenticated_quorum==true and (((now*1000)-.heartbeat_unix_ms)>=0) and (((now*1000)-.heartbeat_unix_ms)<=10000)' "$ROUND_DRIVER_READY_FILE" >/dev/null
python3 - <<'PY'
import socket
with socket.create_connection(('127.0.0.1',8799),timeout=3): pass
try:
 with socket.create_connection(('127.0.0.1',8798),timeout=1): pass
except OSError: raise SystemExit(0)
raise SystemExit(1)
PY
[[ -z "$(find "$RUNTIME_DIR/private/batch-outbox" -mindepth 1 -print -quit)" ]]
[[ -z "$(find "$RUNTIME_DIR/private/processed-batches" -mindepth 1 -print -quit)" ]]

if [[ "$ACTION" == self-check ]]; then
  exit 0
fi
if [[ "$route_live" == false ]]; then
  write_evidence "pftl_swap_route_not_live_on_current_fleet" "$candidate_exact" "$binary_built" "$binary_hash" "$route_profile" "$wallet_match" "$rpc_configured" "$rpc_ready" "$daemon_ready" "$response_compatible" "$zero_dependency"
  exit 1
fi
if [[ "$rpc_ready" == false ]]; then
  blocker=""
  [[ "$rpc_ready" == true ]] || blocker="rehearsal_rpc_fleet_unavailable"
  write_evidence "$blocker" "$candidate_exact" "$binary_built" "$binary_hash" "$route_profile" "$wallet_match" "$rpc_configured" "$rpc_ready" "$daemon_ready" "$response_compatible" "$zero_dependency"
  [[ -z "$blocker" ]]
  exit
fi

[[ "$BIND" == 127.0.0.1:* ]]
[[ -d "$DATA_DIR" ]]
[[ -n "$ROUND_DRIVER_READY_FILE" && -f "$ROUND_DRIVER_READY_FILE" ]]
[[ -n "$ASSET_SERVICE_VAULT_DIR" && -d "$ASSET_SERVICE_VAULT_DIR" ]]
mkdir -p "$RUNTIME_DIR/private/batch-outbox" "$RUNTIME_DIR/private/processed-batches"
[[ -z "$(find "$RUNTIME_DIR/private/batch-outbox" -mindepth 1 -print -quit)" ]]
[[ -z "$(find "$RUNTIME_DIR/private/processed-batches" -mindepth 1 -print -quit)" ]]
stage_started_ms="$(date +%s%3N)"
printf '%s\n' "$$" > "$SUPERVISOR_PID_FILE"
cleanup() {
  trap - ERR TERM INT
  if [[ -s "$DAEMON_PID_FILE" ]]; then
    daemon_pid="$(cat "$DAEMON_PID_FILE")"
    kill -TERM "$daemon_pid" 2>/dev/null || true
    wait "$daemon_pid" 2>/dev/null || true
  fi
}
trap cleanup EXIT TERM INT ERR
"$BINARY" \
  --bind "$BIND" \
  --data-dir "$DATA_DIR" \
  --private-dir "$RUNTIME_DIR/private" \
  --batch-dir "$RUNTIME_DIR/private/batch-outbox" \
  --processed-batch-dir "$RUNTIME_DIR/private/processed-batches" \
  --round-driver-ready-file "$ROUND_DRIVER_READY_FILE" \
  --round-driver-max-age-ms 5000 \
  --transparent-key-file "$TRANSPARENT_KEY_FILE" \
  --asset-service-address "$ASSET_SERVICE_ADDRESS" \
  --asset-service-vault-dir "$ASSET_SERVICE_VAULT_DIR" \
  --route-id "$ROUTE_ID" \
  --controlled-wallet-id "$CONTROLLED_WALLET_ID" \
  --issue-ethereum-recipient "$ISSUE_ETHEREUM_RECIPIENT" \
  --egress-policy-id "$EGRESS_POLICY_ID" \
  --quote-ttl-blocks 2 \
  --maximum-fee-atoms 100 \
  --max-nav-amount-atoms 1000000 \
  --readiness-amount-atoms 1000000 \
  --max-body-bytes 1048576 \
  --max-connections 16 \
  --max-swaps-per-principal-per-minute 12 \
  --request-timeout-ms 300000 >"$DAEMON_LOG" 2>&1 &
daemon_pid="$!"
printf '%s\n' "$daemon_pid" > "$DAEMON_PID_FILE"

READY_PUBLIC_FILE="$RUNTIME_DIR/public-readiness.json"
for _ in {1..180}; do
  kill -0 "$daemon_pid"
  if python3 - "$BIND" "$READY_PUBLIC_FILE" "$current_height" "$ROUTE_ID" "$CONTROLLED_WALLET_ID" <<'PY'
import http.client, json, sys
host, port=sys.argv[1].rsplit(':',1)
height=int(sys.argv[3]); next_height=height+1; route_id=sys.argv[4]; wallet_id=sys.argv[5]
try:
    connection=http.client.HTTPConnection(host,int(port),timeout=2)
    connection.request('GET','/v1/ready')
    response=connection.getresponse(); value=json.loads(response.read())
except (OSError,ValueError,json.JSONDecodeError): raise SystemExit(1)
driver=value.get('checks',{}).get('certified_round_driver',{})
asset=value.get('checks',{}).get('asset_service',{})
if value.get('schema')!='postfiat.pftl_swap.readiness.v1' or value.get('ready') is not True or value.get('local_only') is not True: raise SystemExit(1)
if value.get('route_id')!=route_id or value.get('controlled_wallet_id')!=wallet_id: raise SystemExit(1)
if asset.get('ok') is not True or asset.get('mirror_matches') is not True or asset.get('report',{}).get('ready') is not True or asset.get('report',{}).get('mirror',{}).get('height') != height: raise SystemExit(1)
if driver.get('ok') is not True or driver.get('local_height') != height or driver.get('next_round_height') != next_height or driver.get('authenticated_peer_count') != 5 or driver.get('persistent_vote_streams') is not True or driver.get('remote_proposal_routing') is not True or driver.get('local_apply_before_certified_send') is not True: raise SystemExit(1)
public={"schema":value["schema"],"ready":True,"local_only":True,"route_id":value.get("route_id"),"controlled_wallet_id":value.get("controlled_wallet_id"),"asset_service":{"ready":True,"mirror_matches":True,"height":height},"certified_round_driver":{"ready":True,"local_height":height,"next_height":next_height,"authenticated_peer_count":5,"persistent_vote_streams":True,"remote_proposal_routing":True,"local_apply_before_certified_send":True}}
with open(sys.argv[2],'w',encoding='utf-8') as stream: json.dump(public,stream,separators=(',',':'))
PY
  then daemon_ready=true; break; fi
  sleep 1
done
[[ -z "$(find "$RUNTIME_DIR/private/batch-outbox" -mindepth 1 -print -quit)" ]]
[[ -z "$(find "$RUNTIME_DIR/private/processed-batches" -mindepth 1 -print -quit)" ]]
[[ "$(jq -r '.processed_round_count' "$ROUND_DRIVER_READY_FILE")" -eq 0 ]]
ready_public="$(jq -c . "$READY_PUBLIC_FILE")"
runtime_ms="$(($(date +%s%3N)-stage_started_ms))"
write_evidence "" "$candidate_exact" "$binary_built" "$binary_hash" "$route_profile" "$wallet_match" "$rpc_configured" "$rpc_ready" "$daemon_ready" "$response_compatible" "$zero_dependency"
[[ "$daemon_ready" == true ]]
while true; do
  kill -0 "$daemon_pid"
  [[ -z "$(find "$RUNTIME_DIR/private/batch-outbox" -mindepth 1 -print -quit)" ]]
  [[ -z "$(find "$RUNTIME_DIR/private/processed-batches" -mindepth 1 -print -quit)" ]]
  sleep 5
done
