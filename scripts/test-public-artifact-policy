def tracked_files() -> set[str]:
    output = subprocess.run(
        ["git", "ls-files", "-z"],
        cwd=ROOT,
        check=True,
        stdout=subprocess.PIPE,
    ).stdout
    return {
        item.decode("utf-8")
        for item in output.split(b"\0")
        if item and (ROOT / item.decode("utf-8")).is_file()
    }


def digest(path: Path) -> str:
    hasher = hashlib.sha256()
    with path.open("rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            hasher.update(chunk)
    return hasher.hexdigest()


def main() -> int:
    tracked = tracked_files()
    media = {
        path
        for path in tracked
        if any(path.lower().endswith(suffix) for suffix in MEDIA_SUFFIXES)
        and not path.startswith(IMMUTABLE_ARCHIVE_PREFIXES)
    }
    expected = {
        path: expected
        for path, expected in EXPECTED.items()
        if not path.startswith(IMMUTABLE_ARCHIVE_PREFIXES)
    }
    assert media == set(expected), (
        f"unclassified={sorted(media - set(expected))} "
        f"missing={sorted(set(expected) - media)}"
    )
    for relative, expected_digest in expected.items():
        actual = digest(ROOT / relative)
        assert actual == expected_digest, f"artifact hash drift: {relative}: {actual}"
    wasm_paths = [
        ROOT / "wallet-web/src/wasm/postfiat_wallet_wasm_bg.wasm",
        ROOT / "wallet-extension/wasm/postfiat_wallet_wasm_bg.wasm",
    ]
    assert wasm_paths[0].read_bytes() == wasm_paths[1].read_bytes(), (
        "web and extension wallet WASM artifacts differ"
    )
    for relative in (
        "wallet-web/src/wasm/postfiat_wallet_wasm.js",
        "wallet-web/src/wasm/postfiat_wallet_wasm.d.ts",
        "wallet-extension/wasm/postfiat_wallet_wasm.js",
        "wallet-extension/wasm/postfiat_wallet_wasm.d.ts",
    ):
        assert "wallet_sign_pftl_swap_intent" in (ROOT / relative).read_text(
            encoding="utf-8"
        ), f"generated wallet binding lacks browser-local private-primary signing: {relative}"
    print(
        "public_artifact_policy=ok "
        f"classified={len(media)} max_bytes={max((ROOT / item).stat().st_size for item in media)}"
    )
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
