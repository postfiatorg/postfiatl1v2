#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
identity="$repo_root/tools/nav-reserve-proof/manifests/a666/reader-deployment-candidates.json"

jq -e '
  .schema == "postfiat.a666.public_reader_deployment_candidates.v1" and
  .status == "deployment_required" and
  .hyperliquid.deployment_status == "not_deployed" and
  .near.deployment_status == "not_deployed" and
  .solana.deployment_status == "not_deployed" and
  (.hyperliquid.historical_reader_is_candidate | not) and
  (.near.historical_reader_is_candidate | not)
' "$identity" >/dev/null

forge build --root "$repo_root/crates/ethereum-contracts" >/dev/null 2>&1
hyper_runtime="$(
  forge inspect \
    --root "$repo_root/crates/ethereum-contracts" \
    src/HyperCoreReserveReader.sol:HyperCoreReserveReader \
    deployedBytecode
)"
hyper_bytes="$(( (${#hyper_runtime} - 2) / 2 ))"
hyper_hash="$(cast keccak "$hyper_runtime")"
test "$hyper_bytes" = "$(jq -r .hyperliquid.candidate_runtime_bytes "$identity")"
test "${hyper_hash#0x}" = "$(jq -r .hyperliquid.candidate_runtime_keccak256 "$identity")"

rustup target add wasm32-unknown-unknown >/dev/null 2>&1
# Rust and dependency panic locations otherwise embed runner-specific absolute
# paths in the Wasm. Remap the checkout, toolchain/cache home, and an installed
# rust-src tree to the compiler's canonical /rustc/<commit> source prefix. The
# last mapping matters on builders which have the optional rust-src component.
near_toolchain="1.95.0"
near_rust_sysroot="$(rustc +"$near_toolchain" --print sysroot)"
near_rust_commit="$(rustc +"$near_toolchain" -Vv | awk '/^commit-hash:/{print $2}')"
test -n "$near_rust_commit"
near_rustflags="--remap-path-prefix=$repo_root=/workspace/postfiatl1v2 --remap-path-prefix=$HOME=/workspace/home --remap-path-prefix=$near_rust_sysroot/lib/rustlib/src/rust=/rustc/$near_rust_commit"
RUSTFLAGS="$near_rustflags" cargo +"$near_toolchain" build \
  --manifest-path "$repo_root/tools/nav-reserve-proof/contracts/near-stake-reader/Cargo.toml" \
  --target wasm32-unknown-unknown \
  --release \
  --locked >/dev/null
near_wasm="$repo_root/tools/nav-reserve-proof/contracts/near-stake-reader/target/wasm32-unknown-unknown/release/postfiat_near_stake_reader.wasm"
near_bytes="$(wc -c < "$near_wasm" | tr -d ' ')"
near_hash="$(sha256sum "$near_wasm" | cut -d' ' -f1)"
expected_near_bytes="$(jq -r .near.candidate_wasm_bytes "$identity")"
expected_near_hash="$(jq -r .near.candidate_wasm_sha256 "$identity")"
if test "$near_bytes" != "$expected_near_bytes" || test "$near_hash" != "$expected_near_hash"; then
  printf 'NEAR reader identity mismatch: bytes=%s expected_bytes=%s sha256=%s expected_sha256=%s\n' \
    "$near_bytes" "$expected_near_bytes" "$near_hash" "$expected_near_hash" >&2
  exit 1
fi

solana_identity="$repo_root/$(jq -r .solana.identity "$identity")"
test "$(jq -r .executable_program_hash "$solana_identity")" = \
  "$(jq -r .solana.candidate_executable_program_hash "$identity")"
test "$(jq -r .raw_elf_sha256 "$solana_identity")" = \
  "$(jq -r .solana.candidate_raw_elf_sha256 "$identity")"
test "$(jq -r .raw_elf_bytes "$solana_identity")" = \
  "$(jq -r .solana.candidate_raw_elf_bytes "$identity")"

printf 'A666 public reader candidates match pinned public builds; all three still require new deployments.\n'
