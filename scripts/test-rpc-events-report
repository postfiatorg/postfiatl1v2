#!/usr/bin/env bash
# Tests for scripts/rpc-events-report.
#
# Synthetic fixtures are generated here and labelled: node_id
# "synthetic-validator-0" and ids "synthetic-N". They follow the
# postfiat-rpc-serve-event-v1 record (crates/node/src/rpc_cli.rs).
#
# Optional real capture: set RPC_EVENTS_NODE_BIN to a published postfiat-node
# release binary and RPC_EVENTS_NODE_SHA256 to its published sha256. The test
# refuses a binary whose hash differs, starts `rpc-serve` on 127.0.0.1 over a
# throwaway data dir, sends real requests and checks the report against the
# event log it wrote. RPC_EVENTS_NODE_LAUNCHER (optional) is a command prefix,
# e.g. a dynamic loader for a host whose glibc is older than the release's.
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TOOL="$ROOT/scripts/rpc-events-report"
WORK="$(mktemp -d)"
SERVE_PID=""
cleanup() {
  if [ -n "$SERVE_PID" ]; then kill "$SERVE_PID" 2>/dev/null || true; fi
  rm -rf "$WORK"
}
trap cleanup EXIT

for tool in python3 jq gzip; do
  command -v "$tool" >/dev/null 2>&1 || {
    echo "$tool is required" >&2
    exit 1
  }
done

PASSES=0
FAILS=0
pass() {
  PASSES=$((PASSES + 1))
  echo "PASS $1"
}
fail() {
  FAILS=$((FAILS + 1))
  echo "FAIL $1${2:+: $2}"
}
check_eq() { # name actual expected
  if [ "$2" = "$3" ]; then pass "$1 ($2)"; else fail "$1" "got '$2' want '$3'"; fi
}

# report OUT_PREFIX ARGS... -> OUT_PREFIX.out, OUT_PREFIX.err, OUT_PREFIX.rc
report() {
  local prefix=$1
  shift
  local rc=0
  python3 "$TOOL" "$@" >"$prefix.out" 2>"$prefix.err" || rc=$?
  echo "$rc" >"$prefix.rc"
}
rc_of() { cat "$1.rc"; }
jqv() { jq -r "$2" "$1.out"; }

# gen FILE COUNT PEER METHOD OK [ERROR_CODE] [HANDLER_MS]: append labelled synthetic records
gen() {
  python3 - "$@" <<'PY'
import json, sys
path, count, peer, method, ok = sys.argv[1], int(sys.argv[2]), sys.argv[3], sys.argv[4], sys.argv[5] == "true"
code = sys.argv[6] if len(sys.argv) > 6 and sys.argv[6] else None
handler_ms = float(sys.argv[7]) if len(sys.argv) > 7 else None
counter = path + ".synthetic-counter"
try:
    start = int(open(counter).read())
except FileNotFoundError:
    start = 0
with open(path, "a") as out:
    for n in range(start, start + count):
        record = {"schema": "postfiat-rpc-serve-event-v1", "node_id": "synthetic-validator-0",
                  "request_index": n + 1, "peer_addr": peer, "id": f"synthetic-{n + 1}",
                  "method": method, "ok": ok}
        if handler_ms is not None:
            record.update(handler_mode="inline", handler_ms=handler_ms)
        if code:
            record.update(error_code=code, error_class="synthetic")
        out.write(json.dumps(record, separators=(",", ":")) + "\n")
open(counter, "w").write(str(start + count))
PY
}

echo "== tool $(sha256sum "$TOOL" | cut -d' ' -f1)"

# ---------------------------------------------------------------- real capture
if [ -n "${RPC_EVENTS_NODE_BIN:-}" ]; then
  echo "== real capture: postfiat-node rpc-serve on 127.0.0.1"
  [ -n "${RPC_EVENTS_NODE_SHA256:-}" ] || {
    echo "RPC_EVENTS_NODE_SHA256 is required with RPC_EVENTS_NODE_BIN" >&2
    exit 1
  }
  actual_sha="$(sha256sum "$RPC_EVENTS_NODE_BIN" | cut -d' ' -f1)"
  echo "binary sha256 $actual_sha expected $RPC_EVENTS_NODE_SHA256"
  if [ "$actual_sha" != "$RPC_EVENTS_NODE_SHA256" ]; then
    fail "release binary sha256" "refusing to run an unverified binary"
    echo "RESULT: FAIL ($PASSES passed, $FAILS failed)"
    exit 1
  fi
  pass "release binary sha256 matches"
  read -r -a launcher <<<"${RPC_EVENTS_NODE_LAUNCHER:-}"
  node=("${launcher[@]}" "$RPC_EVENTS_NODE_BIN")
  "${node[@]}" init --data-dir "$WORK/node" --validators 1 >"$WORK/init.out" 2>&1 || {
    fail "postfiat-node init" "$(tail -3 "$WORK/init.out")"
    exit 1
  }
  port="$(python3 -c 'import socket; s=socket.socket(); s.bind(("127.0.0.1", 0)); print(s.getsockname()[1])')"
  real_log="$WORK/real/rpc-events.ndjson"
  mkdir -p "$WORK/real"
  "${node[@]}" rpc-serve --unsafe-devnet-json-storage --data-dir "$WORK/node" --bind-host 127.0.0.1 \
    --port "$port" --max-requests 9 --timeout-ms 5000 --child-timeout-ms 20000 \
    --event-log "$real_log" >"$WORK/serve.out" 2>"$WORK/serve.err" &
  SERVE_PID=$!
  python3 - "$port" <<'PY'
import json, socket, sys, time
port = int(sys.argv[1])
deadline = time.time() + 30
while True:
    try:
        socket.create_connection(("127.0.0.1", port), timeout=1).close()
        break
    except OSError:
        if time.time() > deadline:
            raise SystemExit("rpc-serve did not listen")
        time.sleep(0.2)
# the probe connection above is request 1 (an empty read)
def req(i, method):
    return json.dumps({"version": "postfiat-local-rpc-v1", "id": f"capture-{i}", "method": method, "params": {}})
lines = [req(2, "status"), req(3, "status"), req(4, "status"), req(5, "status"), req(6, "server_info"),
         "this is not json", req(8, "no_such_method"), "x" * 70000]
for line in lines:
    reply = b""
    with socket.create_connection(("127.0.0.1", port), timeout=30) as s:
        try:
            s.sendall(line.encode() + b"\n")
            s.shutdown(socket.SHUT_WR)
        except OSError as error:  # the server may close after its request size limit
            print("send stopped:", error.__class__.__name__)
        try:
            while chunk := s.recv(65536):
                reply += chunk
        except OSError as error:
            print("recv stopped:", error.__class__.__name__)
    if not reply:
        print("sent", line[:40], "-> no reply")
        continue
    first = json.loads(reply.decode().splitlines()[0])
    print("sent", line[:40], "->", "ok" if first.get("ok") else (first.get("error") or {}).get("code"))
PY
  wait "$SERVE_PID" || true
  SERVE_PID=""
  echo "-- captured event log ($(wc -l <"$real_log") lines):"
  cat "$real_log"
  report "$WORK/r1" summary --json "$real_log"
  check_eq "real: summary exit" "$(rc_of "$WORK/r1")" 0
  check_eq "real: events = log lines" "$(jqv "$WORK/r1" .events)" "$(wc -l <"$real_log" | tr -d ' ')"
  check_eq "real: bad lines" "$(jqv "$WORK/r1" .bad_lines.total)" 0
  for method in status server_info invalid no_such_method; do
    want="$(jq -s --arg m "$method" '[.[] | select(.method == $m)] | length' "$real_log")"
    got="$(jq -r --arg m "$method" '[.by_method.top[] | select(.key == $m) | .count] | add // 0' "$WORK/r1.out")"
    check_eq "real: method $method count matches jq" "$got" "$want"
  done
  want="$(jq -s '[.[] | select(.ok | not)] | length' "$real_log")"
  check_eq "real: errors match jq" "$(jqv "$WORK/r1" .errors)" "$want"
  for code in $(jq -r 'select(.error_code) | .error_code' "$real_log" | sort -u); do
    want="$(jq -s --arg c "$code" '[.[] | select(.error_code == $c)] | length' "$real_log")"
    got="$(jq -r --arg c "$code" '[.by_error_code.top[] | select(.key == $c) | .count] | add // 0' "$WORK/r1.out")"
    check_eq "real: error_code $code matches jq" "$got" "$want"
  done
  report "$WORK/r2" check --max-peer-method 3 "$real_log"
  cat "$WORK/r2.out"
  check_eq "real: flood check exit" "$(rc_of "$WORK/r2")" 1
  if grep -q '^BREACH max_peer_method value 4 limit 3 peer 127.0.0.1 method status$' "$WORK/r2.out"; then
    pass "real: breach names peer 127.0.0.1 and method status"
  else
    fail "real: breach line" "$(grep BREACH "$WORK/r2.out" || true)"
  fi
  report "$WORK/r3" check --max-peer-method 4 "$real_log"
  check_eq "real: same log within limit 4 exit" "$(rc_of "$WORK/r3")" 0
else
  echo "== real capture SKIPPED (set RPC_EVENTS_NODE_BIN and RPC_EVENTS_NODE_SHA256)"
fi

# ---------------------------------------------------------------- flood fixture
echo "== synthetic: flood"
F="$WORK/flood.ndjson"
gen "$F" 400 10.0.0.5 owned_apply_v3 true "" 1.5
gen "$F" 30 10.0.0.6 status true
gen "$F" 5 10.0.0.6 status false rpc_internal
report "$WORK/f1" check --max-peer-method 100 --max-errors 10 "$F"
cat "$WORK/f1.out"
check_eq "flood: exit" "$(rc_of "$WORK/f1")" 1
if grep -q '^BREACH max_peer_method value 400 limit 100 peer 10.0.0.5 method owned_apply_v3$' "$WORK/f1.out"; then
  pass "flood: breach names peer 10.0.0.5 and method owned_apply_v3"
else
  fail "flood: breach line" "$(grep BREACH "$WORK/f1.out" || true)"
fi
if grep -q '^OK max_errors value 5 limit 10$' "$WORK/f1.out"; then
  pass "flood: unrelated check stays OK"
else
  fail "flood: unrelated check" "$(grep max_errors "$WORK/f1.out")"
fi

echo "== synthetic: normal traffic passes"
N="$WORK/normal.ndjson"
gen "$N" 40 10.0.0.6 status true
gen "$N" 40 10.0.0.7 status true
gen "$N" 20 10.0.0.7 server_info true
gen "$N" 2 10.0.0.7 tx false rpc_not_found
report "$WORK/n1" check --max-peer-method 50 --max-method 90 --max-peer 70 --max-errors 2 \
  --max-error-ratio 0.05 --max-bad-lines 0 "$N"
cat "$WORK/n1.out"
check_eq "normal: exit" "$(rc_of "$WORK/n1")" 0
check_eq "normal: checks all ok" "$(jq -r '[.checks[].status] | unique | join(",")' < <(python3 "$TOOL" check --json \
  --max-peer-method 50 --max-method 90 --max-peer 70 --max-errors 2 --max-error-ratio 0.05 --max-bad-lines 0 "$N"))" ok

# ---------------------------------------------------------------- each threshold, boundary and control
echo "== synthetic: every threshold at its limit (exit 0) and one below (exit 1)"
# normal.ndjson: worst peer+method 40, worst method status 80, worst peer 10.0.0.7 62,
# errors 2, error ratio 2/102, bad lines 0 (+1 below via an appended bad line)
cp "$N" "$WORK/bad.ndjson"
printf '%s\n' '{"schema":"postfiat-rpc-serve-event-v1","node_id":"synthetic-validator-0",' >>"$WORK/bad.ndjson"
threshold_case() { # name flag limit_ok limit_breach expected_key file
  local name=$1 flag=$2 at=$3 below=$4 key=$5 file=${6:-$N}
  report "$WORK/t-$name-ok" check --json "$flag" "$at" "$file"
  report "$WORK/t-$name-br" check --json "$flag" "$below" "$file"
  check_eq "$name: at limit $at exit" "$(rc_of "$WORK/t-$name-ok")" 0
  check_eq "$name: limit $below exit" "$(rc_of "$WORK/t-$name-br")" 1
  check_eq "$name: breach check named" "$(jqv "$WORK/t-$name-br" "[.checks[] | select(.status == \"breach\") | .name] | join(\",\")")" "$name"
  if [ -n "$key" ]; then
    check_eq "$name: breach names" "$(jqv "$WORK/t-$name-br" "[.checks[0] | (.peer // empty), (.method // empty)] | join(\" \")")" "$key"
  fi
}
threshold_case max_peer_method --max-peer-method 40 39 "10.0.0.6 status"
threshold_case max_method --max-method 80 79 "status"
threshold_case max_peer --max-peer 62 61 "10.0.0.7"
threshold_case max_errors --max-errors 2 1 ""
threshold_case max_error_ratio --max-error-ratio 0.0197 0.0196 ""
threshold_case max_bad_lines --max-bad-lines 1 0 "" "$WORK/bad.ndjson"
report "$WORK/ratio-skip" check --json --max-error-ratio 0 --min-events 103 "$N"
check_eq "max_error_ratio: below --min-events is skipped" "$(rc_of "$WORK/ratio-skip"):$(jqv "$WORK/ratio-skip" '.checks[0].status')" "0:skipped"

echo "== synthetic: method filter"
report "$WORK/m1" check --json --method server_info --method tx --max-method 20 "$N"
check_eq "filter: events counted" "$(jqv "$WORK/m1" .events)" 22
check_eq "filter: filtered_out" "$(jqv "$WORK/m1" .filtered_out)" 80
check_eq "filter: exit (status flood not counted)" "$(rc_of "$WORK/m1")" 0

echo "== synthetic: capped key tables"
K="$WORK/keys.ndjson"
gen "$K" 3 10.0.1.1 status true
gen "$K" 3 10.0.1.2 status true
gen "$K" 5 10.0.1.3 status true
gen "$K" 4 10.0.1.4 status true
report "$WORK/k1" check --json --max-keys 2 --max-peer 8 "$K"
check_eq "cap: distinct peers kept" "$(jqv "$WORK/k1" .by_peer.distinct)" 2
check_eq "cap: pooled events" "$(jqv "$WORK/k1" .by_peer.other)" 9
check_eq "cap: dropped keys" "$(jqv "$WORK/k1" .by_peer.dropped_keys)" 2
check_eq "cap: pooled count over limit is a breach" "$(rc_of "$WORK/k1"):$(jqv "$WORK/k1" '.checks[0].peer')" "1:(other)"
report "$WORK/k2" check --json --max-keys 2 --max-peer 9 "$K"
check_eq "cap: pooled count at limit passes" "$(rc_of "$WORK/k2")" 0

# ---------------------------------------------------------------- malformed input
echo "== synthetic: torn, bad JSON, wrong schema, oversize"
B="$WORK/malformed.ndjson"
gen "$B" 3 10.0.0.8 status true
{
  printf '%s\n' '{"schema":"postfiat-rpc-serve-event-v1","node_id":"synth' # torn mid-file
  printf '%s\n' '[1,2,3]' '{"schema":"other-v1","method":"status","peer_addr":"x","ok":true}'
  printf '%s\n' '{"schema":"postfiat-rpc-serve-event-v1","method":7,"peer_addr":"x","ok":true}'
  python3 -c 'import sys; sys.stdout.write("{\"pad\":\"" + "y" * 600 + "\"}\n")'
  printf '\xff\xfe\n'
} >>"$B"
gen "$B" 2 10.0.0.8 status true
printf '%s' '{"schema":"postfiat-rpc-serve-event-v1","node_id":"synthetic-validator-0","request_index":99,' >>"$B"
report "$WORK/b1" summary --json --max-line-bytes 200 "$B"
check_eq "malformed: exit" "$(rc_of "$WORK/b1")" 0
check_eq "malformed: events" "$(jqv "$WORK/b1" .events)" 5
check_eq "malformed: bad_json (torn mid-file + invalid utf-8)" "$(jqv "$WORK/b1" .bad_lines.bad_json)" 2
check_eq "malformed: wrong_schema (array, other schema, non-string method)" "$(jqv "$WORK/b1" .bad_lines.wrong_schema)" 3
check_eq "malformed: oversize" "$(jqv "$WORK/b1" .bad_lines.oversize)" 1
check_eq "malformed: torn tail" "$(jqv "$WORK/b1" .bad_lines.torn)" 1
check_eq "malformed: lines" "$(jqv "$WORK/b1" .lines)" 12
report "$WORK/b2" check --max-bad-lines 7 --max-line-bytes 200 "$B"
check_eq "malformed: --max-bad-lines 7 exit" "$(rc_of "$WORK/b2")" 0
report "$WORK/b3" check --max-bad-lines 6 --max-line-bytes 200 "$B"
check_eq "malformed: --max-bad-lines 6 exit" "$(rc_of "$WORK/b3")" 1

echo "== incremental: a torn tail is left for the next run and counted once"
L="$WORK/inc/rpc-events.ndjson"
S="$WORK/inc/state.json"
mkdir -p "$WORK/inc"
gen "$L" 4 10.0.0.9 status true
printf '%s' '{"schema":"postfiat-rpc-serve-event-v1","node_id":"synthetic-validator-0","request_index":5,' >>"$L"
report "$WORK/i1" check --json --state "$S" "$L"
check_eq "torn tail: first run events" "$(jqv "$WORK/i1" .events)" 4
check_eq "torn tail: not counted as bad while live" "$(jqv "$WORK/i1" .bad_lines.total)" 0
printf '%s\n' '"peer_addr":"10.0.0.9","id":"synthetic-5","method":"status","ok":true}' >>"$L"
report "$WORK/i2" check --json --state "$S" "$L"
check_eq "torn tail: completed line counted on the next run" "$(jqv "$WORK/i2" .events):$(jqv "$WORK/i2" .bad_lines.total)" "1:0"
report "$WORK/i3" check --json --state "$S" "$L"
check_eq "no new lines: events" "$(jqv "$WORK/i3" .events)" 0

# ---------------------------------------------------------------- rotation
rotation_case() { # name: sets up L/S, runs, compares events with expected
  check_eq "$1: events counted exactly once" "$(jqv "$2" .events)" "$3"
  check_eq "$1: rotated" "$(jqv "$2" .rotated)" true
  check_eq "$1: no gap" "$(jqv "$2" .gap)" false
  check_eq "$1: exit" "$(rc_of "$2")" 0
}
echo "== rotation: copytruncate + compress"
R="$WORK/rot1"
mkdir -p "$R"
L="$R/rpc-events.ndjson"
S="$R/rpc-events.ndjson.state"
gen "$L" 10 10.0.0.10 status true
report "$WORK/c0" check --json --state "$S" "$L"
check_eq "copytruncate: first run" "$(jqv "$WORK/c0" .events)" 10
gen "$L" 5 10.0.0.10 status true
cp "$L" "$L.1" && : >"$L" && gzip "$L.1"
gen "$L" 3 10.0.0.10 status true
report "$WORK/c1" check --json --state "$S" "$L"
rotation_case "copytruncate+gz" "$WORK/c1" 8
check_eq "copytruncate+gz: read the rotated file from the old offset" "$(jqv "$WORK/c1" '.segments[0].path | endswith(".1.gz")'):$(jqv "$WORK/c1" '.segments[0].start > 0')" "true:true"
echo "== rotation: live file regrows past the old offset before the check"
gen "$L" 2 10.0.0.10 status true
cp "$L" "$L.1" && : >"$L" && gzip -f "$L.1"
gen "$L" 40 10.0.0.10 status true
report "$WORK/c2" check --json --state "$S" "$L"
rotation_case "regrown copytruncate" "$WORK/c2" 42
echo "== rotation: rename (create) and two rotations between runs"
gen "$L" 6 10.0.0.10 status true
mv "$L.1.gz" "$L.2.gz"
mv "$L" "$L.1" && gen "$L" 7 10.0.0.10 status true
sleep 0.05
gzip "$L.1"
mv "$L.2.gz" "$L.3.gz" && mv "$L.1.gz" "$L.2.gz"
touch -d '-2 seconds' "$L.3.gz"
touch -d '-1 seconds' "$L.2.gz"
mv "$L" "$L.1" && gen "$L" 9 10.0.0.10 status true
touch -d '-0.5 seconds' "$L.1"
report "$WORK/c3" check --json --state "$S" "$L"
rotation_case "rename x2" "$WORK/c3" 22
check_eq "rename x2: segments read" "$(jqv "$WORK/c3" '[.segments[].path | split("/") | last] | join(" ")')" \
  "rpc-events.ndjson.2.gz rpc-events.ndjson.1 rpc-events.ndjson"
echo "== rotation: a copy of the same file (FILE.1 while FILE.1.gz is written) is not counted twice"
gen "$L" 3 10.0.0.10 status true
cp "$L" "$L.1" && : >"$L" && gzip -c "$L.1" >"$L.1.gz"
touch -d '-1 seconds' "$L.1"
gen "$L" 1 10.0.0.10 status true
report "$WORK/c4" check --json --state "$S" "$L"
rotation_case "duplicate copy" "$WORK/c4" 4
echo "== rotation: rename where the new file starts with the same bytes (rpc-serve restarted)"
R="$WORK/rot2"
mkdir -p "$R"
L="$R/rpc-events.ndjson"
S="$R/state.json"
first='{"schema":"postfiat-rpc-serve-event-v1","node_id":"synthetic-validator-0","request_index":1,"peer_addr":"127.0.0.1","id":"synthetic-remote-1","method":"invalid","ok":false,"error_code":"rpc_read_error"}'
printf '%s\n' "$first" >"$L"
report "$WORK/d0" check --json --state "$S" "$L"
mv "$L" "$L.1"
printf '%s\n' "$first" >"$L"
gen "$L" 2 10.0.0.10 status true
report "$WORK/d1" check --json --state "$S" "$L"
rotation_case "same-head rename" "$WORK/d1" 3
L="$WORK/rot1/rpc-events.ndjson"
S="$WORK/rot1/rpc-events.ndjson.state"
echo "== rotation: position lost -> continuity breach"
gen "$L" 2 10.0.0.10 status true
rm -f "$L".[0-9]*
: >"$L" && gen "$L" 5 10.0.0.10 status true
report "$WORK/c5" check --json --state "$S" "$L"
check_eq "gap: exit" "$(rc_of "$WORK/c5")" 1
check_eq "gap: continuity breach" "$(jqv "$WORK/c5" '[.gap, (.checks[] | select(.name == "continuity") | .status)] | join(",")')" "true,breach"
check_eq "gap: live file still counted" "$(jqv "$WORK/c5" .events)" 5
report "$WORK/c6" check --json --state "$S" "$L"
check_eq "gap: next run is clean" "$(rc_of "$WORK/c6"):$(jqv "$WORK/c6" .events)" "0:0"

if command -v logrotate >/dev/null 2>&1; then
  echo "== rotation: real logrotate with ops/validator-host/logrotate/postfiat-rpc-events"
  R="$WORK/lr"
  mkdir -p "$R/validator-0"
  L="$R/validator-0/rpc-events.ndjson"
  S="$R/state.json"
  sed -e "s#/var/log/postfiat/validator-\*/rpc-events.ndjson#$R/validator-*/rpc-events.ndjson#" \
    -e 's/size 512M/size 1k/' "$ROOT/ops/validator-host/logrotate/postfiat-rpc-events" >"$R/rule"
  echo "-- rule under test:"
  cat "$R/rule"
  total=0
  gen "$L" 12 10.0.0.11 status true
  report "$WORK/l0" check --json --state "$S" "$L"
  total=$((total + $(jqv "$WORK/l0" .events)))
  for round in 1 2 3 4; do
    gen "$L" $((round * 9)) 10.0.0.11 status true
    logrotate -s "$R/logrotate.status" "$R/rule"
    gen "$L" "$round" 10.0.0.11 status true
    report "$WORK/l$round" check --json --state "$S" "$L"
    check_eq "logrotate round $round: rc,gap" "$(rc_of "$WORK/l$round"),$(jqv "$WORK/l$round" .gap)" "0,false"
    total=$((total + $(jqv "$WORK/l$round" .events)))
  done
  echo "-- after rotation: $(find "$R/validator-0" -type f -printf '%f %s\n' | sort | tr '\n' ' ')"
  written="$(cat "$L.synthetic-counter")"
  check_eq "logrotate: events over 5 runs = lines written" "$total" "$written"
else
  echo "== rotation with real logrotate SKIPPED (logrotate not installed)"
fi

# ---------------------------------------------------------------- state handling
echo "== state: reuse, corruption, locking, start-at-end"
A="$WORK/st/a.ndjson"
Bf="$WORK/st/b.ndjson"
S="$WORK/st/state.json"
mkdir -p "$WORK/st"
gen "$A" 3 10.0.0.12 status true
gen "$Bf" 3 10.0.0.12 status true
report "$WORK/s0" check --state "$S" "$A"
before="$(sha256sum "$S" | cut -d' ' -f1)"
report "$WORK/s1" check --state "$S" "$Bf"
check_eq "reused state for another log: exit" "$(rc_of "$WORK/s1")" 2
if grep -q "belongs to" "$WORK/s1.err"; then
  pass "reused state: reason given"
else
  fail "reused state: reason" "$(cat "$WORK/s1.err")"
fi
check_eq "reused state: state unchanged" "$(sha256sum "$S" | cut -d' ' -f1)" "$before"
echo '{"schema":"postfiat-rpc-events-report-state-v1","path":' >"$WORK/st/corrupt.json"
report "$WORK/s2" check --state "$WORK/st/corrupt.json" "$A"
check_eq "corrupt state: exit" "$(rc_of "$WORK/s2")" 2
jq -c '.fp_len = .offset + 1' "$S" >"$WORK/st/bad-fp.json"
report "$WORK/s3" check --state "$WORK/st/bad-fp.json" "$A"
check_eq "state fingerprint longer than its offset: exit" "$(rc_of "$WORK/s3")" 2
jq -c '.offset = 999999' "$S" >"$WORK/st/far.json"
report "$WORK/s3a" check --json --state "$WORK/st/far.json" "$A"
check_eq "state offset past the end and no rotated copy: continuity breach" "$(rc_of "$WORK/s3a"):$(jqv "$WORK/s3a" .gap)" "1:true"
jq -c '.offset = -1' "$S" >"$WORK/st/neg.json"
report "$WORK/s3b" check --state "$WORK/st/neg.json" "$A"
check_eq "negative offset: exit" "$(rc_of "$WORK/s3b")" 2
python3 - "$S" "$TOOL" "$A" <<'PY' >"$WORK/s4.out"
import fcntl, subprocess, sys
state, tool, log = sys.argv[1:]
with open(state + ".lock", "a") as lock:
    fcntl.flock(lock, fcntl.LOCK_EX)
    print(subprocess.run([sys.executable, tool, "check", "--state", state, log], capture_output=True).returncode)
PY
check_eq "locked state: exit" "$(cat "$WORK/s4.out")" 2
C="$WORK/st/c.ndjson"
gen "$C" 7 10.0.0.12 status true
printf '%s' '{"schema":"postfiat-rpc-serve-event-v1","node_id":"synthetic-validator-0",' >>"$C"
report "$WORK/s5" check --json --start-at-end --state "$WORK/st/c.state" "$C"
check_eq "start-at-end: existing lines skipped" "$(jqv "$WORK/s5" .events)" 0
printf '%s\n' '"request_index":8,"peer_addr":"10.0.0.12","id":"synthetic-8","method":"status","ok":true}' >>"$C"
report "$WORK/s6" check --json --state "$WORK/st/c.state" "$C"
check_eq "start-at-end: the partial line is counted once completed" "$(jqv "$WORK/s6" .events)" 1

echo "== usage errors exit 2"
report "$WORK/u1" check --state "$S" "$A" "$Bf"
check_eq "two files with --state" "$(rc_of "$WORK/u1")" 2
report "$WORK/u2" summary "$WORK/missing.ndjson"
check_eq "missing file" "$(rc_of "$WORK/u2")" 2
report "$WORK/u3" check --start-at-end "$A"
check_eq "--start-at-end without --state" "$(rc_of "$WORK/u3")" 2
report "$WORK/u4" check --max-errors -1 "$A"
check_eq "negative limit" "$(rc_of "$WORK/u4")" 2
printf 'not gzip' >"$WORK/st/fake.gz"
report "$WORK/u5" summary "$WORK/st/fake.gz"
check_eq "corrupt gzip" "$(rc_of "$WORK/u5")" 2

# ---------------------------------------------------------------- output schema
echo "== output schema"
report "$WORK/o1" check --json --max-errors 0 "$N"
check_eq "schema" "$(jqv "$WORK/o1" .schema)" postfiat-rpc-events-report-v1
check_eq "top-level keys" "$(jqv "$WORK/o1" 'keys | join(",")')" \
  "bad_lines,by_error_code,by_method,by_peer,by_peer_method,checks,errors,event_schema,events,exit_code,filtered_out,gap,handler_ms,key_cap,lines,method_filter,mode,ok,rotated,schema,segments,verdict"
check_eq "table keys" "$(jqv "$WORK/o1" '.by_method | keys | join(",")')" "distinct,dropped_keys,other,top"
check_eq "peer+method row keys" "$(jqv "$WORK/o1" '.by_peer_method.top[0] | keys | join(",")')" "count,method,peer"
check_eq "check row keys" "$(jqv "$WORK/o1" '.checks[0] | keys | join(",")')" "limit,name,status,value"
check_eq "exit_code field = process exit" "$(jqv "$WORK/o1" .exit_code)" "$(rc_of "$WORK/o1")"
check_eq "verdict" "$(jqv "$WORK/o1" .verdict)" breach
check_eq "handler_ms (json)" "$(python3 "$TOOL" summary --json "$F" | jq -r '[.handler_ms.count, .handler_ms.max] | join(",")')" "400,1.5"

# ---------------------------------------------------------------- bounded memory
echo "== bounded memory: 300000 events, 300000 distinct peers, --max-keys 1000"
python3 - "$WORK/big.ndjson" <<'PY'
import json, sys
with open(sys.argv[1], "w") as out:
    for n in range(300000):
        out.write(json.dumps({"schema": "postfiat-rpc-serve-event-v1", "node_id": "synthetic-validator-0",
                              "request_index": n + 1, "peer_addr": f"10.{n >> 16 & 255}.{n >> 8 & 255}.{n & 255}",
                              "id": f"synthetic-{n + 1}", "method": f"m{n % 50000}", "ok": True},
                             separators=(",", ":")) + "\n")
PY
python3 - "$TOOL" "$WORK/big.ndjson" >"$WORK/mem.out" <<'PY'
import resource, subprocess, sys
proc = subprocess.run([sys.executable, sys.argv[1], "summary", "--json", "--max-keys", "1000", sys.argv[2]],
                      capture_output=True)
print(proc.returncode, resource.getrusage(resource.RUSAGE_CHILDREN).ru_maxrss)
sys.stdout.flush()
open(sys.argv[2] + ".report", "wb").write(proc.stdout)
PY
read -r mem_rc mem_kb <"$WORK/mem.out"
echo "file $(du -k "$WORK/big.ndjson" | cut -f1) KiB, peak RSS ${mem_kb} KiB"
check_eq "big: exit" "$mem_rc" 0
check_eq "big: events" "$(jq -r .events "$WORK/big.ndjson.report")" 300000
check_eq "big: peers table capped" "$(jq -r '[.by_peer.distinct, .by_peer.other] | join(",")' "$WORK/big.ndjson.report")" "1000,299000"
if [ "$mem_kb" -lt 65536 ]; then pass "big: peak RSS ${mem_kb} KiB < 64 MiB"; else fail "big: peak RSS" "${mem_kb} KiB"; fi

if [ "$FAILS" -eq 0 ]; then
  echo "RESULT: PASS ($PASSES passed, 0 failed)"
else
  echo "RESULT: FAIL ($PASSES passed, $FAILS failed)"
  exit 1
fi
