#!/usr/bin/env bash
set -Eeuo pipefail

repo=$(cd "$(dirname "$0")/.." && pwd)
output=${1:-"$repo/docs/evidence/a666-public-reserve-product-20260803/browser/r4-construction/return-stage-terminal.json"}
return_import="$repo/scripts/a666-mainnet-return-import.sh"

[[ -r "$return_import" ]]
[[ ! -e "$output" ]]

# Construction is loopback only. Reject the production mainnet/remote harness
# before any burn, proof, checkpoint vote, SSH, or credential read.
if sed -n '1,55p' "$return_import" | grep -q 'https://ethereum-rpc.publicnode.com\|root@\|operator_key='; then
  jq -n --arg script "scripts/a666-mainnet-return-import.sh" '{
    schema:"postfiat.a666.r4.return-artifact-stage-terminal.v1",
    outcome:"technical_wall",
    first_failing_check:"construction_return_import_harness_missing_loopback_parameterization",
    source_script:$script,
    required_production_steps:["browser/proxy return job and ReturnBurned event","ethereum-receipt-proof-build","BFT checkpoint certificate","certified pftl_uniswap_return_import"],
    blocking_production_assumptions:["external Ethereum RPC default","remote validator SSH topology","operator key-file submission"],
    attempted_command:"scripts/a666-r4-return-artifact-stage",
    transactions:0, proofs_generated:0, business_operations:0, live_chain:false, stakehub:false, credentials_accessed:false
  }' >"$output"
  exit 1
fi

printf "%s\n" "unexpectedly compatible return import harness; construction execution requires explicit review" >&2
exit 2
