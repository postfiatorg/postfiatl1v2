# Template. NOT installed, NOT enabled by the branch that ships it.
# Fires when nav-proof-watch.service exits nonzero (exit 2 = alarm fired,
# exit 3 = founder/operator input refused, exit 4 = read failure).
# The ExecStart below is deliberately a refusal: the real paging channel
# (mail, SMS, Task Node, etc.) must be named by the operator before this
# unit can do anything. Do not invent a channel.
[Unit]
Description=NAV proof-watch alarm notification (paging channel must be set)

[Service]
Type=oneshot
ExecStart=/usr/bin/env sh -c 'echo "nav-proof-watch raised an alarm; see /var/lib/nav-proof-watch/alarms.jsonl and journalctl -u nav-proof-watch.service" >&2; exit 1'
