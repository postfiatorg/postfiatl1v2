# Template. NOT installed, NOT enabled by the branch that ships it.
# Cadence: every 5 minutes (matches the wallet indexer's own 5-minute sample
# bound, so each observation sees a distinct live sample). Change only with
# the operator's recorded decision; do not silently stretch it.
[Unit]
Description=Run nav-proof-watch observation every 5 minutes

[Timer]
OnBootSec=2min
OnUnitActiveSec=5min
AccuracySec=30s
Unit=nav-proof-watch.service

[Install]
WantedBy=timers.target
