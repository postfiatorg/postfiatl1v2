run_grpc_python() {
  [[ $# -gt 0 ]] || die "grpc-python requires Python arguments"
  init_stack
  docker run --rm \
    --network "$NETWORK_NAME" \
    --read-only \
    --cap-drop=ALL \
    --security-opt=no-new-privileges:true \
    --user "$PFTL_DEMO_UID:$PFTL_DEMO_GID" \
    --tmpfs /tmp:rw,noexec,nosuid,nodev,size=16m \
    --volume "$PFTL_LN_STATE_DIR:/state:ro" \
    --volume "$REPO_ROOT:/workspace:ro" \
    --workdir /workspace \
    --env PFTL_LN_STATE_DIR=/state \
    --env PYTHONPATH=/opt/pftl-lnd-grpc:/workspace \
    "$GRPC_PYTHON_IMAGE" "$@"
}

grpc_python_smoke() {
  run_grpc_python /opt/pftl-lnd-grpc/smoke.py
}

capture_evidence() {
  setup_channels
  local destination="${1:-$EVIDENCE_ROOT/$(date -u +%Y%m%dT%H%M%SZ)}"
  if [[ "$destination" != /* ]]; then
    destination="$PWD/$destination"
  fi
  [[ "$destination" != "/" && "$destination" != "$HOME" ]] ||
    die "refusing unsafe evidence destination"
  install -d -m 0700 "$destination"

  status_json >"$destination/status.json"
  bitcoin_cli getblockchaininfo >"$destination/bitcoin-blockchain.json"
  bitcoin_cli getnetworkinfo >"$destination/bitcoin-network.json"
  bitcoin_cli getmempoolinfo >"$destination/bitcoin-mempool.json"
  compose ps --format json | jq -s . >"$destination/compose-ps.json"
  docker network inspect "$NETWORK_NAME" >"$destination/runtime-network.json"

  local node service cid
  for service in bitcoind lnd-user lnd-coordinator lnd-router; do
    cid="$(service_container_id "$service")"
    docker exec "$cid" /bin/sh -c 'cat /proc/net/route' \
      >"$destination/${service}-kernel-routes.txt"
  done
  for node in user coordinator router; do
    lnd_cli "$node" getinfo >"$destination/lnd-${node}-getinfo.json"
    lnd_cli "$node" walletbalance >"$destination/lnd-${node}-walletbalance.json"
    lnd_cli "$node" listchaintxns >"$destination/lnd-${node}-chain-transactions.json"
    lnd_cli "$node" listchannels >"$destination/lnd-${node}-channels.json"
    lnd_cli "$node" pendingchannels >"$destination/lnd-${node}-pending.json"
    lnd_cli "$node" listpeers >"$destination/lnd-${node}-peers.json"
    lnd_cli "$node" describegraph >"$destination/lnd-${node}-graph.json"
  done

  [[ ! -f "$SETUP_DIR/funding.json" ]] ||
    cp "$SETUP_DIR/funding.json" "$destination/setup-funding.json"
  for node in user-router router-coordinator; do
    [[ ! -f "$SETUP_DIR/channel-open-${node}.json" ]] ||
      cp "$SETUP_DIR/channel-open-${node}.json" \
        "$destination/setup-channel-${node}.json"
  done
  cp "$SETUP_DIR/image-verification.json" "$destination/image-verification.json"
  [[ ! -f "$SETUP_DIR/lightning-smoke.json" ]] ||
    cp "$SETUP_DIR/lightning-smoke.json" \
      "$destination/setup-lightning-smoke.json"
  grpc_python_smoke >"$destination/grpc-python-smoke.json"

  {
    printf 'git_commit=%s\n' "$(git -C "$REPO_ROOT" rev-parse HEAD)"
    printf 'bitcoin_core_version=%s\n' "$BITCOIN_VERSION"
    printf 'bitcoin_core_archive_sha256=%s\n' "$BITCOIN_ARCHIVE_SHA256"
    printf 'lnd_version=%s\n' "$LND_VERSION"
    printf 'lnd_image=%s\n' "$LND_IMAGE"
    printf 'captured_at=%s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    printf 'claim=fully synthetic regtest; no real BTC; no external runtime connectivity\n'
  } >"$destination/manifest.txt"

  {
    echo "This bundle intentionally excludes TLS private keys, macaroons,"
    echo "wallet seeds, invoice preimages, and service logs."
    echo "All balances and transactions are synthetic Bitcoin regtest state."
  } >"$destination/README.txt"

  (
    cd "$destination"
    find . -maxdepth 1 -type f ! -name SHA256SUMS -print0 |
      sort -z |
      xargs -0 sha256sum >SHA256SUMS
  )
  log "evidence captured at $destination"
  printf '%s\n' "$destination"
}

stop_stack() {
  prepare_state
  compose stop
  log "services stopped; synthetic chain and wallet state retained"
}

usage() {
  cat <<'EOF'
Usage: scripts/lightning-navcoin-regtest-env <command> [arguments]

Commands:
  lint                   Validate scripts and fail-closed regtest configuration.
  images [--force]       Build/verify Bitcoin Core and verify the pinned LND release.
  init                   Start services and initialize the synthetic miner wallet.
  start                  Start or resume the isolated four-container stack.
  fund                   Mine synthetic blocks and fund all three LND wallets.
  channels               Establish user <-> router <-> coordinator channels.
  smoke                  Run 1,000-sat two-hop payments in both directions.
  status                 Verify isolation/network identity and print status JSON.
  mine [count]           Mine 1..1000 synthetic regtest blocks.
  bitcoin-cli ARGS...    Run bitcoin-cli against the local regtest node.
  lncli NODE ARGS...     Run lncli for user, coordinator, or router.
  host-lncli NODE ARGS... Run the verified host client over direct bridge gRPC.
  grpc-python ARGS...     Run Python with pinned LND stubs on the internal network.
  grpc-smoke              Test TLS+macaroon gRPC to all three LND nodes.
  credentials            Print local gRPC endpoints and credential file paths.
  evidence [directory]   Capture a redacted, checksummed environment evidence bundle.
  stop                   Stop services without deleting chain or wallet state.

The stack is synthetic and regtest-only. It never contacts Bitcoin or
Lightning public peers; image verification is the sole pre-start network use.
EOF
}

main() {
  require_command docker
  require_command jq
  prepare_state
  local command="${1:-}"
  if [[ $# -gt 0 ]]; then
    shift
  fi
  case "$command" in
    lint) lint_config "$@" ;;
    images) verify_images "$@" ;;
    init) init_stack "$@" ;;
    start) start_stack "$@" ;;
    fund) fund_lnd_wallets "$@" ;;
    channels) setup_channels "$@" ;;
    smoke) smoke_payments "$@" ;;
    status) show_status "$@" ;;
    mine) mine_blocks "$@" ;;
    bitcoin-cli) bitcoin_cli "$@" ;;
    lncli)
      [[ $# -ge 2 ]] || die "lncli requires NODE and an lncli command"
      local node="$1"
      shift
      lnd_cli "$node" "$@"
      ;;
    host-lncli)
      [[ $# -ge 2 ]] || die "host-lncli requires NODE and an lncli command"
      local node="$1"
      shift
      host_lnd_cli "$node" "$@"
      ;;
    grpc-python) run_grpc_python "$@" ;;
    grpc-smoke) grpc_python_smoke "$@" ;;
    credentials) show_credentials "$@" ;;
    evidence) capture_evidence "$@" ;;
    stop) stop_stack "$@" ;;
    help|-h|--help|"") usage ;;
    *) usage >&2; die "unknown command: $command" ;;
  esac
}

main "$@"
