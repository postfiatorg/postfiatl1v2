{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PassOnlyYoloNitroParentToEc2",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::146575258003:role/yolo-nitro-parent-v1",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "ec2.amazonaws.com"
        }
      }
    }
  ]
}
