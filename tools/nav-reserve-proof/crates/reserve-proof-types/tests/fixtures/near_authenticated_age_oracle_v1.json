{
  "schema": "independent-near-authenticated-age-cases-v1",
  "independent_oracle_sha256": "dc7a2b4880c1051e977ef6ca3edc9a4f9bec0a2c3ef88b2d95a8d388712f523b",
  "policy_chosen_before_outputs": {
    "age_semantics": "checked head_ns-receipt_ns and checked head_height-receipt_height; reject underflow or age>positivepolicybound; exactboundvalid.",
    "authoritative_head_ns": "parse_u64(head.header.timestamp_nanosec)",
    "authoritative_receipt_ns": "parse_u64(proof.block_header_lite.inner_lite.timestamp_nanosec)",
    "certified_ms_binding": "checkpoint.source_timestamp_ms == parsed_committed_head_ns // 1000000",
    "numeric_alias_policy": "Ignore numeric receipt/head.timestamp aliases for authoritative time decisions; no new exact-alias equality requirement.",
    "payload_policy": "Preserve event.block_timestamp==decodedpayload.block_timestamp; no new payload/header equality requirement."
  },
  "policy_bounds": {
    "max_receipt_age_blocks": 100,
    "max_receipt_age_ns": 3600000000000
  },
