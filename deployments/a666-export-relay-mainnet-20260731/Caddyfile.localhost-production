{
    servers {
        protocols h1
    }
}

:5173 {
    tls /certs/postfiat-wallet-dev.crt /certs/postfiat-wallet-dev.key

    reverse_proxy /rpc 127.0.0.1:8080 {
        header_up Upgrade {http.request.header.Upgrade}
        header_up Connection {http.request.header.Connection}
    }

    reverse_proxy /api/navswap/* 127.0.0.1:8080
    reverse_proxy /api/navcoin/* 127.0.0.1:8080
    @shieldedNavSwap path /api/shielded-nav-swap /api/shielded-nav-swap/*
    reverse_proxy @shieldedNavSwap 127.0.0.1:8080
    reverse_proxy /api/bridge/* 127.0.0.1:8080
    reverse_proxy /api/a666/* 127.0.0.1:8080
    reverse_proxy /api/a666-roundtrip/* 127.0.0.1:8080

    @retiredFastSwap path /api/fastswap /api/fastswap/* /api/fastswap-demo /api/fastswap-demo/*
    respond @retiredFastSwap 404

    @ethRpc path /eth-rpc /eth-rpc/*
    handle @ethRpc {
        uri strip_prefix /eth-rpc
        reverse_proxy https://ethereum-rpc.publicnode.com {
            header_up Host ethereum-rpc.publicnode.com
        }
    }

    @walletStatic {
        not path /rpc /api/navswap/* /api/navcoin/* /api/shielded-nav-swap /api/shielded-nav-swap/* /api/bridge/* /api/a666/* /api/a666-roundtrip/* /api/fastswap /api/fastswap/* /api/fastswap-demo /api/fastswap-demo/* /eth-rpc /eth-rpc/*
    }
    handle @walletStatic {
        root * /wallet/dist
        try_files {path} /index.html
        file_server
    }
}
