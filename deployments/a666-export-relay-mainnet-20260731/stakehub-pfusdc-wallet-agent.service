[Unit]
Description=StakeHub pfUSDC production wallet agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/postfiat/repos/StakeHub
ExecStart=/home/postfiat/repos/StakeHub/.venv/bin/python -m stakehub.cli agent run
Restart=always
RestartSec=3s
MemoryMax=2G

[Install]
WantedBy=default.target
