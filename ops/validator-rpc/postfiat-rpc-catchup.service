[Unit]
Description=PostFiat Read-Replica Certified-Delta Follower Sync
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=postfiat-rpc
Group=postfiat-rpc
EnvironmentFile=/etc/postfiat/rpc-public.env
ExecStart=/usr/local/bin/postfiat-node rpc-catch-up-certified-delta \
  --data-dir /var/lib/postfiat-rpc/replica \
  --host ${POSTFIAT_UPSTREAM_RPC_HOST} \
  --port ${POSTFIAT_UPSTREAM_RPC_PORT} \
  --max-blocks 64 \
  --timeout-ms 15000
CPUQuota=50%
CPUWeight=20
MemoryHigh=1G
MemoryMax=2G
IOWeight=50
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictSUIDSGID=true
LockPersonality=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/postfiat-rpc/replica
UMask=0077
