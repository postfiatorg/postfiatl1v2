[Unit]
Description=Verify the installed Solana exit worker and archived prover
After=network-online.target

[Service]
User=pf-sol-exit
Group=pf-sol-exit
WorkingDirectory=/opt/postfiat/sol-exit
Environment=HOME=/var/lib/pf-sol-exit
Environment=EXIT_FEE_KEY=/var/lib/pf-sol-exit/fee-payer.json
Environment=EXIT_PROVER_SSH=system
Environment=EXIT_PROOF_HOME=/opt/postfiat/sol-exit/proof
Environment=EXIT_ANCHOR_WITNESS=/opt/postfiat/sol-exit/anchor-witness.json
Type=oneshot
TimeoutStartSec=35min
StandardOutput=truncate:/var/log/pf-sol-exit/self-test.log
ExecStartPre=+/usr/bin/python3 -I /opt/postfiat/sol-exit/ops/sol-live/exit_worker_policy.py
ExecStart=/opt/postfiat/sol-exit/venv/bin/python -Bu ops/sol-live/exit_sandbox_check.py system-self-test
ReadWritePaths=/var/lib/pf-sol-exit/jobs
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
