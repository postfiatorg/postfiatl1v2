[Unit]
Description=Solana USDC withdrawal worker on loopback port 18089
After=network-online.target

[Service]
User=pf-sol-exit
Group=pf-sol-exit
WorkingDirectory=/opt/postfiat/sol-exit
Environment=HOME=/var/lib/pf-sol-exit
Environment=EXIT_FEE_KEY=/var/lib/pf-sol-exit/fee-payer.json
Environment=EXIT_PROVER_SSH=system
Environment=EXIT_PROOF_HOME=/opt/postfiat/sol-exit/proof
Environment=EXIT_ANCHOR_WITNESS=/opt/postfiat/sol-exit/anchor-witness.json
ExecStart=/opt/postfiat/sol-exit/venv/bin/python -u ops/sol-live/exit_service.py --state /var/lib/pf-sol-exit/jobs --port 18089
ReadWritePaths=/var/lib/pf-sol-exit/jobs
LimitCORE=0
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
RestrictSUIDSGID=yes
CapabilityBoundingSet=
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
