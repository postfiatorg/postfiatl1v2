diff --git a/runtime/src/bank/public_capture.rs b/runtime/src/bank/public_capture.rs
new file mode 100644
index 0000000..e0e4b63
--- /dev/null
+++ b/runtime/src/bank/public_capture.rs
@@ -0,0 +1,176 @@
+// Included inside solana_runtime::bank on the two audited release tags.
+mod public_capture {
+    use super::*;
+    use std::{
+        fs,
+        io::{self, BufWriter, Write},
+        path::Path,
+    };
+
+    fn write_preimage(out: &mut impl Write, bank: &Bank) -> io::Result<()> {
+        out.write_all(bank.parent_hash().as_ref())?;
+        out.write_all(&bank.signature_count().to_le_bytes())?;
+        out.write_all(bank.last_blockhash().as_ref())?;
+        let lattice = bank.accounts_lt_hash.lock().unwrap();
+        for lane in &lattice.0 .0 {
+            out.write_all(&lane.to_le_bytes())?;
+        }
+        Ok(())
+    }
+
+    fn write_account(out: &mut impl Write, account: &AccountSharedData) -> io::Result<()> {
+        out.write_all(&account.lamports().to_le_bytes())?;
+        out.write_all(&[u8::from(account.executable())])?;
+        out.write_all(account.owner().as_ref())?;
+        out.write_all(&(account.data().len() as u32).to_le_bytes())?;
+        out.write_all(account.data())
+    }
+
+    fn observed_ns() -> u128 {
+        std::time::SystemTime::now()
+            .duration_since(std::time::UNIX_EPOCH)
+            .unwrap_or_default()
+            .as_nanos()
+    }
+
+    fn in_window(dir: &Path, slot: u64) -> io::Result<bool> {
+        let window = match fs::read_to_string(dir.join("slots")) {
+            Ok(s) => s,
+            Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(false),
+            Err(e) => return Err(e),
+        };
+        let (first, last) = window.trim().split_once(' ')
+            .ok_or_else(|| io::Error::other("invalid capture window"))?;
+        let first: u64 = first.parse().map_err(io::Error::other)?;
+        let last: u64 = last.parse().map_err(io::Error::other)?;
+        Ok((first..=last).contains(&slot))
+    }
+
+    impl Bank {
+        /// Run only on the non-voting observer, after footer hash verification.
+        pub fn capture_public_bank<I>(
+            &self,
+            shreds: impl FnOnce() -> io::Result<I>,
+        ) -> io::Result<()>
+        where
+            I: Iterator<Item = ((u64, u64), Box<[u8]>)>,
+        {
+            let Some(dir) = std::env::var_os("SOLBRIDGE_CAPTURE_DIR") else {
+                return Ok(());
+            };
+            let dir = Path::new(&dir);
+            let carrier_only = if in_window(dir, self.slot())? {
+                false
+            } else {
+                let address = match fs::read_to_string(dir.join("watch-account")) {
+                    Ok(s) => s.trim().parse::<Pubkey>().map_err(io::Error::other)?,
+                    Err(e) if e.kind() == io::ErrorKind::NotFound => return Ok(()),
+                    Err(e) => return Err(e),
+                };
+                // The write slot is resolved on this bank's fork, before the parent is dropped.
+                let Some((_, written)) = self.get_account_modified_slot(&address) else {
+                    return Ok(());
+                };
+                match self.slot().checked_sub(written) {
+                    Some(0) => false,
+                    Some(1..=64) => true,
+                    _ => return Ok(()),
+                }
+            };
+            // A carrier-only capture can coexist with a full capture of the same bank.
+            let carriers = dir.join("carriers");
+            let dir = if carrier_only {
+                fs::create_dir_all(&carriers)?;
+                carriers.as_path()
+            } else {
+                dir
+            };
+            let frozen_ns = observed_ns();
+            let parent = self
+                .parent()
+                .ok_or_else(|| io::Error::other("parent unavailable"))?;
+            let parent_id = parent
+                .block_id()
+                .ok_or_else(|| io::Error::other("missing parent ID"))?;
+            let id = self
+                .block_id()
+                .ok_or_else(|| io::Error::other("missing block ID"))?;
+            let name = format!("{}-{id}", self.slot());
+            let target = dir.join(&name);
+            if target.is_dir() {
+                return Ok(());
+            }
+            let temp = dir.join(format!(".{name}-{:?}", self.bank_id()));
+            fs::create_dir(&temp)?;
+            let mut data = BufWriter::new(fs::File::create(temp.join("shreds.bin"))?);
+            let mut count = 0;
+            for ((slot, index), shred) in shreds()? {
+                if slot != self.slot() || index != count || shred.len() != 1203 {
+                    return Err(io::Error::other("invalid shred sequence"));
+                }
+                data.write_all(&shred)?;
+                count += 1;
+            }
+            data.flush()?;
+            let shreds_ns = observed_ns();
+            let mut prefix = fs::File::create(temp.join("block-prefix.bin"))?;
+            prefix.write_all(&self.slot().to_le_bytes())?;
+            prefix.write_all(&parent.slot().to_le_bytes())?;
+            prefix.write_all(parent_id.as_bytes())?;
+            prefix.write_all(&(count as u32).to_le_bytes())?;
+
+            if carrier_only {
+                fs::write(temp.join("observations.tsv"), format!(
+                    "frozen\t{frozen_ns}\nshreds_read\t{shreds_ns}\n"
+                ))?;
+                return fs::rename(temp, target);
+            }
+
+            let mut state = BufWriter::new(fs::File::create(temp.join("state-body.bin"))?);
+            write_preimage(&mut state, self)?;
+            write_preimage(&mut state, &parent)?;
+            let preimages_ns = observed_ns();
+            let mut changes = self.get_all_accounts_modified_since_parent();
+            changes.sort_unstable_by_key(|(address, _)| *address);
+            state.write_all(&(changes.len() as u32).to_le_bytes())?;
+            for (address, new) in &changes {
+                let old = parent.get_account(address).unwrap_or_default();
+                state.write_all(address.as_ref())?;
+                write_account(&mut state, &old)?;
+                write_account(&mut state, new)?;
+            }
+            state.flush()?;
+            let accounts_ns = observed_ns();
+            fs::write(temp.join("bank-hash.bin"), self.hash().as_bytes())?;
+            let epoch = self
+                .epoch_stakes_from_slot(self.slot())
+                .ok_or_else(|| io::Error::other("missing epoch"))?;
+            let ranks = epoch.bls_pubkey_to_rank_map();
+            let mut set = BufWriter::new(fs::File::create(temp.join("set.bin"))?);
+            set.write_all(&u128::from(epoch.total_stake()).to_le_bytes())?;
+            set.write_all(&(ranks.len() as u32).to_le_bytes())?;
+            for rank in 0..ranks.len() {
+                let entry = ranks
+                    .get_pubkey_stake_entry(rank)
+                    .ok_or_else(|| io::Error::other("missing rank"))?;
+                let votes = epoch.stakes().vote_accounts();
+                let account = votes
+                    .get(&entry.vote_account_pubkey)
+                    .ok_or_else(|| io::Error::other("missing vote account"))?;
+                let key = account
+                    .vote_state_view()
+                    .bls_pubkey_compressed()
+                    .ok_or_else(|| io::Error::other("missing BLS key"))?;
+                set.write_all(&key)?;
+                let stake: u64 = entry.stake.get().into();
+                set.write_all(&stake.to_le_bytes())?;
+            }
+            set.flush()?;
+            let set_ns = observed_ns();
+            fs::write(temp.join("observations.tsv"), format!(
+                "frozen\t{frozen_ns}\nshreds_read\t{shreds_ns}\npreimages_read\t{preimages_ns}\naccounts_read\t{accounts_ns}\nset_read\t{set_ns}\n"
+            ))?;
+            fs::rename(temp, target)
+        }
+    }
+}
