[Unit]
Description=Report before the Vast proving hosts run out of credit
After=network-online.target
Wants=network-online.target
# A failed run (a crash, a timeout, a report not delivered) shows in `systemctl --user --failed`;
# this unit also reports a run that ended without its own report.
OnFailure=prover-credit-alert-failed.service

[Service]
Type=oneshot
# Same hook as the B24 reading: B24_READING_NOTIFY=<webhook URL or command>; absent file sends nothing.
EnvironmentFile=-%h/.config/b24-tee-nav/notify.env
# Optional: PROVER_CREDIT_WARN_HOURS=24 and PROVER_CREDIT_URGENT_HOURS=6.
EnvironmentFile=-%h/.config/prover-credit-alert/thresholds.env
# The Vast CLI reads its own key file (~/.config/vastai/vast_api_key); nothing secret here.
ExecStart=/usr/bin/python3 -I %h/repos/postfiatl1v2-live/ops/b24-live/prover_credit.py
UMask=0077
# Two Vast calls (60 s each) and the hook (60 s) take at most 3 min.
TimeoutStartSec=10min
