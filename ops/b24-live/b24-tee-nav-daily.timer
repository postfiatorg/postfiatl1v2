[Unit]
Description=Prepare B24 at 17:55 UTC for the 18:15 observation, starting 2026-11-14

[Timer]
OnCalendar=*-*-* 17:55:00 UTC
AccuracySec=1s
RandomizedDelaySec=0
Persistent=false
Unit=b24-tee-nav-daily.service
# Daily script enforces registered schedule, $9/run, $250/month, $100 cumulative lane.

[Install]
WantedBy=timers.target
