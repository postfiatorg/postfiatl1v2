[Unit]
Description=Tell a person that the B24 daily reading service failed

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/b24-tee-nav/notify.env
# Standard library only and isolated (-I), so it works when the job's venv does not.
# Skips runs whose failure the job already recorded and reported.
ExecStart=/usr/bin/python3 -I /home/postfiat/repos/postfiatl1v2-now/ops/b24-live/reading_alert.py --service-failed b24-tee-nav-daily.service
TimeoutStartSec=5min
