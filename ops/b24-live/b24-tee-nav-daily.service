[Unit]
Description=B24 measured Schwab NAV at 18:15 UTC; AWS $9/run $250/month and $250 cumulative lane cap
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=/home/postfiat/repos/postfiatl1v2-now
ExecStart=/home/postfiat/repos/navstrategies-b23-tee-nav/.venv/bin/python /home/postfiat/repos/postfiatl1v2-now/ops/b24-live/daily.py --execute
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
TimeoutStartSec=3h
TimeoutStopSec=180
KillMode=control-group
# Independent collector teardown after two hours; no automatic retry/backfill.
